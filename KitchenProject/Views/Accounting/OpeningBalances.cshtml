@model OpeningBalancesVm
@{
    ViewData["Title"] = "الأرصدة الافتتاحية";
    Layout = "_DashboardLayout";
    DateTime? closed = ViewBag.ClosedThrough;
    bool hasExisting = ViewBag.HasExisting ?? false;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1"><i class="fa-solid fa-flag-checkered text-primary me-2"></i> الأرصدة الافتتاحية</h2>
        <p class="text-muted mb-0">
            أدخل أرصدة بداية النشاط (الصندوق، البنك، المخزون، الأصول، الموردين، رأس المال...) في قيد افتتاحي واحد متزن.
            @if (hasExisting) { <span class="badge bg-info-subtle text-info-emphasis ms-1">يوجد قيد افتتاحي مسجل وسيتم تحديثه عند الحفظ</span> }
        </p>
    </div>
    <a asp-action="Index" class="btn btn-light border">القيود اليومية</a>
</div>

<form method="post" asp-action="OpeningBalances">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-3"></div>

    <div class="custom-card p-4 mb-3">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">تاريخ الافتتاح</label>
                <input type="date" name="EntryDate" value="@Model.EntryDate.ToString("yyyy-MM-dd")" class="form-control" required />
                @if (closed.HasValue) { <small class="text-warning-emphasis">يجب أن يكون بعد @closed.Value.ToString("yyyy/MM/dd")</small> }
            </div>
            <div class="col-md-9">
                <label class="form-label fw-bold">البيان</label>
                <input type="text" name="Description" value="@Model.Description" class="form-control" maxlength="500" />
            </div>
        </div>
    </div>

    <div class="custom-card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="ob-table">
                <thead class="bg-light text-muted" style="font-size:0.85rem;">
                    <tr>
                        <th class="ps-4" style="width:12%">رقم الحساب</th>
                        <th>اسم الحساب</th>
                        <th style="width:14%">التصنيف</th>
                        <th style="width:18%">رصيد مدين (أصول)</th>
                        <th style="width:18%">رصيد دائن (خصوم/ملكية)</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Lines.Count; i++)
                    {
                        var l = Model.Lines[i];
                        <tr>
                            <td class="ps-4 font-monospace small">
                                @l.Code
                                <input type="hidden" name="Lines[@i].AccountId" value="@l.AccountId" />
                                <input type="hidden" name="Lines[@i].Code" value="@l.Code" />
                                <input type="hidden" name="Lines[@i].Name" value="@l.Name" />
                                <input type="hidden" name="Lines[@i].TypeName" value="@l.TypeName" />
                                <input type="hidden" name="Lines[@i].IsDebitNature" value="@(l.IsDebitNature ? "true" : "false")" />
                            </td>
                            <td class="fw-semibold">@l.Name</td>
                            <td><span class="badge bg-light text-dark border">@l.TypeName</span></td>
                            <td><input type="number" step="0.01" min="0" name="Lines[@i].Debit" value="@(l.Debit == 0 ? "" : l.Debit.ToString("0.##", inv))" class="form-control form-control-sm ob-debit" /></td>
                            <td><input type="number" step="0.01" min="0" name="Lines[@i].Credit" value="@(l.Credit == 0 ? "" : l.Credit.ToString("0.##", inv))" class="form-control form-control-sm ob-credit" /></td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-light fw-bold">
                    <tr>
                        <td colspan="3" class="ps-4">الإجمالي <span id="ob-diff" class="ms-3 small"></span></td>
                        <td id="ob-total-debit">0.00</td>
                        <td id="ob-total-credit">0.00</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary-custom px-5 fw-bold"><i class="fa-solid fa-floppy-disk me-1"></i> حفظ الأرصدة الافتتاحية</button>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const table = document.getElementById('ob-table');
            function recalc() {
                let d = 0, c = 0;
                table.querySelectorAll('.ob-debit').forEach(el => d += parseFloat(el.value) || 0);
                table.querySelectorAll('.ob-credit').forEach(el => c += parseFloat(el.value) || 0);
                document.getElementById('ob-total-debit').textContent = d.toFixed(2);
                document.getElementById('ob-total-credit').textContent = c.toFixed(2);
                const diff = Math.round((d - c) * 100) / 100;
                const el = document.getElementById('ob-diff');
                el.textContent = diff === 0 ? (d > 0 ? 'متزن ✓' : '') : 'الفرق: ' + Math.abs(diff).toFixed(2) + (diff > 0 ? ' (يلزم دائن)' : ' (يلزم مدين)');
                el.className = 'ms-3 small ' + (diff === 0 ? 'text-success' : 'text-danger');
            }
            table.addEventListener('input', e => {
                if (e.target.matches('.ob-debit,.ob-credit') && e.target.value) {
                    const other = e.target.closest('tr').querySelector(e.target.classList.contains('ob-debit') ? '.ob-credit' : '.ob-debit');
                    other.value = '';
                }
                recalc();
            });
            recalc();
        })();
    </script>
}
