@model KitchenProject.Models.Entities.Quote
@using KitchenProject.Models.Enums
@{
    var typeName = Model.Type == ContractType.Final ? "الفاتورة النهائية" : "الفاتورة المبدئية";
    ViewData["Title"] = $"تعديل {typeName}";
    Layout = "_DashboardLayout";
    ViewData["FormAction"] = "Edit";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1">
            <i class="fa-solid fa-pen-to-square text-primary me-2"></i> تعديل @typeName: @Model.QuoteNo
        </h2>
        <p class="text-muted mb-0">تعديل الأصناف والأسعار وحالة الفاتورة</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="fa-solid fa-arrow-right"></i><span>رجوع</span>
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="custom-card p-4">
            <partial name="_QuoteForm" model="Model" />
        </div>
    </div>
</div>
