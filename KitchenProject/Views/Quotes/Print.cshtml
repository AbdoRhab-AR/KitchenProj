@model KitchenProject.Models.Entities.Quote
@using KitchenProject.Models.Enums
@{
    Layout = null;
    var isFinal = Model.Type == ContractType.Final;
    var title = isFinal ? "فاتورة نهائية" : "فاتورة مبدئية";
    var received = (decimal)(ViewBag.ReceivedAmount ?? 0m);
    var items = Model.Items.OrderBy(i => i.SortOrder).ToList();
    var customer = Model.Project?.Customer;
    var partyParts = new[] { customer?.Name, customer?.Phone, customer?.City, customer?.Address ?? Model.Project?.Address }
        .Where(p => !string.IsNullOrWhiteSpace(p));
    var terms = (Model.Terms ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    // صفوف فارغة لإكمال الجدول كما في النموذج الورقي
    var emptyRows = Math.Max(0, 4 - items.Count);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - @Model.QuoteNo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --purple: #3d1466;
            --cyan: #00aeef;
            --red: #c8102e;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: #e9ecef;
            font-family: 'Cairo', Tahoma, Arial, sans-serif;
            color: #000;
        }
        .toolbar {
            text-align: center;
            padding: 12px;
        }
        .toolbar button, .toolbar a {
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            padding: 8px 22px;
            margin: 0 4px;
            border-radius: 6px;
            border: 1px solid #333;
            background: #fff;
            color: #000;
            cursor: pointer;
            text-decoration: none;
        }
        .toolbar button { background: var(--purple); color: #fff; border-color: var(--purple); }
        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto 24px;
            background: #fff;
            padding: 14mm 12mm;
        }
        .head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }
        .brand { text-align: center; }
        .logo {
            width: 200px;
            height: 104px;
            border-radius: 50%;
            background: radial-gradient(ellipse at 40% 35%, #e0303f, var(--red) 60%, #8f0a1f);
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            line-height: 1;
            margin: 0 auto 10px;
            box-shadow: inset 0 0 0 4px rgba(255,255,255,.15);
        }
        .logo .l1 { font-size: 26px; font-weight: 800; }
        .logo .l2 { font-size: 34px; font-weight: 800; }
        .logo .yr { font-size: 11px; margin-top: 4px; letter-spacing: 1px; }
        .brand .en { font-family: Arial, sans-serif; font-weight: 700; font-size: 20px; }
        .brand .ar { font-weight: 700; font-size: 20px; }
        .title-block { width: 48%; }
        .title-block h1 {
            font-size: 46px;
            font-weight: 800;
            margin: 10px 0 8px;
            text-align: center;
        }
        .title-block .rule { border-top: 3px solid var(--purple); margin-bottom: 12px; }
        .meta { font-size: 14px; line-height: 2; padding-right: 50px; }
        .meta b { font-weight: 700; }
        .party {
            border-top: 3px solid var(--purple);
            border-bottom: 3px solid var(--purple);
            padding: 10px 6px;
            margin: 6px 0 22px;
            font-size: 19px;
            font-weight: 600;
        }
        table { width: 100%; border-collapse: collapse; }
        .items th {
            background: var(--cyan);
            font-weight: 700;
            font-size: 15px;
            padding: 4px 6px;
            border: 2px solid #000;
        }
        .items td {
            border: 1px solid #000;
            padding: 3px 6px;
            font-size: 15px;
            font-weight: 600;
            text-align: center;
            height: 28px;
        }
        .items td.desc { text-align: center; }
        .items tbody { border: 2px solid #000; }
        .bottom {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-top: 26px;
            gap: 24px;
        }
        .notes {
            flex: 1;
            border: 2px solid #000;
            background: var(--cyan);
            padding: 4px 10px;
            font-weight: 700;
            font-size: 15px;
            white-space: pre-wrap;
        }
        .totals { width: 42%; border: 2px solid #000; }
        .totals td { border: 1px solid #000; padding: 4px 8px; font-weight: 700; font-size: 15px; }
        .totals td.lbl { background: var(--cyan); text-align: center; width: 62%; }
        .totals td.val { text-align: center; }
        .terms { margin-top: 22px; font-size: 14px; font-weight: 600; }
        .terms ol { margin: 4px 0 0; padding-right: 22px; }
        .thanks {
            margin-top: 40px;
            background: var(--cyan);
            border-top: 2px solid #000;
            border-bottom: 2px solid #000;
            text-align: center;
            font-weight: 700;
            padding: 4px;
        }
        @@media print {
            body { background: #fff; }
            .toolbar { display: none; }
            .page { margin: 0; width: auto; min-height: auto; padding: 8mm; }
            @@page { size: A4; margin: 6mm; }
            * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" onclick="window.print()">طباعة</button>
        <a href="@Url.Action("Details", new { id = Model.Id })">رجوع للفاتورة</a>
    </div>

    <div class="page">
        <div class="head">
            <div class="brand">
                <div class="logo">
                    <span class="l1">بن</span>
                    <span class="l2">قسومة</span>
                    <span class="yr">2023</span>
                </div>
                <div class="en">Factory Bin Gsoma</div>
                <div class="ar">مصنع بن اقسومة</div>
            </div>
            <div class="title-block">
                <h1>@title</h1>
                <div class="rule"></div>
                <div class="meta">
                    <div><b>التاريخ:</b> @Model.Created.ToLocalTime().ToString("dd/MM/yyyy")</div>
                    <div><b>رقم الفاتورة:</b> @Model.QuoteNo</div>
                    <div><b>معرّف :</b> @(Model.Project?.ProjectNo)</div>
                </div>
            </div>
        </div>

        <div class="party">الجهة / @string.Join(" / ", partyParts)</div>

        <table class="items">
            <thead>
                <tr>
                    <th style="width:6%">ر.ق</th>
                    <th style="width:36%">البيان</th>
                    <th style="width:14%">الوحدة / م</th>
                    <th style="width:14%">الكمية</th>
                    <th style="width:14%">ثمن الوحدة</th>
                    <th style="width:16%">الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < items.Count; i++)
                {
                    var item = items[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td class="desc">@item.Description</td>
                        <td>@(item.Meters?.ToString("0.0#") ?? "-")</td>
                        <td>@(item.Quantity?.ToString("0.##") ?? "-")</td>
                        <td>@item.UnitPrice.ToString("N2")</td>
                        <td>@item.LineTotal.ToString("N2")</td>
                    </tr>
                }
                @for (int i = 0; i < emptyRows; i++)
                {
                    <tr>
                        <td>@(items.Count + i + 1)</td>
                        <td>-</td><td>-</td><td>-</td><td>-</td><td>-</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="bottom">
            <div class="notes">ملاحظات / @(Model.Notes ?? "")</div>
            <table class="totals">
                @if (Model.Discount > 0)
                {
                    <tr><td class="lbl">الخصم</td><td class="val">@Model.Discount.ToString("N2")</td></tr>
                }
                @if (Model.Tax > 0)
                {
                    <tr><td class="lbl">الضريبة</td><td class="val">@Model.Tax.ToString("N2")</td></tr>
                }
                <tr><td class="lbl">الإجمالي القيمة المستحقة</td><td class="val">@Model.Total.ToString("N2")</td></tr>
                <tr><td class="lbl">القيمة المستلمة</td><td class="val">@received.ToString("N2")</td></tr>
                <tr><td class="lbl">صافي القيمة المستحقة</td><td class="val">@((Model.Total - received).ToString("N2"))</td></tr>
            </table>
        </div>

        @if (terms.Length > 0)
        {
            <div class="terms">
                ملاحظة :
                <ol>
                    @foreach (var t in terms)
                    {
                        <li>@t</li>
                    }
                </ol>
            </div>
        }

        <div class="thanks">شكراً لتعاملك معنا!</div>
    </div>
</body>
</html>
