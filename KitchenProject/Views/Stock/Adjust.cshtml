@model StockAdjustViewModel
@{
    ViewData["Title"] = "تسوية جرد";
    Layout = "_DashboardLayout";
    var options = (List<ItemOption>)ViewBag.ItemOptions;
    var balances = (Dictionary<Guid, decimal>)ViewBag.Balances;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">المخزن</a></li>
                <li class="breadcrumb-item active" aria-current="page">تسوية جرد</li>
            </ol>
        </nav>
        <h2 class="page-header-title mb-0">
            <i class="fa-solid fa-scale-balanced text-primary me-2"></i> تسوية جرد
        </h2>
        <p class="text-muted mb-0 mt-1">أدخل الكمية الفعلية بعد العد، ويسجل النظام الفرق (زيادة أو عجز) كحركة تسوية.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3"><i class="fa-solid fa-arrow-right me-1"></i> المخزن</a>
    </div>
</div>

<div class="custom-card p-4 p-md-5" style="max-width:820px;">
    <form asp-action="Adjust" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

        <div class="row g-4">
            <div class="col-12 col-md-8">
                <label asp-for="ItemId" class="form-label fw-bold">الخامة <span class="text-danger">*</span></label>
                <select asp-for="ItemId" class="form-select" id="itemId">
                    <option value="">-- اختر الخامة --</option>
                    @foreach (var o in options)
                    {
                        <option value="@o.Id" data-unit="@o.Unit" data-balance="@balances.GetValueOrDefault(o.Id).ToString("0.##", inv)" selected="@(o.Id == Model.ItemId)">@o.Code - @o.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="WarehouseId" class="form-label fw-bold">المخزن</label>
                <select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select"></select>
            </div>
            <div class="col-6 col-md-4">
                <label class="form-label fw-bold">الرصيد في النظام</label>
                <div class="form-control bg-light fw-bold" id="systemBalance">-</div>
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="CountedQuantity" class="form-label fw-bold">الكمية الفعلية <span class="text-danger">*</span></label>
                <input asp-for="CountedQuantity" type="number" step="0.01" min="0" class="form-control fw-bold" id="counted" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label fw-bold">الفرق</label>
                <div class="form-control bg-light fw-bold" id="diff">-</div>
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="Date" class="form-label fw-bold">تاريخ الجرد</label>
                <input asp-for="Date" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
            </div>
            <div class="col-12 col-md-8">
                <label asp-for="Notes" class="form-label fw-bold">سبب الفرق</label>
                <input asp-for="Notes" class="form-control" placeholder="تالف، خطأ عد، هالك تشغيل..." />
            </div>
        </div>

        <hr class="my-4 text-muted opacity-25">
        <div class="d-flex align-items-center justify-content-end gap-3">
            <a asp-action="Index" class="btn btn-light border fw-bold px-4 rounded-3">إلغاء</a>
            <button type="submit" class="btn btn-primary-custom px-5 py-2 fw-bold">
                <i class="fa-solid fa-floppy-disk me-1"></i> تسجيل التسوية
            </button>
        </div>
    </form>
</div>

<script>
    (function () {
        const item = document.getElementById('itemId');
        const counted = document.getElementById('counted');
        function refresh() {
            const opt = item.selectedOptions[0];
            if (!opt || !opt.value) {
                document.getElementById('systemBalance').textContent = '-';
                document.getElementById('diff').textContent = '-';
                return;
            }
            const balance = parseFloat(opt.dataset.balance) || 0;
            const diff = (parseFloat(counted.value) || 0) - balance;
            document.getElementById('systemBalance').textContent = `${balance} ${opt.dataset.unit}`;
            const el = document.getElementById('diff');
            el.textContent = diff === 0 ? 'مطابق' : (diff > 0 ? `زيادة ${diff.toFixed(2)}` : `عجز ${(-diff).toFixed(2)}`);
            el.className = 'form-control bg-light fw-bold ' + (diff === 0 ? 'text-success' : diff > 0 ? 'text-primary' : 'text-danger');
        }
        item.addEventListener('change', () => {
            const opt = item.selectedOptions[0];
            if (opt?.dataset.balance) counted.value = opt.dataset.balance;
            refresh();
        });
        counted.addEventListener('input', refresh);
        refresh();
    })();
</script>
