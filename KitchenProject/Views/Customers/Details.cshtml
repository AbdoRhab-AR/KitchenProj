@model KitchenProject.Models.Entities.Customer
@{
    ViewData["Title"] = "تفاصيل العميل - " + Model.Name;
    Layout = "_DashboardLayout";
}

<!-- Page Header Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">إدارة العملاء</a></li>
                <li class="breadcrumb-item active" aria-current="page">تفاصيل العميل</li>
            </ol>
        </nav>
        <h2 class="page-header-title mb-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-user-tag text-primary"></i>
            <span>@Model.Name</span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-7 px-3 py-1 rounded-pill">
                @Model.CustomerNo
            </span>
        </h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-pen-to-square"></i>
            <span>تعديل البيانات</span>
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3">
            <i class="fa-solid fa-arrow-right me-1"></i> العودة للقائمة
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Customer Profile Info Card -->
    <div class="col-12 col-lg-5 col-xl-4">
        <div class="custom-card p-4 h-100">
            <div class="text-center pb-3 border-bottom mb-3">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px; font-size: 2.2rem;">
                    @Model.Name.Substring(0, 1)
                </div>
                <h4 class="fw-bold mb-1">@Model.Name</h4>
                <p class="text-muted small mb-0"><i class="fa-solid fa-calendar-day me-1"></i> مسجل منذ: @Model.Created.ToString("yyyy/MM/dd")</p>
            </div>

            <div class="d-flex flex-column gap-3 fs-6">
                <div>
                    <span class="text-muted d-block small fw-bold">رقم الهاتف الرئيسي</span>
                    <span class="fw-bold text-dark"><i class="fa-solid fa-phone me-2 text-primary"></i>@Model.Phone</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.Phone2))
                {
                    <div>
                        <span class="text-muted d-block small fw-bold">رقم الهاتف الإضافي</span>
                        <span class="fw-semibold text-dark"><i class="fa-solid fa-mobile-screen-button me-2 text-success"></i>@Model.Phone2</span>
                    </div>
                }

                <div>
                    <span class="text-muted d-block small fw-bold">البريد الإلكتروني</span>
                    <span class="fw-semibold text-dark">
                        <i class="fa-solid fa-envelope me-2 text-warning"></i>
                        @(string.IsNullOrEmpty(Model.Email) ? "غير مسجل" : Model.Email)
                    </span>
                </div>

                <div>
                    <span class="text-muted d-block small fw-bold">المدينة / المنطقة</span>
                    <span class="fw-semibold text-dark">
                        <i class="fa-solid fa-city me-2 text-info"></i>
                        @(string.IsNullOrEmpty(Model.City) ? "غير محددة" : Model.City)
                    </span>
                </div>

                <div>
                    <span class="text-muted d-block small fw-bold">العنوان التفصيلي</span>
                    <span class="fw-semibold text-dark">
                        <i class="fa-solid fa-location-dot me-2 text-danger"></i>
                        @(string.IsNullOrEmpty(Model.Address) ? "غير مسجل" : Model.Address)
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="pt-2 border-top">
                        <span class="text-muted d-block small fw-bold mb-1">ملاحظات واهتمامات العميل</span>
                        <p class="bg-light p-3 rounded-3 text-secondary small mb-0">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Side: Projects & Next Workflow Steps -->
    <div class="col-12 col-lg-7 col-xl-8">
        <!-- Next Workflow Actions Card -->
        <div class="custom-card p-4 mb-4">
            <h5 class="fw-bold mb-3 text-dark">
                <i class="fa-solid fa-bolt text-warning me-2"></i> إجراءات دورة العمل السريعة
            </h5>
            <div class="row g-3">
                <div class="col-12 col-sm-6">
                    <a asp-controller="Projects" asp-action="Create" asp-route-customerId="@Model.Id" class="btn btn-light border p-3 w-100 text-start d-flex align-items-center gap-3 rounded-3 shadow-sm hover-lift">
                        <div class="bg-primary-subtle text-primary rounded-circle p-3">
                            <i class="fa-solid fa-diagram-project fs-4"></i>
                        </div>
                        <div>
                            <span class="fw-bold d-block text-dark">إنشاء مشروع جديد</span>
                            <small class="text-muted">بدء ملف مطبخ جديد للعميل</small>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-sm-6">
                    @{ var latestProject = Model.Projects?.OrderByDescending(p => p.Created).FirstOrDefault(); }
                    <a href="@(latestProject != null ? Url.Action("Create", "SiteVisits", new { projectId = latestProject.Id }) : Url.Action("Create", "Projects", new { customerId = Model.Id }))" class="btn btn-light border p-3 w-100 text-start d-flex align-items-center gap-3 rounded-3 shadow-sm hover-lift">
                        <div class="bg-success-subtle text-success rounded-circle p-3">
                            <i class="fa-solid fa-ruler-combined fs-4"></i>
                        </div>
                        <div>
                            <span class="fw-bold d-block text-dark">جدولة زيارة ميدانية</span>
                            <small class="text-muted">تحديد موعد مهندس المعاينة</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <!-- Customer Projects List -->
        <div class="custom-card">
            <div class="card-header-custom">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-kitchen-set text-primary me-2"></i> مشاريع وتفصيلات العميل
                </h5>
                <span class="badge bg-primary rounded-pill px-3">@(Model.Projects?.Count ?? 0) مشاريع</span>
            </div>
            <div class="p-4">
                @if (Model.Projects != null && Model.Projects.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var proj in Model.Projects)
                        {
                            <div class="list-group-item px-0 py-3 border-bottom d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">@proj.ProjectName</h6>
                                    <span class="badge bg-secondary me-2">كود: @proj.ProjectNo</span>
                                    <span class="text-muted small">نوع المطبخ: @(string.IsNullOrEmpty(proj.KitchenType) ? "غير محدد" : proj.KitchenType)</span>
                                </div>
                                <div>
                                    <span class="me-2"><partial name="~/Views/Projects/_StatusBadge.cshtml" model="proj.Status" /></span>
                                    <a asp-controller="Projects" asp-action="Details" asp-route-id="@proj.Id" class="btn btn-sm btn-light border text-primary fw-bold">عرض</a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa-solid fa-folder-open display-4 mb-3 text-secondary opacity-50"></i>
                        <h6 class="fw-bold mb-1">لا توجد مشاريع مضافة لهذا العميل حتى الآن</h6>
                        <p class="text-muted small mb-3">يمكنك إنشاء مشروع جديد وتعيين مهندس المعاينة والتصميم فوراً</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
