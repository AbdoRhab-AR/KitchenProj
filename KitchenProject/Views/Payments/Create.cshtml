@model KitchenProject.Models.Entities.CustomerPayment
@{
    ViewData["Title"] = "إيصال قبض جديد";
    Layout = "_DashboardLayout";
    var contracts = (List<ContractOption>)ViewBag.Contracts;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    decimal? suggested = ViewBag.SuggestedAmount;
    var amountValue = Model.Amount > 0 ? Model.Amount : suggested ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">تحصيلات العملاء</a></li>
                <li class="breadcrumb-item active" aria-current="page">إيصال جديد</li>
            </ol>
        </nav>
        <h2 class="page-header-title mb-0">
            <i class="fa-solid fa-hand-holding-dollar text-primary me-2"></i> تسجيل دفعة من عميل
        </h2>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3"><i class="fa-solid fa-arrow-right me-1"></i> العودة للقائمة</a>
    </div>
</div>

<div class="custom-card p-4 p-md-5" style="max-width:900px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

        <div class="row g-4">
            <div class="col-12 col-md-4">
                <label asp-for="ReceiptNo" class="form-label fw-bold">رقم الإيصال</label>
                <input asp-for="ReceiptNo" class="form-control bg-light fw-bold text-primary" readonly />
            </div>
            <div class="col-12 col-md-8">
                <label asp-for="ProjectId" class="form-label fw-bold">المشروع <span class="text-danger">*</span></label>
                <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select" id="projectId">
                    <option value="">-- اختر المشروع --</option>
                </select>
            </div>
            <div class="col-12 col-md-8">
                <label asp-for="ContractId" class="form-label fw-bold">العقد</label>
                <select asp-for="ContractId" class="form-select" id="contractId">
                    <option value="">-- بدون عقد (عربون / دفعة مقدمة) --</option>
                    @foreach (var c in contracts)
                    {
                        <option value="@c.Id" data-project="@c.ProjectId" data-remaining="@c.Remaining.ToString("0.##", inv)" selected="@(c.Id == Model.ContractId)">
                            @c.ContractNo — القيمة @c.Total.ToString("N2") / المتبقي @c.Remaining.ToString("N2")
                        </option>
                    }
                </select>
                <span asp-validation-for="ContractId" class="text-danger small"></span>
                <small class="text-muted d-block mt-1" id="remainingHint"></small>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="PaymentDate" class="form-label fw-bold">التاريخ</label>
                <input asp-for="PaymentDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="Amount" class="form-label fw-bold">المبلغ (د.ل) <span class="text-danger">*</span></label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" value="@amountValue.ToString("0.##", inv)" class="form-control fw-bold fs-5" id="amount" />
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="Payment" class="form-label fw-bold">طريقة الدفع</label>
                <select asp-for="Payment" asp-items="ViewBag.MethodList" class="form-select"></select>
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="ReferenceNo" class="form-label fw-bold">رقم الصك / الحوالة</label>
                <input asp-for="ReferenceNo" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label fw-bold">البيان</label>
                <input asp-for="Notes" class="form-control" placeholder="مثال: الدفعة الأولى 50% من قيمة العقد" />
            </div>
        </div>

        <hr class="my-4 text-muted opacity-25">
        <div class="d-flex align-items-center justify-content-end gap-3">
            <a asp-action="Index" class="btn btn-light border fw-bold px-4 rounded-3">إلغاء</a>
            <button type="submit" class="btn btn-primary-custom px-5 py-2 fw-bold">
                <i class="fa-solid fa-floppy-disk me-1"></i> حفظ الإيصال
            </button>
        </div>
    </form>
</div>

<script>
    (function () {
        const project = document.getElementById('projectId');
        const contract = document.getElementById('contractId');
        const hint = document.getElementById('remainingHint');
        const amount = document.getElementById('amount');

        // يعرض فقط عقود المشروع المختار
        function filterContracts() {
            let visible = [];
            contract.querySelectorAll('option[data-project]').forEach(o => {
                const show = o.dataset.project === project.value;
                o.hidden = !show;
                if (show) visible.push(o);
                if (!show && o.selected) contract.value = '';
            });
            if (!contract.value && visible.length === 1) contract.value = visible[0].value;
            showHint();
        }

        function showHint() {
            const opt = contract.selectedOptions[0];
            if (opt && opt.dataset.remaining) {
                const remaining = parseFloat(opt.dataset.remaining);
                hint.textContent = `المتبقي على العقد: ${remaining.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
                amount.max = remaining;
            } else {
                hint.textContent = '';
                amount.removeAttribute('max');
            }
        }

        project.addEventListener('change', filterContracts);
        contract.addEventListener('change', () => {
            showHint();
            const opt = contract.selectedOptions[0];
            if (opt?.dataset.remaining && !(parseFloat(amount.value) > 0)) amount.value = opt.dataset.remaining;
        });
        filterContracts();
    })();
</script>
