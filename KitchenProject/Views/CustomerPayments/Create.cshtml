@model KitchenProject.Models.Entities.CustomerPayment
@{
    ViewData["Title"] = "إضافة دفعة عميل";
    Layout = "_DashboardLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1">
            <i class="fa-solid fa-plus-circle text-primary me-2"></i> إضافة إيصال قبض جديد
        </h2>
        <p class="text-muted mb-0">تسجيل دفعة مالية جديدة مستلمة من العميل</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="fa-solid fa-arrow-right"></i><span>العودة للإيصالات</span>
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="custom-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger mb-4 rounded-3 d-none" id="errorSummary"></div>

                <div class="border-bottom pb-3 mb-4">
                    <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-file-invoice me-2"></i> بيانات الإيصال</h5>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="ReceiptNo" class="form-label fw-bold">رقم الإيصال</label>
                            <input asp-for="ReceiptNo" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-12 col-md-8">
                            <label asp-for="ProjectId" class="form-label fw-bold">المشروع <span class="text-danger">*</span></label>
                            <select asp-for="ProjectId" class="form-select" asp-items="ViewBag.ProjectId" id="projectIdSelect">
                                <option value="">-- اختر المشروع --</option>
                            </select>
                            <span asp-validation-for="ProjectId" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-12">
                            <label asp-for="ContractId" class="form-label fw-bold">العقد المرتبط (اختياري)</label>
                            <select asp-for="ContractId" class="form-select" asp-items="ViewBag.ContractId" id="contractIdSelect">
                                <option value="">-- دفعة عامة على المشروع (غير مرتبطة بعقد محدد) --</option>
                            </select>
                            <span asp-validation-for="ContractId" class="text-danger small"></span>
                            <div id="contractBalanceInfo" class="form-text text-info mt-1 d-none">
                                <i class="fa-solid fa-circle-info me-1"></i> المتبقي من العقد: <span id="contractRemainingAmount" class="fw-bold">0</span> د.ل
                            </div>
                        </div>
                    </div>
                </div>

                <div class="border-bottom pb-3 mb-4">
                    <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-money-bill me-2"></i> تفاصيل الدفع</h5>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Amount" class="form-label fw-bold">المبلغ (د.ل) <span class="text-danger">*</span></label>
                            <input asp-for="Amount" type="number" step="0.01" class="form-control fs-5 fw-bold text-success" placeholder="0.00" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Payment" class="form-label fw-bold">طريقة الدفع</label>
                            <select asp-for="Payment" class="form-select" asp-items="ViewBag.Payment"></select>
                            <span asp-validation-for="Payment" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label fw-bold">البيان / ملاحظات</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="أضف أي تفاصيل أو بيان لهذه الدفعة..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border fw-bold px-4">إلغاء</a>
                    <button type="submit" class="btn btn-primary-custom px-5">
                        <i class="fa-solid fa-save me-2"></i> حفظ الإيصال
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Check for validation errors and show summary if exists
            if ($(".validation-summary-errors").length > 0) {
                $("#errorSummary").removeClass("d-none");
            }

            function loadContracts(projectId, selectedContractId = null) {
                var contractDropdown = $('#contractIdSelect');
                contractDropdown.empty();
                contractDropdown.append($('<option>', { value: '', text: '-- دفعة عامة على المشروع (غير مرتبطة بعقد محدد) --' }));
                $('#contractBalanceInfo').addClass('d-none');

                if (projectId) {
                    $.ajax({
                        url: '@Url.Action("GetProjectContracts", "CustomerPayments")',
                        type: 'GET',
                        data: { projectId: projectId },
                        success: function (data) {
                            $.each(data, function (i, item) {
                                var option = $('<option>', {
                                    value: item.id,
                                    text: item.text,
                                    'data-remaining': item.remaining
                                });
                                contractDropdown.append(option);
                            });
                            
                            if (selectedContractId) {
                                contractDropdown.val(selectedContractId);
                                updateContractInfo();
                            }
                            contractDropdown.trigger('change');
                        }
                    });
                }
            }

            function updateContractInfo() {
                var selectedOption = $('#contractIdSelect option:selected');
                if (selectedOption.val()) {
                    var remaining = selectedOption.data('remaining');
                    $('#contractRemainingAmount').text(remaining.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
                    $('#contractBalanceInfo').removeClass('d-none');
                } else {
                    $('#contractBalanceInfo').addClass('d-none');
                }
            }

            $('#projectIdSelect').change(function () {
                var projectId = $(this).val();
                loadContracts(projectId);
            });

            $('#contractIdSelect').change(function () {
                updateContractInfo();
            });

            // Initial load
            var initialProjectId = $('#projectIdSelect').val();
            var initialContractId = '@(Model?.ContractId != null ? Model.ContractId.ToString() : "")';
            if (initialProjectId) {
                loadContracts(initialProjectId, initialContractId);
            }
        });
    </script>
}
