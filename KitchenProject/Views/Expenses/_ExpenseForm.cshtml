@model KitchenProject.Models.Entities.Expense
@{
    var types = (List<string>)ViewBag.Types;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

<div class="row g-4">
    <div class="col-12 col-md-6">
        <label asp-for="ProjectId" class="form-label fw-bold">المشروع</label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- مصروف عام (بدون مشروع) --</option>
        </select>
        <div class="form-text">مصروف المشروع يدخل في تكلفته وربحه.</div>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="ExpenseType" class="form-label fw-bold">نوع المصروف <span class="text-danger">*</span></label>
        <input asp-for="ExpenseType" class="form-control" list="expenseTypes" placeholder="اختر أو اكتب نوعاً جديداً" />
        <datalist id="expenseTypes">
            @foreach (var t in types)
            {
                <option value="@t"></option>
            }
        </datalist>
        <span asp-validation-for="ExpenseType" class="text-danger small"></span>
    </div>
    <div class="col-6 col-md-4">
        <label asp-for="Amount" class="form-label fw-bold">المبلغ <span class="text-danger">*</span></label>
        <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger small"></span>
    </div>
    <div class="col-6 col-md-4">
        <label asp-for="ExpenseDate" class="form-label fw-bold">التاريخ</label>
        <input asp-for="ExpenseDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="Payment" class="form-label fw-bold">طريقة الدفع</label>
        <select asp-for="Payment" asp-items="ViewBag.MethodList" class="form-select"></select>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label fw-bold">الوصف</label>
        <input asp-for="Description" class="form-control" maxlength="500" placeholder="مثال: نقل الوحدات من الورشة لموقع العميل" />
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Attachment" class="form-label fw-bold">مرفق (فاتورة / إيصال)</label>
        <input asp-for="Attachment" type="file" accept=".pdf,.jpg,.jpeg,.png" class="form-control" />
        <span asp-validation-for="Attachment" class="text-danger small"></span>
        @if (!string.IsNullOrEmpty(Model.AttachmentPath))
        {
            <div class="d-flex align-items-center gap-3 mt-2 small">
                <a href="@Model.AttachmentPath" target="_blank"><i class="fa-solid fa-paperclip me-1"></i> المرفق الحالي</a>
                <label class="form-check-label"><input type="checkbox" name="removeAttachment" value="true" class="form-check-input me-1" /> حذف المرفق</label>
            </div>
        }
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Notes" class="form-label fw-bold">ملاحظات</label>
        <input asp-for="Notes" class="form-control" />
    </div>
</div>
