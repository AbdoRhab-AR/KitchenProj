@model KitchenProject.Models.Entities.Quote
@using KitchenProject.Models.Enums
@using System.Globalization
@{
    var action = (string)ViewData["FormAction"]!;
    var isFinal = Model.Type == ContractType.Final;
    var items = Model.Items.OrderBy(i => i.SortOrder).ToList();
    var catalog = (IEnumerable<dynamic>?)ViewBag.CatalogItems ?? Enumerable.Empty<dynamic>();
    string Num(decimal? d) => d.HasValue ? d.Value.ToString("0.##", CultureInfo.InvariantCulture) : "";
}

<form asp-action="@action" method="post" id="quoteForm">
    @Html.AntiForgeryToken()
    @if (action == "Edit")
    {
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Created" />
    }
    <input type="hidden" asp-for="Type" />
    <input type="hidden" asp-for="SourceQuoteId" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger mb-4 rounded-3"></div>
    }

    <!-- Section 1: Basic Info -->
    <div class="border-bottom pb-3 mb-4">
        <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-info-circle me-2"></i> البيانات الأساسية</h5>
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label asp-for="QuoteNo" class="form-label fw-bold">رقم الفاتورة</label>
                <input asp-for="QuoteNo" class="form-control bg-light" readonly />
            </div>
            <div class="col-12 col-md-8">
                <label asp-for="ProjectId" class="form-label fw-bold">المشروع / الزبون <span class="text-danger">*</span></label>
                <select asp-for="ProjectId" class="form-select" asp-items="ViewBag.ProjectId">
                    <option value="">-- اختر المشروع --</option>
                </select>
                <span asp-validation-for="ProjectId" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label fw-bold">نوع الفاتورة</label>
                <input class="form-control bg-light fw-bold @(isFinal ? "text-success" : "text-primary")" readonly
                       value="@(isFinal ? "فاتورة نهائية" : "فاتورة مبدئية")" />
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="Status" class="form-label fw-bold">الحالة</label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<DesignStatus>()"></select>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="ValidUntil" class="form-label fw-bold">صالحة حتى</label>
                <input asp-for="ValidUntil" type="date" class="form-control"
                       value="@Model.ValidUntil?.ToString("yyyy-MM-dd")" />
            </div>
        </div>
    </div>

    <!-- Section 2: Line items -->
    <div class="border-bottom pb-3 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-primary mb-0"><i class="fa-solid fa-list-ol me-2"></i> أصناف الفاتورة</h5>
            <button type="button" class="btn btn-sm btn-primary-custom" onclick="addItemRow()">
                <i class="fa-solid fa-plus me-1"></i> إضافة صنف
            </button>
        </div>
        <p class="text-muted small mb-2">
            الإجمالي = الوحدة/م × الكمية × ثمن الوحدة (الحقل الفارغ يحسب كـ 1). يمكنك كتابة البيان أو اختياره من قائمة الأصناف.
        </p>
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0" id="itemsTable">
                <thead class="table-light">
                    <tr>
                        <th style="width:45px">ر.ق</th>
                        <th style="min-width:220px">البيان</th>
                        <th style="width:110px">الوحدة / م</th>
                        <th style="width:100px">الكمية</th>
                        <th style="width:130px">ثمن الوحدة</th>
                        <th style="width:130px">الإجمالي</th>
                        <th style="width:50px"></th>
                    </tr>
                </thead>
                <tbody id="itemsBody">
                    @foreach (var item in items)
                    {
                        <tr>
                            <td class="row-no text-center fw-bold"></td>
                            <td>
                                <input type="hidden" name="ItemIds" value="@item.ItemId" />
                                <input name="ItemDescriptions" class="form-control form-control-sm item-desc" list="catalogItems"
                                       maxlength="250" value="@item.Description" />
                            </td>
                            <td><input name="ItemMeters" type="number" step="0.01" min="0" class="form-control form-control-sm item-calc" value="@Num(item.Meters)" /></td>
                            <td><input name="ItemQuantities" type="number" step="0.01" min="0" class="form-control form-control-sm item-calc" value="@Num(item.Quantity)" /></td>
                            <td><input name="ItemPrices" type="number" step="0.01" min="0" class="form-control form-control-sm item-calc item-price" value="@Num(item.UnitPrice)" /></td>
                            <td class="line-total fw-bold text-end"></td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeItemRow(this)" title="حذف">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <datalist id="catalogItems">
            @foreach (var c in catalog)
            {
                <option value="@c.name" data-id="@c.id" data-price="@(((decimal)c.price).ToString("0.##", CultureInfo.InvariantCulture))"></option>
            }
        </datalist>
    </div>

    <!-- Section 3: Pricing -->
    <div class="border-bottom pb-3 mb-4">
        <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-calculator me-2"></i> الإجماليات</h5>
        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="Subtotal" class="form-label fw-bold">إجمالي الأصناف (د.ل)</label>
                <input asp-for="Subtotal" type="number" step="0.01" class="form-control" id="subtotal" oninput="calcTotal()" />
                <span asp-validation-for="Subtotal" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="Discount" class="form-label fw-bold">الخصم (د.ل)</label>
                <input asp-for="Discount" type="number" step="0.01" class="form-control" id="discount" oninput="calcTotal()" />
                <span asp-validation-for="Discount" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="Tax" class="form-label fw-bold">الضريبة (د.ل)</label>
                <input asp-for="Tax" type="number" step="0.01" class="form-control" id="tax" oninput="calcTotal()" />
                <span asp-validation-for="Tax" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="Total" class="form-label fw-bold">الإجمالي المستحق (د.ل)</label>
                <input asp-for="Total" type="number" step="0.01" class="form-control bg-light fw-bold text-success" id="total" readonly />
            </div>
        </div>
    </div>

    <!-- Section 4: Notes & terms -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <label asp-for="Notes" class="form-label fw-bold">ملاحظات</label>
            <textarea asp-for="Notes" class="form-control" rows="4" placeholder="مثال: جميع الاكسسوارات بلوم"></textarea>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Terms" class="form-label fw-bold">الشروط (سطر لكل شرط)</label>
            <textarea asp-for="Terms" class="form-control" rows="4"></textarea>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-light border fw-bold px-4">إلغاء</a>
        <button type="submit" class="btn btn-primary-custom px-5">
            <i class="fa-solid fa-save me-2"></i> حفظ الفاتورة
        </button>
    </div>
</form>

<template id="itemRowTemplate">
    <tr>
        <td class="row-no text-center fw-bold"></td>
        <td>
            <input type="hidden" name="ItemIds" value="" />
            <input name="ItemDescriptions" class="form-control form-control-sm item-desc" list="catalogItems" maxlength="250" />
        </td>
        <td><input name="ItemMeters" type="number" step="0.01" min="0" class="form-control form-control-sm item-calc" /></td>
        <td><input name="ItemQuantities" type="number" step="0.01" min="0" class="form-control form-control-sm item-calc" /></td>
        <td><input name="ItemPrices" type="number" step="0.01" min="0" class="form-control form-control-sm item-calc item-price" /></td>
        <td class="line-total fw-bold text-end"></td>
        <td class="text-center">
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeItemRow(this)" title="حذف">
                <i class="fa-solid fa-trash"></i>
            </button>
        </td>
    </tr>
</template>

<script>
    function lineTotal(row) {
        const val = sel => parseFloat(row.querySelector(sel).value) || 0;
        const m = val('[name=ItemMeters]') || 1;
        const q = val('[name=ItemQuantities]') || 1;
        return Math.round(m * q * val('[name=ItemPrices]') * 100) / 100;
    }

    function calcTotal() {
        const rows = document.querySelectorAll('#itemsBody tr');
        const subtotal = document.getElementById('subtotal');
        let sum = 0;
        rows.forEach((row, i) => {
            row.querySelector('.row-no').textContent = i + 1;
            const t = lineTotal(row);
            row.querySelector('.line-total').textContent = t.toFixed(2);
            sum += t;
        });
        // عند وجود أصناف يحسب الإجمالي منها تلقائياً
        if (rows.length > 0) {
            subtotal.value = sum.toFixed(2);
            subtotal.readOnly = true;
            subtotal.classList.add('bg-light');
        } else {
            subtotal.readOnly = false;
            subtotal.classList.remove('bg-light');
        }
        const sub = parseFloat(subtotal.value) || 0;
        const dis = parseFloat(document.getElementById('discount').value) || 0;
        const tax = parseFloat(document.getElementById('tax').value) || 0;
        document.getElementById('total').value = (sub - dis + tax).toFixed(2);
    }

    function addItemRow(focus = true) {
        const tpl = document.getElementById('itemRowTemplate');
        document.getElementById('itemsBody').appendChild(tpl.content.cloneNode(true));
        calcTotal();
        if (focus) {
            const rows = document.querySelectorAll('#itemsBody tr');
            rows[rows.length - 1].querySelector('.item-desc').focus();
        }
    }

    function removeItemRow(btn) {
        btn.closest('tr').remove();
        calcTotal();
    }

    // عند اختيار صنف من القائمة: ربطه بالصنف وتعبئة السعر إن كان فارغاً
    function onDescChange(input) {
        const row = input.closest('tr');
        const idField = row.querySelector('[name=ItemIds]');
        const opt = Array.from(document.querySelectorAll('#catalogItems option'))
            .find(o => o.value === input.value);
        idField.value = opt ? opt.dataset.id : '';
        const price = row.querySelector('.item-price');
        if (opt && !price.value) price.value = opt.dataset.price;
        calcTotal();
    }

    document.getElementById('itemsBody').addEventListener('input', e => {
        if (e.target.classList.contains('item-calc')) calcTotal();
    });
    document.getElementById('itemsBody').addEventListener('change', e => {
        if (e.target.classList.contains('item-desc')) onDescChange(e.target);
    });

    if (document.querySelectorAll('#itemsBody tr').length === 0) addItemRow(false);
    calcTotal();
</script>
