@model IEnumerable<KitchenProject.Models.Entities.Contract>
@{
    ViewData["Title"] = "إدارة العقود";
    Layout = "_DashboardLayout";
}

<!-- Page Header & Title Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1">
            <i class="fa-solid fa-file-contract text-primary me-2"></i> إدارة العقود
        </h2>
        <p class="text-muted mb-0">
            @if (ViewBag.ProjectName != null)
            {
                <span>عقود المشروع: <strong>@ViewBag.ProjectName</strong></span>
            }
            else
            {
                <span>عقود التنفيذ والمواصفات المتفق عليها مع العملاء</span>
            }
        </p>
    </div>
    <div>
        <a asp-action="Create" asp-route-projectId="@ViewBag.ProjectId" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-file-signature"></i>
            <span>عقد جديد</span>
        </a>
    </div>
</div>

<!-- KPI Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-4">
        <div class="custom-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted fw-bold d-block mb-1" style="font-size:0.85rem;">عقود سارية</span>
                <h3 class="fw-extrabold mb-0 text-success">@ViewBag.ActiveCount</h3>
            </div>
            <div class="bg-success-subtle text-success rounded-3 p-3">
                <i class="fa-solid fa-file-signature fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="custom-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted fw-bold d-block mb-1" style="font-size:0.85rem;">قيمة العقود السارية</span>
                <h3 class="fw-extrabold mb-0 text-primary">@(((decimal)ViewBag.ActiveTotal).ToString("N2"))</h3>
            </div>
            <div class="bg-primary-subtle text-primary rounded-3 p-3">
                <i class="fa-solid fa-sack-dollar fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="custom-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted fw-bold d-block mb-1" style="font-size:0.85rem;">المتبقي للتحصيل</span>
                <h3 class="fw-extrabold mb-0 text-danger">@(((decimal)ViewBag.ActiveRemaining).ToString("N2"))</h3>
            </div>
            <div class="bg-danger-subtle text-danger rounded-3 p-3">
                <i class="fa-solid fa-hand-holding-dollar fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="custom-card mb-4 p-3">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <input type="hidden" name="projectId" value="@ViewBag.ProjectId" />
        <div class="col-12 col-md-6 col-lg-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="searchString" class="form-control border-start-0 ps-0" placeholder="بحث برقم العقد أو المشروع أو العميل..." value="@ViewBag.SearchString">
            </div>
        </div>
        <div class="col-12 col-md-3">
            <select name="status" class="form-select" asp-items="ViewBag.StatusList">
                <option value="">كل الحالات</option>
            </select>
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary fw-bold px-4 rounded-3 flex-grow-1">
                <i class="fa-solid fa-search me-1"></i> بحث
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchString) || !string.IsNullOrEmpty(ViewBag.Status) || ViewBag.ProjectId != null)
            {
                <a asp-action="Index" class="btn btn-light border fw-bold text-muted" title="إلغاء الفلترة">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Contracts Table Card -->
<div class="custom-card">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-list text-secondary me-2"></i> قائمة العقود
        </h5>
        <span class="badge bg-light text-dark border">عدد النتائج: @ViewBag.TotalCount</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted" style="font-size:0.85rem;">
                <tr>
                    <th class="ps-4">رقم العقد</th>
                    <th>المشروع / العميل</th>
                    <th>المدة</th>
                    <th>القيمة</th>
                    <th>المدفوع / المتبقي</th>
                    <th>الحالة</th>
                    <th class="text-center pe-4">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-action="Details" asp-route-id="@item.Id" class="badge bg-primary-subtle text-primary px-2 py-1 rounded-2 text-decoration-none">
                                    <i class="fa-solid fa-hashtag me-1"></i>@item.ContractNo
                                </a>
                                @if (!string.IsNullOrEmpty(item.ContractFilePath))
                                {
                                    <i class="fa-solid fa-paperclip text-muted ms-1" title="مرفق نسخة موقعة"></i>
                                }
                            </td>
                            <td>
                                <a asp-controller="Projects" asp-action="Details" asp-route-id="@item.ProjectId" class="fw-bold text-dark text-decoration-none">@item.Projects?.ProjectName</a>
                                <small class="d-block text-muted">@item.Projects?.Customer?.Name</small>
                            </td>
                            <td class="small text-muted">
                                @(item.StartDate?.ToString("yyyy/MM/dd") ?? "-")
                                <i class="fa-solid fa-arrow-left mx-1"></i>
                                @(item.ExpectedEndDate?.ToString("yyyy/MM/dd") ?? "-")
                            </td>
                            <td class="fw-bold">@item.TotalAmount.ToString("N2")</td>
                            <td class="small">
                                <span class="text-success fw-bold">@item.PaidAmount.ToString("N2")</span>
                                <span class="d-block text-danger">@item.RemainingAmount.ToString("N2")</span>
                            </td>
                            <td><partial name="_StatusBadge" model="item.Status" /></td>
                            <td class="text-center pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light border text-info" title="عرض التفاصيل"><i class="fa-solid fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light border text-primary" title="تعديل"><i class="fa-solid fa-pen-to-square"></i></a>
                                    <a asp-action="Print" asp-route-id="@item.Id" target="_blank" class="btn btn-light border text-dark" title="طباعة"><i class="fa-solid fa-print"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-file-contract display-4 mb-3 d-block text-secondary opacity-50"></i>
                            <h5 class="fw-bold mb-1">لا توجد عقود</h5>
                            <p class="text-muted small mb-0">أنشئ عقداً من عرض سعر معتمد أو من صفحة المشروع</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model='new Dictionary<string, string?> { ["searchString"] = ViewBag.SearchString, ["status"] = ViewBag.Status, ["projectId"] = ViewBag.ProjectId?.ToString() }' />
</div>
