@model JournalEntry
@{
    ViewData["Title"] = "قيد " + Model.EntryNo;
    Layout = "_DashboardLayout";
    var projects = (Dictionary<Guid, string>)ViewBag.Projects;
    DateTime? closed = ViewBag.ClosedThrough;
    var canDelete = !Model.IsAuto && !(closed.HasValue && Model.EntryDate.Date <= closed.Value);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1"><i class="fa-solid fa-book text-primary me-2"></i> قيد @Model.EntryNo</h2>
        <p class="text-muted mb-0">@Model.EntryDate.ToString("yyyy/MM/dd") - @Model.Description</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="JournalDetailsPrint" asp-route-id="@Model.Id" target="_blank" class="btn btn-light border"><i class="fa-solid fa-print me-1"></i> طباعة (A4)</a>
        @if (canDelete)
        {
            <a asp-action="EditJournal" asp-route-id="@Model.Id" class="btn btn-light border text-primary"><i class="fa-solid fa-pen me-1"></i> تعديل</a>
            <form asp-action="DeleteJournal" asp-route-id="@Model.Id" method="post" class="m-0" onsubmit="return confirm('حذف هذا القيد؟')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-light border text-danger"><i class="fa-solid fa-trash-can me-1"></i> حذف</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-light border">رجوع</a>
    </div>
</div>

<div class="custom-card mb-3 p-3">
    <div class="row g-3 small">
        <div class="col-6 col-md-3"><span class="text-muted d-block">المصدر</span><span class="fw-bold">@AccountingService.SourceName(Model.SourceType)</span></div>
        <div class="col-6 col-md-3"><span class="text-muted d-block">أنشأه</span><span class="fw-bold">@(Model.CreatedBy ?? "-")</span></div>
        <div class="col-6 col-md-3">
            <span class="text-muted d-block">المستند</span>
            @if (Model.SourceType == "Contract" && Model.SourceId.HasValue)
            {
                <a asp-controller="Contracts" asp-action="Details" asp-route-id="@Model.SourceId" class="fw-bold">فتح العقد</a>
            }
            else if (Model.SourceType == "Purchase" && Model.SourceId.HasValue)
            {
                <a asp-controller="Purchases" asp-action="Details" asp-route-id="@Model.SourceId" class="fw-bold">فتح الفاتورة</a>
            }
            else if (Model.SourceType == "Cancellation" && Model.SourceId.HasValue)
            {
                <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.SourceId" class="fw-bold">فتح المشروع</a>
            }
            else
            {
                <span>-</span>
            }
        </div>
        @if (Model.IsAuto)
        {
            <div class="col-6 col-md-3"><span class="badge bg-info-subtle text-info-emphasis">قيد تلقائي يتبع مستنده</span></div>
        }
    </div>
</div>

<div class="custom-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="bg-light text-muted" style="font-size:0.85rem;">
                <tr>
                    <th class="ps-4">الحساب</th>
                    <th>البيان</th>
                    <th>المشروع</th>
                    <th>مدين</th>
                    <th>دائن</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines.OrderByDescending(l => l.Debit > 0).ThenBy(l => l.Account.Code))
                {
                    <tr>
                        <td class="ps-4">
                            <a asp-action="Ledger" asp-route-accountId="@l.AccountId"><span class="font-monospace">@l.Account.Code</span> - @l.Account.Name</a>
                        </td>
                        <td class="small">@l.Description</td>
                        <td class="small">@(l.ProjectId.HasValue && projects.TryGetValue(l.ProjectId.Value, out var pn) ? pn : "")</td>
                        <td class="fw-bold">@(l.Debit == 0 ? "" : l.Debit.ToString("N2"))</td>
                        <td class="fw-bold">@(l.Credit == 0 ? "" : l.Credit.ToString("N2"))</td>
                    </tr>
                }
            </tbody>
            <tfoot class="bg-light fw-bold">
                <tr>
                    <td colspan="3" class="ps-4">الإجمالي</td>
                    <td>@Model.TotalDebit.ToString("N2")</td>
                    <td>@Model.TotalCredit.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
