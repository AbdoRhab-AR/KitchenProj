@model List<AccountNode>
@{
    ViewData["Title"] = "قائمة الدخل";
    Layout = "_DashboardLayout";
    DateTime? from = ViewBag.From;
    DateTime? to = ViewBag.To;

    // إيراد: الدائن - المدين، ومصروف: المدين - الدائن
    var postable = Model.Where(n => n.Account.IsPostable && n.Balance != 0).ToList();
    var revenue = postable.Where(n => n.Account.Type == AccountType.Revenue).ToList();
    var cost = postable.Where(n => n.Account.Type == AccountType.Expense && n.Account.Code.StartsWith("5")).ToList();
    var opex = postable.Where(n => n.Account.Type == AccountType.Expense && !n.Account.Code.StartsWith("5")).ToList();

    var totalRevenue = revenue.Sum(n => n.Balance);
    var totalCost = cost.Sum(n => n.Balance);
    var totalOpex = opex.Sum(n => n.Balance);
    var gross = totalRevenue - totalCost;
    var net = gross - totalOpex;

    async Task Section(string title, List<AccountNode> rows, decimal total, string css)
    {
        <tr class="table-light"><td colspan="2" class="ps-4 fw-bold">@title</td></tr>
        foreach (var n in rows)
        {
            <tr>
                <td class="ps-5"><a asp-action="Ledger" asp-route-accountId="@n.Account.Id" asp-route-from="@from?.ToString("yyyy-MM-dd")" asp-route-to="@to?.ToString("yyyy-MM-dd")"><span class="font-monospace text-muted">@n.Account.Code</span> @n.Account.Name</a></td>
                <td>@n.Balance.ToString("N2")</td>
            </tr>
        }
        <tr class="fw-bold"><td class="ps-4">إجمالي @title</td><td class="@css">@total.ToString("N2")</td></tr>
    }
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1"><i class="fa-solid fa-file-invoice text-primary me-2"></i> قائمة الدخل</h2>
        <p class="text-muted mb-0">الإيرادات مقابل التكلفة والمصروفات للفترة، ويمكن حصرها في مشروع واحد لمعرفة ربحيته محاسبياً</p>
    </div>
    <a asp-action="IncomeStatementPrint" asp-route-from="@from?.ToString("yyyy-MM-dd")" asp-route-to="@to?.ToString("yyyy-MM-dd")" asp-route-projectId="@ViewBag.ProjectId" target="_blank" class="btn btn-light border"><i class="fa-solid fa-print me-1"></i> طباعة (A4)</a>
</div>

<div class="custom-card mb-4 p-3">
    <form method="get" asp-action="IncomeStatement" class="row g-3 align-items-end">
        <div class="col-6 col-md-2">
            <label class="form-label small fw-bold text-muted">من</label>
            <input type="date" name="from" value="@from?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small fw-bold text-muted">إلى</label>
            <input type="date" name="to" value="@to?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-12 col-md-5">
            <label class="form-label small fw-bold text-muted">المشروع</label>
            <select name="projectId" class="form-select" asp-items="ViewBag.Projects"><option value="">كل الشركة</option></select>
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary fw-bold rounded-3"><i class="fa-solid fa-search me-1"></i> عرض</button>
            <a asp-action="IncomeStatement" class="btn btn-light border text-muted"><i class="fa-solid fa-xmark"></i></a>
        </div>
    </form>
</div>

<div class="custom-card">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">من @from?.ToString("yyyy/MM/dd") إلى @to?.ToString("yyyy/MM/dd")</h5>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <tbody>
                @{ await Section("الإيرادات", revenue, totalRevenue, "text-success"); }
                @{ await Section("تكلفة المبيعات", cost, totalCost, "text-danger"); }
                <tr class="table-primary fw-bold"><td class="ps-4">مجمل الربح</td><td class="@(gross < 0 ? "text-danger" : "")">@gross.ToString("N2")</td></tr>
                @{ await Section("المصروفات التشغيلية", opex, totalOpex, "text-danger"); }
                <tr class="@(net >= 0 ? "table-success" : "table-danger") fw-bold fs-5">
                    <td class="ps-4">@(net >= 0 ? "صافي الربح" : "صافي الخسارة")</td>
                    <td>@net.ToString("N2")</td>
                </tr>
                @if (totalRevenue > 0)
                {
                    <tr class="small text-muted"><td class="ps-4">هامش صافي الربح</td><td>@((net / totalRevenue * 100).ToString("N1"))%</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

