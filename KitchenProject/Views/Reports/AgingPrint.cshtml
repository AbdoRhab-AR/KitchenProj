@model List<AgingRow>
@{
    Layout = "_PrintLayout";
    string kind = ViewBag.Kind ?? "customers";
    DateTime asOf = ViewBag.AsOf;
    ViewData["Title"] = "أعمار الديون";
    ViewData["DocTitle"] = kind == "suppliers" ? "تقرير أعمار ذمم الموردين" : "تقرير أعمار ذمم العملاء";
    ViewData["DocNo"] = $"كما في {asOf:yyyy/MM/dd}";
}

<table class="table table-bordered print-table">
    <thead>
        <tr>
            <th>@(kind == "suppliers" ? "المورد" : "العميل")</th>
            <th style="width:11%">المستند</th>
            <th style="width:10%">التاريخ</th>
            <th style="width:7%">العمر</th>
            <th style="width:11%">0 - 30</th>
            <th style="width:11%">31 - 60</th>
            <th style="width:11%">61 - 90</th>
            <th style="width:11%">+90</th>
            <th style="width:13%">المتبقي</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td class="small fw-semibold">@r.PartyName</td>
                <td class="font-monospace small">@r.DocNo</td>
                <td class="small">@r.DocDate.ToString("yyyy/MM/dd")</td>
                <td class="small">@r.AgeDays</td>
                <td class="text-start">@(r.Bucket0To30 == 0 ? "" : r.Bucket0To30.ToString("N2"))</td>
                <td class="text-start">@(r.Bucket31To60 == 0 ? "" : r.Bucket31To60.ToString("N2"))</td>
                <td class="text-start">@(r.Bucket61To90 == 0 ? "" : r.Bucket61To90.ToString("N2"))</td>
                <td class="text-start">@(r.BucketOver90 == 0 ? "" : r.BucketOver90.ToString("N2"))</td>
                <td class="text-start fw-bold">@r.Remaining.ToString("N2")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="fw-bold bg-light">
            <td colspan="4">الإجمالي</td>
            <td class="text-start">@Model.Sum(r => r.Bucket0To30).ToString("N2")</td>
            <td class="text-start">@Model.Sum(r => r.Bucket31To60).ToString("N2")</td>
            <td class="text-start">@Model.Sum(r => r.Bucket61To90).ToString("N2")</td>
            <td class="text-start">@Model.Sum(r => r.BucketOver90).ToString("N2")</td>
            <td class="text-start">@Model.Sum(r => r.Remaining).ToString("N2")</td>
        </tr>
    </tfoot>
</table>

<div class="small text-muted mt-2">طُبع بتاريخ @DateTime.Now.ToString("yyyy/MM/dd HH:mm") بواسطة @ViewBag.PrintedBy</div>
<div class="signatures mt-4"><div>المحاسب</div><div>اعتماد الإدارة</div></div>
