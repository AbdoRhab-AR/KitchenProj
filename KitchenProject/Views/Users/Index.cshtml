@model List<UserRow>
@{
    ViewData["Title"] = "المستخدمين";
    Layout = "_DashboardLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1"><i class="fa-solid fa-user-shield text-primary me-2"></i> المستخدمين والصلاحيات</h2>
        <p class="text-muted mb-0">حسابات الموظفين، أدوارهم، وإيقاف أو تفعيل الحسابات</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-user-plus"></i>
            <span>مستخدم جديد</span>
        </a>
    </div>
</div>

<div class="custom-card mb-4 p-3">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-12 col-md-8 col-lg-9">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="searchString" class="form-control border-start-0 ps-0" placeholder="بحث بالاسم أو اسم الدخول أو الهاتف..." value="@ViewBag.SearchString">
            </div>
        </div>
        <div class="col-12 col-md-4 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary fw-bold px-4 rounded-3 flex-grow-1"><i class="fa-solid fa-search me-1"></i> بحث</button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchString))
            {
                <a asp-action="Index" class="btn btn-light border fw-bold text-muted" title="إلغاء الفلترة"><i class="fa-solid fa-xmark"></i></a>
            }
        </div>
    </form>
</div>

<div class="custom-card">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-list text-secondary me-2"></i> الحسابات</h5>
        <span class="badge bg-light text-dark border">@Model.Count مستخدم</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted" style="font-size:0.85rem;">
                <tr>
                    <th class="ps-4">الموظف</th>
                    <th>اسم الدخول</th>
                    <th>الدور</th>
                    <th>الهاتف</th>
                    <th>آخر دخول</th>
                    <th>الحالة</th>
                    <th class="text-center pe-4">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var u in Model)
                    {
                        <tr class="@(u.IsActive ? "" : "opacity-50")">
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="bg-primary-subtle text-primary fw-bold rounded-circle d-inline-flex align-items-center justify-content-center" style="width:36px; height:36px;">@(u.DisplayName.Length > 0 ? u.DisplayName[0] : '?')</span>
                                    <span class="fw-bold">@u.DisplayName</span>
                                </div>
                            </td>
                            <td class="small font-monospace" dir="ltr">@u.UserName</td>
                            <td><span class="badge bg-light text-dark border">@AppRoles.GetName(u.Role)</span></td>
                            <td class="small" dir="ltr">@u.PhoneNumber</td>
                            <td class="small text-muted">@(u.LastAccessTime?.ToLocalTime().ToString("yyyy/MM/dd hh:mm tt") ?? "لم يدخل بعد")</td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2"><i class="fa-solid fa-circle-check me-1"></i>فعال</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2"><i class="fa-solid fa-ban me-1"></i>موقوف</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-light border text-primary" title="تعديل"><i class="fa-solid fa-pen-to-square"></i></a>
                                    <button type="submit" form="toggle-@u.Id" class="btn btn-light border @(u.IsActive ? "text-danger" : "text-success")" title="@(u.IsActive ? "إيقاف الحساب" : "تفعيل الحساب")">
                                        <i class="fa-solid @(u.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                    </button>
                                </div>
                                <form id="toggle-@u.Id" asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-none"
                                      onsubmit="return confirm('@(u.IsActive ? "إيقاف" : "تفعيل") حساب @u.DisplayName؟')">
                                    @Html.AntiForgeryToken()
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center py-5 text-muted">لا يوجد مستخدمون</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
