@model KitchenProject.Models.Entities.Warehouse
@{ ViewData["Title"] = "إضافة مخزن"; Layout = "_DashboardLayout"; }
<div class="d-flex justify-content-between mb-4"><h2 class="page-header-title">إضافة مخزن جديد</h2><a asp-action="Index" class="btn btn-secondary">عودة</a></div>
<div class="custom-card p-4 col-md-6">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label fw-bold">اسم المخزن *</label><input asp-for="Name" class="form-control" required /></div>
        <div class="mb-3"><label asp-for="Location" class="form-label fw-bold">الموقع</label><input asp-for="Location" class="form-control" /></div>
        <div class="mb-3 form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label fw-bold">نشط</label></div>
        <button type="submit" class="btn btn-primary-custom w-100">حفظ</button>
    </form>
</div>
