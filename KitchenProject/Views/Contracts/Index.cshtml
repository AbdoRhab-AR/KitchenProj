@model IEnumerable<KitchenProject.Models.Entities.Contract>
@{
    ViewData["Title"] = "إدارة العقود";
    Layout = "_DashboardLayout";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1">
            <i class="fa-solid fa-file-contract text-primary me-2"></i> إدارة العقود
        </h2>
        <p class="text-muted mb-0">متابعة العقود المبرمة مع العملاء والموقف المالي لكل عقد</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-plus"></i>
            <span>إضافة عقد جديد</span>
        </a>
    </div>
</div>



<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="custom-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted fw-bold d-block mb-1" style="font-size:0.85rem;">إجمالي العقود</span>
                <h3 class="fw-extrabold mb-0 text-dark">@ViewBag.TotalContractsCount</h3>
            </div>
            <div class="bg-primary-subtle text-primary rounded-3 p-3">
                <i class="fa-solid fa-file-contract fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="custom-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted fw-bold d-block mb-1" style="font-size:0.85rem;">العقود السارية</span>
                <h3 class="fw-extrabold mb-0 text-success">@ViewBag.ActiveCount</h3>
            </div>
            <div class="bg-success-subtle text-success rounded-3 p-3">
                <i class="fa-solid fa-circle-check fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="custom-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted fw-bold d-block mb-1" style="font-size:0.85rem;">إجمالي قيمة العقود</span>
                <h4 class="fw-extrabold mb-0 text-dark">@ViewBag.TotalContractValue.ToString("N0") <small class="fs-6 text-muted">د.ل</small></h4>
            </div>
            <div class="bg-info-subtle text-info rounded-3 p-3">
                <i class="fa-solid fa-money-bill-wave fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="custom-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted fw-bold d-block mb-1" style="font-size:0.85rem;">إجمالي المحصل</span>
                <h4 class="fw-extrabold mb-0 text-success">@ViewBag.TotalPaidValue.ToString("N0") <small class="fs-6 text-muted">د.ل</small></h4>
            </div>
            <div class="bg-success-subtle text-success rounded-3 p-3">
                <i class="fa-solid fa-hand-holding-dollar fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter -->
<div class="custom-card mb-4 p-3">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-12 col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="searchString" class="form-control border-start-0 ps-0"
                       placeholder="بحث برقم العقد أو المشروع أو العميل..." value="@ViewBag.SearchString">
            </div>
        </div>
        <div class="col-12 col-md-3">
            <select name="statusFilter" class="form-select" asp-items="ViewBag.StatusList">
                <option value="">-- كل الحالات --</option>
            </select>
        </div>
        <div class="col-12 col-md-3">
            <select name="projectFilter" class="form-select" asp-items="ViewBag.ProjectsList">
                <option value="">-- كل المشاريع --</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary fw-bold rounded-3 flex-grow-1">
                <i class="fa-solid fa-search me-1"></i> بحث
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchString) || !string.IsNullOrEmpty(ViewBag.StatusFilter) || ViewBag.ProjectFilter != null)
            {
                <a asp-action="Index" class="btn btn-light border fw-bold text-muted" title="إلغاء البحث">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Data Table -->
<div class="custom-card">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-list text-secondary me-2"></i> قائمة العقود
        </h5>
        <span class="badge bg-light text-dark border">عدد النتائج: @ViewBag.TotalCount</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted" style="font-size:0.85rem; text-transform:uppercase;">
                <tr>
                    <th class="ps-4">رقم العقد</th>
                    <th>المشروع / العميل</th>
                    <th>قيمة العقد</th>
                    <th>المسدد</th>
                    <th>المتبقي</th>
                    <th>تاريخ البدء</th>
                    <th>الحالة</th>
                    <th class="text-center pe-4">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-folder-open fs-1 d-block mb-3 opacity-50"></i>
                            لم يتم العثور على أي عقود مطابقة للبحث
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var remaining = item.TotalAmount - item.PaidAmount;
                        <tr>
                            <td class="ps-4 fw-bold text-primary">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                    <i class="fa-solid fa-hashtag me-1 opacity-75"></i>@item.ContractNo
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Projects" asp-action="Details" asp-route-id="@item.ProjectId"
                                   class="fw-semibold text-dark text-decoration-none">
                                    @item.Projects?.ProjectNo
                                </a>
                                <small class="d-block text-muted">@(item.Projects?.Customer?.Name ?? "-")</small>
                            </td>
                            <td class="fw-bold text-dark">@item.TotalAmount.ToString("N0") د.ل</td>
                            <td class="text-success fw-semibold">@item.PaidAmount.ToString("N0") د.ل</td>
                            <td class="@(remaining > 0 ? "text-danger fw-semibold" : "text-success fw-semibold")">
                                @remaining.ToString("N0") د.ل
                            </td>
                            <td class="text-muted" style="font-size:0.88rem;">
                                @(item.StartDate?.ToString("yyyy/MM/dd") ?? "-")
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case "Draft":
                                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-2">مسودة</span>
                                        break;
                                    case "Active":
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                                            <i class="fa-solid fa-circle-check me-1"></i>ساري
                                        </span>
                                        break;
                                    case "Completed":
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2">مكتمل</span>
                                        break;
                                    case "Cancelled":
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2">ملغى</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2">@item.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="التفاصيل">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="تعديل">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="حذف"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>

                                <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-header-title mb-0">تأكيد حذف العقد</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body py-4">
                                                <p class="mb-2">هل أنت متأكد من حذف العقد رقم <strong>@item.ContractNo</strong>؟</p>
                                                <p class="text-muted small mb-0"><i class="fa-solid fa-triangle-exclamation text-warning me-1"></i> لا يمكن التراجع عن هذه العملية.</p>
                                            </div>
                                            <div class="modal-footer bg-light">
                                                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">إلغاء</button>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger px-4 fw-bold">تأكيد الحذف</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top-0 py-3">
            <nav>
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-searchString="@ViewBag.SearchString" asp-route-statusFilter="@ViewBag.StatusFilter" asp-route-projectFilter="@ViewBag.ProjectFilter">السابق</a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i"
                               asp-route-searchString="@ViewBag.SearchString" asp-route-statusFilter="@ViewBag.StatusFilter" asp-route-projectFilter="@ViewBag.ProjectFilter">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-searchString="@ViewBag.SearchString" asp-route-statusFilter="@ViewBag.StatusFilter" asp-route-projectFilter="@ViewBag.ProjectFilter">التالي</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
