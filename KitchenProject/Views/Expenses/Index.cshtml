@model IEnumerable<KitchenProject.Models.Entities.Expense>
@using KitchenProject.Models.Enums
@{
    ViewData["Title"] = "المصروفات";
    Layout = "_DashboardLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1">
            <i class="fa-solid fa-hand-holding-dollar text-danger me-2"></i> المصروفات
        </h2>
        <p class="text-muted mb-0">إدارة ومتابعة المصروفات العامة والمصروفات على المشاريع</p>
    </div>
    <a asp-action="Create" class="btn btn-danger d-inline-flex align-items-center gap-2 shadow-sm">
        <i class="fa-solid fa-plus"></i><span>إضافة مصروف جديد</span>
    </a>
</div>

<!-- Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="custom-card p-3 border-start border-4 border-danger">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1 fs-sm">إجمالي المصروفات</p>
                    <h4 class="mb-0 fw-bold">@ViewBag.TotalExpensesAmount.ToString("N2") د.ل</h4>
                </div>
                <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger">
                    <i class="fa-solid fa-arrow-trend-down fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="custom-card p-3 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1 fs-sm">إجمالي عدد المصروفات</p>
                    <h4 class="mb-0 fw-bold">@ViewBag.TotalCount</h4>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                    <i class="fa-solid fa-receipt fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="custom-card p-4">
    <form asp-action="Index" method="get" class="row g-3 mb-4 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label text-muted fs-sm">بحث في الوصف</label>
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="fa-solid fa-search text-muted"></i></span>
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="ابحث هنا..." />
            </div>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label text-muted fs-sm">تصفية بالمشروع</label>
            <select name="projectFilter" class="form-select" asp-items="ViewBag.ProjectsList">
                <option value="">-- كل المشاريع --</option>
            </select>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label text-muted fs-sm">نوع المصروف</label>
            <select name="typeFilter" class="form-select" asp-items="ViewBag.ExpenseTypesList">
                <option value="">-- الكل --</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <button type="submit" class="btn btn-secondary w-100">
                <i class="fa-solid fa-filter me-2"></i> تصفية
            </button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle custom-table">
            <thead class="table-light">
                <tr>
                    <th>نوع المصروف</th>
                    <th>المبلغ</th>
                    <th>المشروع (إن وجد)</th>
                    <th>تاريخ الصرف</th>
                    <th>طريقة الدفع</th>
                    <th class="text-center">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@item.ExpenseType</div>
                                <div class="text-muted fs-sm text-truncate" style="max-width: 200px;" title="@item.Description">
                                    @(item.Description ?? "بدون وصف")
                                </div>
                            </td>
                            <td>
                                <strong class="text-danger">@item.Amount.ToString("N2") د.ل</strong>
                            </td>
                            <td>
                                @if (item.ProjectId.HasValue)
                                {
                                    <span class="badge bg-primary">@item.Project?.ProjectName</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">مصروف عام</span>
                                }
                            </td>
                            <td>
                                <div class="text-muted">
                                    <i class="fa-regular fa-calendar me-1"></i> @item.Created.ToString("dd-MM-yyyy")
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @Html.DisplayFor(modelItem => item.Payment)
                                </span>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    @if (!string.IsNullOrEmpty(item.AttachmentPath))
                                    {
                                        <a href="@item.AttachmentPath" target="_blank" class="btn btn-sm btn-outline-secondary" title="عرض المرفق">
                                            <i class="fa-solid fa-paperclip"></i>
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="التفاصيل">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="تعديل">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا المصروف نهائياً؟');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-file-invoice-dollar fs-1 mb-3 text-light"></i>
                            <p class="mb-0">لا توجد مصروفات مطابقة للبحث</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, searchString = ViewBag.SearchString, projectFilter = ViewBag.ProjectFilter, typeFilter = ViewBag.TypeFilter })">السابق</a>
                </li>
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, searchString = ViewBag.SearchString, projectFilter = ViewBag.ProjectFilter, typeFilter = ViewBag.TypeFilter })">@i</a>
                    </li>
                }
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, searchString = ViewBag.SearchString, projectFilter = ViewBag.ProjectFilter, typeFilter = ViewBag.TypeFilter })">التالي</a>
                </li>
            </ul>
        </nav>
    }
</div>
