@model string
@{
    var (css, icon) = Model switch
    {
        PurchaseStatuses.Draft     => ("bg-secondary-subtle text-secondary", "fa-file-pen"),
        PurchaseStatuses.Received  => ("bg-success-subtle text-success", "fa-truck-ramp-box"),
        PurchaseStatuses.Cancelled => ("bg-danger-subtle text-danger", "fa-ban"),
        _                          => ("bg-light text-dark", "fa-circle")
    };
}
<span class="badge @css rounded-pill px-3 py-2 fw-bold">
    <i class="fa-solid @icon me-1"></i> @PurchaseStatuses.GetName(Model)
</span>
