@model KitchenProject.Models.Entities.Quote
@{
    var catalog = ViewBag.ItemOptions as List<ItemOption> ?? new();
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // كتالوج الأصناف (الوحدات المصنّعة + الإكسسوارات والخامات المخزنية) مقسماً حسب البنود، واختيار صنف يملأ الوصف والوحدة والسعر
    string CatalogSelect(Guid? selected) =>
        "<option value=\"\">بند حر</option>" + string.Concat(catalog.GroupBy(o => o.GroupName ?? "بدون بند").Select(g =>
            $"<optgroup label=\"{System.Net.WebUtility.HtmlEncode(g.Key)}\">" + string.Concat(g.Select(o =>
            {
                var stockText = o.Type == ItemType.Raw
                    ? (o.Balance > 0 ? $" [المتوفر: {o.Balance.ToString("0.##", inv)} {o.Unit}]" : " [رصيد المخزن: 0]")
                    : "";
                return $"<option value=\"{o.Id}\" data-name=\"{System.Net.WebUtility.HtmlEncode(o.Name)}\" data-unit=\"{System.Net.WebUtility.HtmlEncode(o.Unit)}\" data-price=\"{o.Price.ToString("0.##", inv)}\" data-cost=\"{o.Cost.ToString("0.##", inv)}\" data-type=\"{o.Type}\" data-balance=\"{o.Balance.ToString("0.##", inv)}\"{(o.Id == selected ? " selected" : "")}>{System.Net.WebUtility.HtmlEncode(o.Code + " - " + o.Name + stockText)}</option>";
            })) + "</optgroup>"));
}

<div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

<!-- Basic Info -->
<h6 class="fw-bold text-muted mb-3"><i class="fa-solid fa-circle-info me-2"></i> بيانات العرض</h6>
<div class="row g-4 mb-4">
    <div class="col-12 col-md-3">
        <label asp-for="QuoteNo" class="form-label fw-bold">رقم العرض</label>
        <input asp-for="QuoteNo" class="form-control bg-light fw-bold text-primary" readonly />
    </div>
    <div class="col-12 col-md-5">
        <label asp-for="ProjectId" class="form-label fw-bold">المشروع <span class="text-danger">*</span></label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- اختر المشروع --</option>
        </select>
        <span asp-validation-for="ProjectId" class="text-danger small"></span>
    </div>
    <div class="col-6 col-md-2">
        <label asp-for="ValidUntil" class="form-label fw-bold">صالح حتى</label>
        <input asp-for="ValidUntil" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <label asp-for="Status" class="form-label fw-bold">الحالة</label>
        <select asp-for="Status" asp-items="ViewBag.StatusList" class="form-select"></select>
    </div>
</div>

<!-- Items -->
<h6 class="fw-bold text-muted mb-3"><i class="fa-solid fa-list-ol me-2"></i> بنود العرض</h6>
<div class="table-responsive mb-2">
    <table class="table align-middle mb-0" id="itemsTable">
        <thead class="bg-light text-muted" style="font-size:0.85rem;">
            <tr>
                <th style="width:40px;">#</th>
                <th style="width:210px;">من الكتالوج</th>
                <th>الوصف <span class="text-danger">*</span></th>
                <th style="width:110px;">الوحدة</th>
                <th style="width:140px;">حالة المخزن</th>
                <th style="width:110px;">الكمية</th>
                <th style="width:140px;">سعر الوحدة</th>
                <th style="width:140px;">الإجمالي</th>
                <th style="width:50px;"></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr class="item-row">
                    <td class="row-no text-muted fw-bold">@(i + 1)</td>
                    <td><select name="Items[@i].ItemId" class="form-select form-select-sm catalog-select">@Html.Raw(CatalogSelect(Model.Items[i].ItemId))</select></td>
                    <td><input name="Items[@i].Description" value="@Model.Items[i].Description" class="form-control form-control-sm" placeholder="مثال: وحدات سفلية خشب MDF مع رخام" />
                        <input name="Items[@i].Notes" value="@Model.Items[i].Notes" class="form-control form-control-sm mt-1 text-muted" style="font-size:0.8rem;" placeholder="ملاحظة على البند (اختياري)" maxlength="250" /></td>
                    <td><input name="Items[@i].Unit" value="@Model.Items[i].Unit" class="form-control form-control-sm" list="units" /></td>
                    <td class="stock-status small"></td>
                    <td><input name="Items[@i].Quantity" value="@Model.Items[i].Quantity.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0.01" class="form-control form-control-sm qty" /></td>
                    <td><input name="Items[@i].UnitPrice" value="@Model.Items[i].UnitPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0" class="form-control form-control-sm price" /></td>
                    <td class="fw-bold line-total">0.00</td>
                    <td><button type="button" class="btn btn-sm btn-light border text-danger remove-row" title="حذف البند"><i class="fa-solid fa-xmark"></i></button></td>
                </tr>
            }
        </tbody>
    </table>
</div>
<datalist id="units">
    <option value="قطعة"></option>
    <option value="متر طولي"></option>
    <option value="متر مربع"></option>
    <option value="وحدة"></option>
    <option value="طقم"></option>
    <option value="خدمة"></option>
</datalist>
<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <button type="button" class="btn btn-sm btn-outline-primary fw-bold" id="addRow">
        <i class="fa-solid fa-plus me-1"></i> إضافة بند
    </button>
    <span id="mergeFeedback" class="small text-success fw-bold d-none" role="status" aria-live="polite"></span>
</div>
<div id="stockWarningBanner" class="alert alert-warning border-0 rounded-3 small d-none mb-4" role="status">
    <i class="fa-solid fa-triangle-exclamation me-1"></i>
    <span id="stockWarningText"></span>
</div>

<!-- Totals -->
<div class="row g-4">
    <div class="col-12 col-lg-7">
        <label asp-for="Notes" class="form-label fw-bold">ملاحظات وشروط العرض</label>
        <textarea asp-for="Notes" class="form-control mb-3" rows="5" placeholder="مدة التنفيذ، طريقة الدفع (مثلاً 50% مقدم)، الضمان، ما لا يشمله العرض..."></textarea>

        <div class="border rounded-3 p-3 bg-light">
            <label class="form-label fw-bold"><i class="fa-solid fa-images text-primary me-1"></i> صور التصميم (3D) والمخططات (يمكن اختيار أكثر من صورة)</label>
            <input type="file" name="designFiles" multiple accept=".jpg,.jpeg,.png,.webp,.pdf" class="form-control form-control-sm" />
            <small class="text-muted d-block mt-1">تُحفظ الصور داخل مجلد المشروع <code>wwwroot/pic</code> (الأنواع المسموحة: JPG, PNG, WEBP, PDF).</small>

            @{
                var quotePics = ViewBag.Pics as List<string> ?? new();
            }
            @if (quotePics.Any())
            {
                <div class="mt-3">
                    <span class="small fw-bold text-muted d-block mb-2">صور التصميم المرفقة حالياً (@quotePics.Count)</span>
                    <div class="row g-2">
                        @foreach (var pic in quotePics)
                        {
                            var isPdf = pic.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                            <div class="col-6 col-sm-4">
                                <div class="border rounded-3 p-2 bg-white h-100 d-flex flex-column justify-content-between">
                                    <a href="@pic" target="_blank" class="text-decoration-none text-center d-block mb-1">
                                        @if (isPdf)
                                        {
                                            <div class="py-3 text-danger"><i class="fa-solid fa-file-pdf fa-2x"></i><div class="small mt-1 text-dark">مخطط PDF</div></div>
                                        }
                                        else
                                        {
                                            <img src="@pic" alt="صورة التصميم" class="img-fluid rounded-2" style="max-height:110px; object-fit:cover; width:100%;" />
                                        }
                                    </a>
                                    <div class="form-check small mt-1">
                                        <input class="form-check-input" type="checkbox" name="removePics" value="@pic" id="rmq-@pic.GetHashCode()" />
                                        <label class="form-check-label text-danger fw-bold" for="rmq-@pic.GetHashCode()">حذف</label>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-12 col-lg-5">
        <div class="bg-light rounded-3 p-3">
            <div class="d-flex justify-content-between mb-2">
                <span class="fw-bold text-muted">المجموع</span>
                <span class="fw-bold" id="subtotal">0.00</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                <label asp-for="DiscountPercent" class="fw-bold text-muted mb-0">نسبة الخصم</label>
                <div class="input-group input-group-sm" style="max-width:130px;">
                    <input asp-for="DiscountPercent" type="number" step="0.01" min="0" max="100" class="form-control" id="discountPercent" />
                    <span class="input-group-text">%</span>
                </div>
                <span class="fw-bold text-danger" id="discountAmount">0.00</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                <label asp-for="Tax" class="fw-bold text-muted mb-0">ضريبة / رسوم إضافية</label>
                <input asp-for="Tax" type="number" step="0.01" min="0" class="form-control form-control-sm" style="max-width:130px;" id="tax" />
            </div>
            <hr />
            <div class="d-flex justify-content-between fs-5">
                <span class="fw-bold">الإجمالي النهائي</span>
                <span class="fw-extrabold text-primary" id="grandTotal">0.00</span>
            </div>
        </div>
    </div>
</div>

<template id="rowTemplate">
    <tr class="item-row">
        <td class="row-no text-muted fw-bold"></td>
        <td><select data-field="ItemId" class="form-select form-select-sm catalog-select">@Html.Raw(CatalogSelect(null))</select></td>
        <td><input data-field="Description" class="form-control form-control-sm" placeholder="وصف البند" />
            <input data-field="Notes" class="form-control form-control-sm mt-1 text-muted" style="font-size:0.8rem;" placeholder="ملاحظة على البند (اختياري)" maxlength="250" /></td>
        <td><input data-field="Unit" value="قطعة" class="form-control form-control-sm" list="units" /></td>
        <td class="stock-status small"></td>
        <td><input data-field="Quantity" value="1" type="number" step="0.01" min="0.01" class="form-control form-control-sm qty" /></td>
        <td><input data-field="UnitPrice" value="0" type="number" step="0.01" min="0" class="form-control form-control-sm price" /></td>
        <td class="fw-bold line-total">0.00</td>
        <td><button type="button" class="btn btn-sm btn-light border text-danger remove-row" title="حذف البند"><i class="fa-solid fa-xmark"></i></button></td>
    </tr>
</template>

<script>
    (function () {
        const tbody = document.querySelector('#itemsTable tbody');
        const addBtn = document.getElementById('addRow');
        const mergeFeedback = document.getElementById('mergeFeedback');
        const fmt = n => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const num = el => parseFloat(el?.value) || 0;
        let mergeFeedbackTimer = null;

        // يعيد ترقيم الصفوف وأسماء الحقول Items[0..n] حتى يربطها MVC بشكل صحيح
        function renumber() {
            tbody.querySelectorAll('tr.item-row').forEach((tr, i) => {
                tr.querySelector('.row-no').textContent = i + 1;
                tr.querySelectorAll('input:not(.ks-combobox-input), select').forEach(input => {
                    const field = input.dataset.field || input.name.replace(/^Items\[\d+\]\./, '');
                    input.dataset.field = field;
                    input.name = `Items[${i}].${field}`;
                });
            });
        }

        function makeBadge(cls, iconCls, text) {
            const span = document.createElement('span');
            span.className = 'badge ' + cls;
            if (iconCls) {
                const icon = document.createElement('i');
                icon.className = iconCls + ' me-1';
                span.appendChild(icon);
            }
            span.appendChild(document.createTextNode(text));
            return span;
        }

        function syncPriceCost(tr) {
            const sel = tr.querySelector('.catalog-select');
            const priceInput = tr.querySelector('.price');
            const stockCell = tr.querySelector('.stock-status');
            if (!priceInput) return;
            const opt = sel?.selectedOptions[0];
            const cost = parseFloat(opt?.dataset?.cost) || 0;
            priceInput.min = cost > 0 ? String(cost) : '0';
            const val = parseFloat(priceInput.value) || 0;
            priceInput.classList.toggle('is-invalid', Boolean(opt?.value) && cost > 0 && val < cost);

            if (!stockCell) return;
            stockCell.replaceChildren();
            if (!opt || !opt.value) {
                const dash = document.createElement('span');
                dash.className = 'text-muted';
                dash.textContent = '—';
                stockCell.appendChild(dash);
                return;
            }

            const type = opt.dataset.type;
            if (type === 'Finished') {
                stockCell.appendChild(makeBadge('bg-success-subtle text-success', null, 'تفصيل / خدمة'));
                return;
            }

            if (type === 'Raw') {
                const balance = parseFloat(opt.dataset.balance) || 0;
                const qty = parseFloat(tr.querySelector('.qty')?.value) || 0;
                const fmtNum = n => Number(n.toFixed(2));
                if (balance <= 0) {
                    stockCell.appendChild(makeBadge('bg-danger-subtle text-danger', 'fa-solid fa-triangle-exclamation', 'غير متوفر (0)'));
                    if (cost <= 0) {
                        const note = document.createElement('small');
                        note.className = 'd-block text-danger';
                        note.style.fontSize = '0.72rem';
                        note.textContent = 'لم يُشترَ بعد — تأكد من السعر';
                        stockCell.appendChild(note);
                    }
                } else if (qty > balance) {
                    stockCell.appendChild(makeBadge('bg-warning-subtle text-warning-emphasis', 'fa-solid fa-circle-exclamation', `متوفر ${fmtNum(balance)} (نقص ${fmtNum(qty - balance)})`));
                } else {
                    stockCell.appendChild(makeBadge('bg-success-subtle text-success', 'fa-solid fa-check', `متوفر (${fmtNum(balance)})`));
                }
            }
        }

        function updateStockWarningBanner() {
            const banner = document.getElementById('stockWarningBanner');
            const textEl = document.getElementById('stockWarningText');
            if (!banner || !textEl) return;

            const shortages = [];
            tbody.querySelectorAll('tr.item-row').forEach(tr => {
                const opt = tr.querySelector('.catalog-select')?.selectedOptions[0];
                if (!opt || !opt.value || opt.dataset.type !== 'Raw') return;
                const balance = parseFloat(opt.dataset.balance) || 0;
                const qty = parseFloat(tr.querySelector('.qty')?.value) || 0;
                if (balance <= 0 || qty > balance) {
                    const name = opt.dataset.name || opt.textContent.trim();
                    if (!shortages.includes(name)) shortages.push(name);
                }
            });

            if (shortages.length > 0) {
                textEl.textContent = `تنبيه مخزون: الأصناف التالية غير متوفرة أو رصيدها لا يكفي الكمية المطلوبة (${shortages.join('، ')}). تأكد من سعر المورد الحالي قبل اعتماد العرض، وسيُحوَّل النقص لطلب شراء عند التنفيذ.`;
                banner.classList.remove('d-none');
            } else {
                banner.classList.add('d-none');
                textEl.textContent = '';
            }
        }

        function recalc() {
            let subtotal = 0;
            tbody.querySelectorAll('tr.item-row').forEach(tr => {
                const line = num(tr.querySelector('.qty')) * num(tr.querySelector('.price'));
                tr.querySelector('.line-total').textContent = fmt(line);
                subtotal += line;
            });
            const discount = Math.round(subtotal * num(document.getElementById('discountPercent'))) / 100;
            const total = subtotal - discount + num(document.getElementById('tax'));
            document.getElementById('subtotal').textContent = fmt(subtotal);
            document.getElementById('discountAmount').textContent = '- ' + fmt(discount);
            document.getElementById('grandTotal').textContent = fmt(total);
            updateStockWarningBanner();
        }

        function showMergeFeedback(itemName, rowNo, nextQty) {
            if (!mergeFeedback) return;
            mergeFeedback.replaceChildren();
            const icon = document.createElement('i');
            icon.className = 'fa-solid fa-layer-group me-1';
            mergeFeedback.appendChild(icon);
            mergeFeedback.appendChild(
                document.createTextNode(`تمت زيادة كمية «${itemName}» في الصف #${rowNo} إلى ${nextQty} دون إضافة صف جديد`)
            );
            mergeFeedback.classList.remove('d-none');
            clearTimeout(mergeFeedbackTimer);
            mergeFeedbackTimer = setTimeout(() => mergeFeedback.classList.add('d-none'), 4000);
        }

        function flashRow(tr) {
            clearTimeout(tr._flashTimer);
            tr.classList.add('table-success');
            tr._flashTimer = setTimeout(() => tr.classList.remove('table-success'), 1800);
        }

        addBtn.addEventListener('click', () => {
            tbody.appendChild(document.getElementById('rowTemplate').content.cloneNode(true));
            renumber();
            syncPriceCost(tbody.lastElementChild);
            recalc();
            tbody.lastElementChild.querySelector('input').focus();
        });

        tbody.addEventListener('click', e => {
            const btn = e.target.closest('.remove-row');
            if (!btn) return;
            const tr = btn.closest('tr');
            if (tbody.querySelectorAll('tr.item-row').length > 1) {
                tr.remove();
            } else {
                const sel = tr.querySelector('.catalog-select');
                if (sel && sel.value) {
                    sel.value = '';
                    sel.dispatchEvent(new Event('change', { bubbles: true }));
                }
                tr.querySelector('[data-field="Description"]').value = '';
                tr.querySelector('[data-field="Notes"]').value = '';
                tr.querySelector('[data-field="Unit"]').value = 'قطعة';
                tr.querySelector('.qty').value = '1';
                tr.querySelector('.price').value = '0';
                syncPriceCost(tr);
            }
            renumber();
            recalc();
        });

        // اختيار صنف موجود مسبقاً يزيد كميته في أول صف بدلاً من إضافة صف جديد
        tbody.addEventListener('change', e => {
            if (!e.target.matches('.catalog-select')) return;
            const tr = e.target.closest('tr');
            const opt = e.target.selectedOptions[0];
            if (!opt || !opt.value) {
                syncPriceCost(tr);
                updateStockWarningBanner();
                return;
            }

            const rows = Array.from(tbody.querySelectorAll('tr.item-row'));
            const firstMatch = rows.find(r => r !== tr && r.querySelector('.catalog-select')?.value === opt.value);

            if (firstMatch) {
                const addRaw = parseFloat(tr.querySelector('.qty')?.value);
                const addQty = Number.isFinite(addRaw) && addRaw > 0 ? addRaw : 1;
                const firstQtyInput = firstMatch.querySelector('.qty');
                const currentQty = parseFloat(firstQtyInput?.value) || 0;
                const nextQty = Math.round((currentQty + addQty) * 100) / 100;
                if (firstQtyInput) {
                    firstQtyInput.value = String(nextQty);
                }

                const firstDesc = firstMatch.querySelector('[data-field="Description"]');
                if (firstDesc && !firstDesc.value.trim()) {
                    firstDesc.value = opt.dataset.name || '';
                    firstMatch.querySelector('[data-field="Unit"]').value = opt.dataset.unit || 'قطعة';
                    firstMatch.querySelector('.price').value = opt.dataset.price || '0';
                }
                syncPriceCost(firstMatch);

                const newNotes = (tr.querySelector('[data-field="Notes"]')?.value || '').trim();
                const firstNotesInput = firstMatch.querySelector('[data-field="Notes"]');
                if (newNotes && firstNotesInput) {
                    const existingNotes = firstNotesInput.value.trim();
                    if (!existingNotes) {
                        firstNotesInput.value = newNotes;
                    } else if (existingNotes !== newNotes && !existingNotes.includes(newNotes)) {
                        firstNotesInput.value = `${existingNotes} | ${newNotes}`.slice(0, 250);
                    }
                }

                e.target._ksSearchable?.destroy();
                tr.remove();
                renumber();
                recalc();
                flashRow(firstMatch);
                showMergeFeedback(opt.dataset.name || opt.textContent.trim(), firstMatch.querySelector('.row-no').textContent, nextQty);
                addBtn.focus();
                return;
            }

            // اختيار صنف من الكتالوج يملأ الوصف والوحدة وسعر البيع (ويبقى قابلاً للتعديل فوق حد التكلفة)
            tr.querySelector('[data-field="Description"]').value = opt.dataset.name;
            tr.querySelector('[data-field="Unit"]').value = opt.dataset.unit;
            tr.querySelector('.price').value = opt.dataset.price;
            syncPriceCost(tr);
            recalc();
        });

        document.addEventListener('input', e => {
            if (e.target.matches('.price, .qty')) {
                syncPriceCost(e.target.closest('tr'));
            }
            if (e.target.matches('.qty, .price, #discountPercent, #tax')) recalc();
        });

        renumber();
        tbody.querySelectorAll('tr.item-row').forEach(syncPriceCost);
        recalc();
    })();
</script>
