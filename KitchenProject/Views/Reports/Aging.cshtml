@model List<AgingRow>
@{
    ViewData["Title"] = "أعمار الديون";
    Layout = "_DashboardLayout";
    string kind = ViewBag.Kind ?? "customers";
    DateTime asOf = ViewBag.AsOf;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> أعمار الديون والمتأخرات</h2>
        <p class="text-muted mb-0">تصنيف المبالغ المستحقة حسب عمر المستند (0-30، 31-60، 61-90، أكثر من 90 يوماً)</p>
    </div>
    <a asp-action="AgingPrint" asp-route-kind="@kind" asp-route-asOf="@asOf.ToString("yyyy-MM-dd")" target="_blank" class="btn btn-primary-custom"><i class="fa-solid fa-print me-1"></i> طباعة (A4)</a>
</div>

<div class="custom-card mb-4 p-3">
    <form method="get" asp-action="Aging" class="row g-3 align-items-end">
        <div class="col-6 col-md-3">
            <label class="form-label small fw-bold text-muted">الجهة</label>
            <select name="kind" class="form-select">
                <option value="customers" selected="@(kind == "customers")">ذمم العملاء (العقود)</option>
                <option value="suppliers" selected="@(kind == "suppliers")">ذمم الموردين (المشتريات)</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small fw-bold text-muted">كما في تاريخ</label>
            <input type="date" name="asOf" value="@asOf.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-12 col-md-3">
            <button type="submit" class="btn btn-primary fw-bold rounded-3"><i class="fa-solid fa-search me-1"></i> عرض</button>
        </div>
    </form>
</div>

<div class="custom-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted" style="font-size:0.85rem;">
                <tr>
                    <th class="ps-4">@(kind == "suppliers" ? "المورد" : "العميل")</th>
                    <th>المستند</th>
                    <th>التاريخ</th>
                    <th>العمر (يوم)</th>
                    <th>0 - 30</th>
                    <th>31 - 60</th>
                    <th>61 - 90</th>
                    <th>+90</th>
                    <th class="pe-4">الإجمالي المتبقي</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold">@r.PartyName <small class="d-block text-muted font-monospace">@r.PartyNo</small></td>
                        <td class="font-monospace small">@r.DocNo</td>
                        <td class="small text-muted">@r.DocDate.ToString("yyyy/MM/dd")</td>
                        <td><span class="badge @(r.AgeDays > 90 ? "bg-danger-subtle text-danger" : r.AgeDays > 30 ? "bg-warning-subtle text-warning-emphasis" : "bg-light text-dark border")">@r.AgeDays</span></td>
                        <td>@(r.Bucket0To30 == 0 ? "-" : r.Bucket0To30.ToString("N2"))</td>
                        <td>@(r.Bucket31To60 == 0 ? "-" : r.Bucket31To60.ToString("N2"))</td>
                        <td>@(r.Bucket61To90 == 0 ? "-" : r.Bucket61To90.ToString("N2"))</td>
                        <td class="@(r.BucketOver90 > 0 ? "text-danger fw-bold" : "")">@(r.BucketOver90 == 0 ? "-" : r.BucketOver90.ToString("N2"))</td>
                        <td class="pe-4 fw-bold">@r.Remaining.ToString("N2")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center py-5 text-muted">لا توجد ذمم متأخرة</td></tr>
                }
            </tbody>
            <tfoot class="bg-light fw-bold">
                <tr>
                    <td colspan="4" class="ps-4">الإجمالي (@Model.Count مستند)</td>
                    <td>@Model.Sum(r => r.Bucket0To30).ToString("N2")</td>
                    <td>@Model.Sum(r => r.Bucket31To60).ToString("N2")</td>
                    <td>@Model.Sum(r => r.Bucket61To90).ToString("N2")</td>
                    <td class="text-danger">@Model.Sum(r => r.BucketOver90).ToString("N2")</td>
                    <td class="pe-4">@Model.Sum(r => r.Remaining).ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
