@model KitchenProject.Models.Entities.Item

<div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

<h6 class="fw-bold text-muted mb-3"><i class="fa-solid fa-circle-info me-2"></i> بيانات الصنف</h6>
<div class="row g-4 mb-4">
    <div class="col-12 col-md-3">
        <label asp-for="Type" class="form-label fw-bold">النوع <span class="text-danger">*</span></label>
        <select asp-for="Type" asp-items="ViewBag.TypeList" class="form-select" id="itemType"></select>
        <span asp-validation-for="Type" class="text-danger small"></span>
    </div>
    <div class="col-12 col-md-3">
        <label asp-for="Code" class="form-label fw-bold">الكود <span class="text-danger">*</span></label>
        <input asp-for="Code" class="form-control fw-bold text-primary font-monospace" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Name" class="form-label fw-bold">اسم الصنف <span class="text-danger">*</span></label>
        <input asp-for="Name" class="form-control" placeholder="مثال: لوح MDF 18 مم أبيض" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6 finished-only">
        <label asp-for="ItemGroupId" class="form-label fw-bold">البند <span class="text-danger">*</span></label>
        <select asp-for="ItemGroupId" asp-items="ViewBag.Groups" class="form-select">
            <option value="">-- اختر البند --</option>
        </select>
        <span asp-validation-for="ItemGroupId" class="text-danger small"></span>
        <small class="text-muted d-block mt-1">البنود للأصناف الجاهزة فقط. <a asp-controller="ItemGroups" asp-action="Index" target="_blank">تعديل أسماء البنود</a></small>
    </div>
    <div class="col-12 col-md-3">
        <label asp-for="Unit" class="form-label fw-bold">الوحدة</label>
        <input asp-for="Unit" class="form-control" list="units" />
        <datalist id="units">
            <option value="قطعة"></option>
            <option value="لوح"></option>
            <option value="متر طولي"></option>
            <option value="متر مربع"></option>
            <option value="علبة"></option>
            <option value="كرتونة"></option>
            <option value="لتر"></option>
            <option value="كيلو"></option>
            <option value="طقم"></option>
            <option value="وحدة"></option>
        </datalist>
    </div>
    <div class="col-12 col-md-3 d-flex align-items-end">
        <div class="form-check form-switch mb-2">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="IsActive" class="form-check-label fw-bold">صنف فعال</label>
        </div>
    </div>
</div>

<h6 class="fw-bold text-muted mb-3"><i class="fa-solid fa-tags me-2"></i> الأسعار والمخزون</h6>
<div class="row g-4 mb-4">
    <div class="col-12 col-md-4 raw-only">
        <label asp-for="PurchasePrice" class="form-label fw-bold">سعر الشراء</label>
        <input asp-for="PurchasePrice" type="number" step="0.01" min="0" class="form-control" />
        <small class="text-muted">يتحدث تلقائياً مع كل فاتورة شراء مستلمة</small>
        <span asp-validation-for="PurchasePrice" class="text-danger small d-block"></span>
    </div>
    <div class="col-12 col-md-4 raw-only">
        <label asp-for="MinQuantity" class="form-label fw-bold">حد إعادة الطلب</label>
        <input asp-for="MinQuantity" type="number" step="0.01" min="0" class="form-control" />
        <small class="text-muted">تنبيه عندما يصل الرصيد لهذه الكمية (0 = بدون تنبيه)</small>
        <span asp-validation-for="MinQuantity" class="text-danger small d-block"></span>
    </div>
    <div class="col-12 col-md-4 finished-only">
        <label asp-for="SalePrice" class="form-label fw-bold">سعر البيع</label>
        <input asp-for="SalePrice" type="number" step="0.01" min="0" class="form-control" />
        <small class="text-muted">السعر الافتراضي عند اختياره في عرض السعر (يمكن تعديله في العرض)</small>
        <span asp-validation-for="SalePrice" class="text-danger small d-block"></span>
    </div>
</div>

<div class="mb-2">
    <label asp-for="Notes" class="form-label fw-bold">ملاحظات / مواصفات</label>
    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="المقاس، اللون، بلد المنشأ، المورد المعتاد..."></textarea>
</div>

<script>
    (function () {
        const type = document.getElementById('itemType');
        function toggle() {
            const finished = type.value === '@ItemType.Finished';
            document.querySelectorAll('.finished-only').forEach(el => el.classList.toggle('d-none', !finished));
            document.querySelectorAll('.raw-only').forEach(el => el.classList.toggle('d-none', finished));
        }
        type.addEventListener('change', toggle);
        toggle();
    })();
</script>
