@inject KitchenProject.Classes.LookupService Lookup
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة التحكم | بن قسومة</title>
    <link rel="icon" type="image/png" href="~/images/brand/logo-mark.png" />

    <!-- Bootstrap 5 RTL CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <!-- Google Fonts - Cairo & Tajawal -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Custom Dashboard Styles -->
    <style>
        :root {
            --sidebar-width: 270px;
            --topbar-height: 70px;
            --primary-gradient: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            --accent-blue: #2563eb;
            --accent-emerald: #10b981;
            --accent-amber: #f59e0b;
            --accent-rose: #f43f5e;
            --bg-canvas: #f1f5f9;
            --card-border-radius: 14px;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: var(--bg-canvas);
            color: #1e293b;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }

        /* Sidebar Styling */
        #sidebar {
            width: var(--sidebar-width);
            background: var(--primary-gradient);
            position: fixed;
            top: 0;
            bottom: 0;
            right: 0;
            z-index: 1040;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: -4px 0 25px rgba(0, 0, 0, 0.15);
            display: flex;
            flex-direction: column;
        }

        #sidebar.collapsed {
            right: calc(-1 * var(--sidebar-width));
        }

        .sidebar-brand {
            height: var(--topbar-height);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            color: #ffffff;
            font-weight: 800;
            font-size: 1.25rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            text-decoration: none;
        }

        .sidebar-brand .brand-mark {
            background: #fff;
            border-radius: 10px;
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-left: 0.75rem;
            flex-shrink: 0;
        }

        .sidebar-brand .brand-mark img {
            height: 28px;
        }

        .sidebar-brand i {
            color: var(--accent-blue);
            margin-left: 0.75rem;
            font-size: 1.5rem;
        }

        .sidebar-menu {
            padding: 1.25rem 0.75rem;
            overflow-y: auto;
            flex: 1;
        }

        .sidebar-heading {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            font-weight: 700;
            padding: 0.75rem 1rem 0.35rem;
        }

        .nav-sidebar .nav-link {
            color: #94a3b8;
            padding: 0.75rem 1rem;
            font-weight: 600;
            font-size: 0.95rem;
            border-radius: 10px;
            margin-bottom: 0.25rem;
            display: flex;
            align-items: center;
            transition: all 0.2s ease;
        }

        .nav-sidebar .nav-link i {
            width: 24px;
            font-size: 1.1rem;
            margin-left: 0.75rem;
            transition: transform 0.2s ease;
        }

        .nav-sidebar .nav-link:hover {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.07);
            transform: translateX(-3px);
        }

        .nav-sidebar .nav-link.active {
            color: #ffffff;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.35);
        }

        .nav-sidebar .nav-link .badge {
            margin-right: auto;
            margin-left: 0;
            font-weight: 700;
        }

        .sidebar-footer {
            padding: 1rem 1.25rem;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            color: #94a3b8;
            font-size: 0.85rem;
        }

        /* Topbar Styling */
        #topbar {
            height: var(--topbar-height);
            position: fixed;
            top: 0;
            left: 0;
            right: var(--sidebar-width);
            background-color: #ffffff;
            z-index: 1030;
            transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.03);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
        }

        #topbar.expanded {
            right: 0;
        }

        .btn-toggle-sidebar {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #334155;
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-toggle-sidebar:hover {
            background: #f1f5f9;
            color: var(--accent-blue);
        }

        /* Main Content Wrapper */
        #content-wrapper {
            margin-right: var(--sidebar-width);
            margin-top: var(--topbar-height);
            padding: 2rem 1.75rem 3rem;
            transition: margin-right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            min-height: calc(100vh - var(--topbar-height));
        }

        #content-wrapper.expanded {
            margin-right: 0;
        }

        /* Custom Cards & UI Elements */
        .custom-card {
            background-color: #ffffff;
            border-radius: var(--card-border-radius);
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
            transition: all 0.25s ease;
        }

        .custom-card:hover {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
        }

        .card-header-custom {
            background-color: transparent;
            border-bottom: 1px solid #f1f5f9;
            padding: 1.25rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .page-header-title {
            font-weight: 800;
            font-size: 1.5rem;
            color: #0f172a;
        }

        .btn-primary-custom {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            border: none;
            color: white;
            font-weight: 700;
            padding: 0.6rem 1.35rem;
            border-radius: 10px;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
            transition: all 0.25s ease;
        }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);
            color: white;
        }

        /* Module Top Tabs Bar */
        .module-tabs-bar {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.45rem;
            margin-bottom: 1.5rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
            box-shadow: 0 2px 12px rgba(15, 23, 42, 0.03);
        }

        .module-tab-link {
            color: #475569;
            font-weight: 700;
            font-size: 0.88rem;
            padding: 0.5rem 0.95rem;
            border-radius: 8px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            transition: all 0.2s ease;
        }

        .module-tab-link:hover {
            background-color: #f1f5f9;
            color: #0f172a;
        }

        .module-tab-link.active {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: #ffffff;
            box-shadow: 0 3px 10px rgba(37, 99, 235, 0.25);
        }

        /* Backdrop overlay for mobile */
        #sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background-color: rgba(15, 23, 42, 0.5);
            backdrop-filter: blur(4px);
            z-index: 1035;
        }

        /* Responsive Breakpoints */
        @@media (max-width: 991.98px) {
            #sidebar {
                right: calc(-1 * var(--sidebar-width));
            }

            #sidebar.show-mobile {
                right: 0;
            }

            #topbar {
                right: 0 !important;
            }

            #content-wrapper {
                margin-right: 0 !important;
                padding: 1.25rem 1rem;
            }

            #sidebar-overlay.active {
                display: block;
            }
        }

        @@media print {
            #sidebar,
            #topbar,
            #sidebar-overlay,
            .d-print-none {
                display: none !important;
            }

            body {
                background-color: #ffffff !important;
                font-size: 0.85rem;
            }

            #content-wrapper {
                margin: 0 !important;
                padding: 0 !important;
                min-height: 0 !important;
            }

            .custom-card {
                box-shadow: none !important;
                border: 1px solid #cbd5e1 !important;
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>

    <!-- Sidebar Overlay for Mobile -->
    <div id="sidebar-overlay"></div>

    <!-- Main Sidebar -->
    <aside id="sidebar">
        <a href="@Url.Action("Index", "Home")" class="sidebar-brand">
            <span class="brand-mark"><img src="~/images/brand/logo-mark.png" alt="Bin Gsoma" /></span>
            <span>بن قسومة <small class="d-block fw-normal opacity-75" style="font-size:0.7rem;">نظام إدارة المطابخ</small></span>
        </a>

        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
            var rawActivePage = ViewBag.ActivePage as string;

            // تمييز التبويب الفرعي بدقة حتى لو اشترك مع شاشته الأم في ViewBag.ActivePage
            var effectiveActiveKey = currentController.Equals("ItemGroups", StringComparison.OrdinalIgnoreCase)
                ? "ItemGroups"
                : (currentController.Equals("Stock", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Movements", StringComparison.OrdinalIgnoreCase))
                    ? "StockMovements"
                    : rawActivePage;

            // وحدات النظام المدمجة (10 وحدات أساسية في القائمة الجانبية، وتظهر شاشاتها الفرعية كتبويبات علوية)
            var modules = new (string Section, string Icon, string Label, (string Controller, string Action, string Icon, string Label, string Active)[] Tabs)[]
            {
                ("التشغيل والمشاريع", "fa-gauge-high", "لوحة التحكم", new[]
                {
                    ("Home", "Index", "fa-gauge-high", "لوحة التحكم", "Home")
                }),
                ("التشغيل والمشاريع", "fa-users", "إدارة العملاء", new[]
                {
                    ("Customers", "Index", "fa-users", "إدارة العملاء", "Customers")
                }),
                ("التشغيل والمشاريع", "fa-diagram-project", "المشاريع والتنفيذ", new[]
                {
                    ("Projects", "Index", "fa-diagram-project", "المشاريع والأوامر", "Projects"),
                    ("SiteVisits", "Index", "fa-ruler-combined", "المعاينة والمقاسات", "SiteVisits"),
                    ("Quotes", "Index", "fa-file-invoice-dollar", "التصاميم وعروض الأسعار", "Quotes"),
                    ("Contracts", "Index", "fa-file-contract", "إدارة العقود", "Contracts")
                }),
                ("المخازن والمشتريات", "fa-boxes-stacked", "الأصناف والبنود", new[]
                {
                    ("Items", "Index", "fa-boxes-stacked", "كتالوج الأصناف", "Items"),
                    ("ItemGroups", "Index", "fa-layer-group", "البنود A / B / C", "ItemGroups")
                }),
                ("المخازن والمشتريات", "fa-warehouse", "المخزن وطلبات المواد", new[]
                {
                    ("Stock", "Index", "fa-warehouse", "أرصدة المخزن", "Stock"),
                    ("MaterialRequests", "Index", "fa-clipboard-list", "طلبات المواد", "MaterialRequests"),
                    ("Stock", "Movements", "fa-right-left", "كشف الحركات", "StockMovements"),
                    ("Stock", "Stocktake", "fa-clipboard-check", "جرد وتسوية المخزن", "Stocktake"),
                    ("Warehouses", "Index", "fa-building", "الفروع والمخازن", "Warehouses")
                }),
                ("المخازن والمشتريات", "fa-cart-shopping", "المشتريات والموردين", new[]
                {
                    ("Purchases", "Index", "fa-cart-shopping", "فواتير الشراء", "Purchases"),
                    ("Suppliers", "Index", "fa-truck-field", "الموردين", "Suppliers")
                }),
                ("المالية والإدارة", "fa-wallet", "المالية والمصروفات", new[]
                {
                    ("Payments", "Index", "fa-wallet", "إيصالات القبض", "Payments"),
                    ("SupplierPayments", "Index", "fa-file-invoice-dollar", "صرف للموردين", "SupplierPayments"),
                    ("Expenses", "Index", "fa-money-bill-transfer", "المصروفات", "Expenses")
                }),
                ("المالية والإدارة", "fa-chart-line", "التقارير المالية", new[]
                {
                    ("Reports", "Profit", "fa-chart-line", "أرباح المشاريع", "Reports"),
                    ("Reports", "Transactions", "fa-right-left", "الحركات المالية", "Transactions"),
                    ("Reports", "Aging", "fa-clock-rotate-left", "أعمار الديون", "Aging")
                }),
                ("المالية والإدارة", "fa-book", "المحاسبة والدفاتر", new[]
                {
                    ("Accounting", "Index", "fa-book", "القيود اليومية", "Journal"),
                    ("Accounting", "Accounts", "fa-sitemap", "شجرة الحسابات", "Accounts"),
                    ("Accounting", "Ledger", "fa-book-open", "كشف حساب (أستاذ)", "Ledger"),
                    ("Accounting", "Cheques", "fa-money-check-dollar", "حافظة الصكوك", "Cheques"),
                    ("Accounting", "TrialBalance", "fa-scale-balanced", "ميزان المراجعة", "TrialBalance"),
                    ("Accounting", "IncomeStatement", "fa-file-invoice", "قائمة الدخل", "IncomeStatement"),
                    ("Accounting", "BalanceSheet", "fa-building-columns", "الميزانية العمومية", "BalanceSheet"),
                    ("Accounting", "OpeningBalances", "fa-flag-checkered", "الأرصدة الافتتاحية", "OpeningBalances"),
                    ("Accounting", "Periods", "fa-lock", "إقفال الفترات", "Periods")
                }),
                ("المالية والإدارة", "fa-sliders", "الإدارة والإعدادات", new[]
                {
                    ("Settings", "Index", "fa-sliders", "إعدادات النظام", "Settings"),
                    ("Users", "Index", "fa-user-shield", "المستخدمين والصلاحيات", "Users")
                })
            };

            bool IsTabActive((string Controller, string Action, string Icon, string Label, string Active) t) =>
                !string.IsNullOrEmpty(effectiveActiveKey)
                    ? string.Equals(effectiveActiveKey, t.Active, StringComparison.OrdinalIgnoreCase)
                    : (currentController.Equals(t.Controller, StringComparison.OrdinalIgnoreCase)
                       && currentAction.Equals(t.Action, StringComparison.OrdinalIgnoreCase));

            var visibleModules = modules
                .Select(m => new
                {
                    m.Section,
                    m.Icon,
                    m.Label,
                    AllowedTabs = m.Tabs.Where(t => AppRoles.CanAccess(User, t.Controller, t.Action)).ToList(),
                    IsActive = m.Tabs.Any(IsTabActive)
                })
                .Where(m => m.AllowedTabs.Count > 0)
                .ToList();

            var activeModuleTabs = visibleModules.FirstOrDefault(m => m.IsActive)?.AllowedTabs;
        }
        <div class="sidebar-menu">
            @foreach (var sectionGroup in visibleModules.GroupBy(m => m.Section))
            {
                <div class="sidebar-heading">@sectionGroup.Key</div>
                <ul class="nav nav-sidebar flex-column">
                    @foreach (var mod in sectionGroup)
                    {
                        var entry = mod.AllowedTabs[0];
                        <li class="nav-item">
                            <a class="nav-link @(mod.IsActive ? "active" : "")" href="@Url.Action(entry.Action, entry.Controller)">
                                <i class="fa-solid @mod.Icon"></i>
                                <span>@mod.Label</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>

    <!-- Top Navigation Bar -->
    <header id="topbar">
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn-toggle-sidebar" id="btnToggleSidebar" title="قائمة التحكم">
                <i class="fa-solid fa-bars-staggered"></i>
            </button>

            <form method="get" asp-controller="Projects" asp-action="Index" class="d-none d-md-flex align-items-center position-relative m-0" style="width: 300px;" data-name-search-form="true">
                <input type="text" name="searchString" class="form-control rounded-pill bg-light border-0 ps-5 pe-3" placeholder="بحث سريع باسم العميل أو المشروع..." autocomplete="off" style="height: 42px; font-size: 0.88rem;">
                <i class="fa-solid fa-magnifying-glass text-muted position-absolute start-0 ms-3 pointer-events-none"></i>
            </form>
        </div>

        <div class="d-flex align-items-center gap-3">
            <!-- Quick Add Menu -->
            <div class="dropdown">
                <button class="btn btn-primary-custom dropdown-toggle btn-sm py-2 px-3 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                    <i class="fa-solid fa-circle-plus"></i>
                    <span>إضافة جديدة</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2">
                    @if (AppRoles.CanAccess(User, "Customers", "Create")) { <li><a class="dropdown-item rounded-3 py-2" href="@Url.Action("Create", "Customers")"><i class="fa-solid fa-user-plus text-primary me-2"></i> عميل جديد</a></li> }
                    @if (AppRoles.CanAccess(User, "Projects", "Create")) { <li><a class="dropdown-item rounded-3 py-2" href="@Url.Action("Create", "Projects")"><i class="fa-solid fa-folder-plus text-success me-2"></i> مشروع جديد</a></li> }
                    @if (AppRoles.CanAccess(User, "SiteVisits", "Create")) { <li><a class="dropdown-item rounded-3 py-2" href="@Url.Action("Create", "SiteVisits")"><i class="fa-solid fa-ruler-vertical text-warning me-2"></i> موعد معاينة</a></li> }
                    <li><hr class="dropdown-divider"></li>
                    @if (AppRoles.CanAccess(User, "Payments", "Create")) { <li><a class="dropdown-item rounded-3 py-2" href="@Url.Action("Create", "Payments")"><i class="fa-solid fa-hand-holding-dollar text-success me-2"></i> إيصال قبض</a></li> }
                    @if (AppRoles.CanAccess(User, "SupplierPayments", "Create")) { <li><a class="dropdown-item rounded-3 py-2" href="@Url.Action("Create", "SupplierPayments")"><i class="fa-solid fa-file-invoice-dollar text-danger me-2"></i> إيصال صرف لمورد</a></li> }
                    @if (AppRoles.CanAccess(User, "Purchases", "Create")) { <li><a class="dropdown-item rounded-3 py-2" href="@Url.Action("Create", "Purchases")"><i class="fa-solid fa-cart-plus text-primary me-2"></i> فاتورة شراء</a></li> }
                    @if (AppRoles.CanAccess(User, "Stock", "Issue")) { <li><a class="dropdown-item rounded-3 py-2" href="@Url.Action("Issue", "Stock")"><i class="fa-solid fa-dolly text-danger me-2"></i> صرف خامات</a></li> }
                </ul>
            </div>

            <!-- Notifications Button -->
            @{
                var appAlerts = await Lookup.GetAlertsAsync(User);
            }
            <div class="dropdown">
                <button class="btn btn-light position-relative rounded-circle p-2" style="width:42px; height:42px;" data-bs-toggle="dropdown" title="التنبيهات الإدارية">
                    <i class="fa-solid fa-bell @(appAlerts.Count > 0 ? "text-danger" : "text-secondary")"></i>
                    @if (appAlerts.Count > 0)
                    {
                        <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-danger border border-light" style="font-size:0.68rem;">
                            @appAlerts.Count
                            <span class="visually-hidden">تنبيهات</span>
                        </span>
                    }
                </button>
                <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-3 mt-2" style="width:340px; max-height:420px; overflow-y:auto;">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                        <h6 class="fw-bold mb-0">التنبيهات والمتابعة</h6>
                        @if (appAlerts.Count > 0)
                        {
                            <span class="badge bg-danger-subtle text-danger rounded-pill">@appAlerts.Count</span>
                        }
                    </div>
                    @if (appAlerts.Count > 0)
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var alert in appAlerts)
                            {
                                <a href="@Url.Action(alert.Action, alert.Controller, alert.RouteValues)" class="text-decoration-none p-2 rounded-3 bg-light d-flex align-items-start gap-2 border-start border-3 border-primary">
                                    <i class="fa-solid @alert.Icon mt-1 fs-5"></i>
                                    <div>
                                        <div class="fw-bold text-dark small">@alert.Title</div>
                                        <div class="text-muted" style="font-size:0.75rem;">@alert.Subtitle</div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0 text-center py-3">
                            <i class="fa-solid fa-circle-check text-success d-block fs-4 mb-1"></i>
                            لا توجد تنبيهات معلقة حالياً
                        </p>
                    }
                </div>
            </div>

            <!-- User Menu -->
            @{
                var displayName = User.DisplayName();
            }
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark" data-bs-toggle="dropdown">
                    <div class="bg-primary text-white fw-bold rounded-circle d-flex align-items-center justify-content-center me-2" style="width:42px; height:42px;">
                        @(displayName.Length > 0 ? displayName[0] : '?')
                    </div>
                    <div class="d-none d-sm-block">
                        <span class="fw-bold d-block lh-1 fs-6">@displayName</span>
                        <small class="text-muted" style="font-size:0.75rem;">@User.RoleName()</small>
                    </div>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2">
                    <li><a class="dropdown-item rounded-3 py-2" href="@Url.Action("ChangePassword", "Account")"><i class="fa-solid fa-key me-2 text-primary"></i> حسابي وكلمة المرور</a></li>
                    @if (AppRoles.CanAccess(User, "Users"))
                    {
                        <li><a class="dropdown-item rounded-3 py-2" href="@Url.Action("Index", "Users")"><i class="fa-solid fa-user-shield me-2 text-secondary"></i> المستخدمين</a></li>
                    }
                    @if (AppRoles.CanAccess(User, "Settings"))
                    {
                        <li><a class="dropdown-item rounded-3 py-2" href="@Url.Action("Index", "Settings")"><i class="fa-solid fa-sliders me-2 text-secondary"></i> إعدادات النظام</a></li>
                    }
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item rounded-3 py-2 text-danger"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i> تسجيل الخروج</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Main Workspace Content Area -->
    <main id="content-wrapper">
        @if (activeModuleTabs != null && activeModuleTabs.Count > 1)
        {
            <nav class="module-tabs-bar d-print-none" aria-label="شاشات القسم">
                @foreach (var tab in activeModuleTabs)
                {
                    <a class="module-tab-link @(IsTabActive(tab) ? "active" : "")" href="@Url.Action(tab.Action, tab.Controller)">
                        <i class="fa-solid @tab.Icon"></i>
                        <span>@tab.Label</span>
                    </a>
                }
            </nav>
        }

        <!-- Toast / Alerts Section -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center" role="alert">
                <i class="fa-solid fa-circle-check fs-4 me-3 text-success"></i>
                <div>
                    <strong>تمت العملية بنجاح!</strong> @TempData["Success"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center" role="alert">
                <i class="fa-solid fa-circle-exclamation fs-4 me-3 text-danger"></i>
                <div>
                    <strong>خطأ:</strong> @TempData["Error"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Sidebar Toggle Script -->
    <script>
        $(document).ready(function () {
            const $sidebar = $('#sidebar');
            const $topbar = $('#topbar');
            const $wrapper = $('#content-wrapper');
            const $overlay = $('#sidebar-overlay');

            $('#btnToggleSidebar').on('click', function () {
                if ($(window).width() < 992) {
                    $sidebar.toggleClass('show-mobile');
                    $overlay.toggleClass('active');
                } else {
                    $sidebar.toggleClass('collapsed');
                    $topbar.toggleClass('expanded');
                    $wrapper.toggleClass('expanded');
                }
            });

            $overlay.on('click', function () {
                $sidebar.removeClass('show-mobile');
                $overlay.removeClass('active');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


