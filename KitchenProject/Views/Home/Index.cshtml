@{
    ViewData["Title"] = "الرئيسية - مصنع المطابخ الإحترافي";
    Layout = "_Layout";
}

<!-- Hero Banner Section -->
<section class="py-5 bg-white border-bottom shadow-sm">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-7">
                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill mb-3">
                    <i class="fa-solid fa-star me-1"></i> النظام الإداري المتكامل للمطابخ
                </span>
                <h1 class="display-4 fw-extrabold text-dark mb-3 lh-sm">
                    مصنع وتفصيل المطابخ <span class="text-primary">الإحترافي</span>
                </h1>
                <p class="lead text-secondary mb-4">
                    إدارة شاملة لكافة مراحل تصنيع وتنفيذ المطابخ من المعاينة والرفع الميداني والتصميم، وحتى العقود والمشتريات والمخازن والتركيبات.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Customers" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow">
                        <i class="fa-solid fa-gauge-high me-2"></i> الدخول للوحة التحكم
                    </a>
                    <a href="#services" class="btn btn-outline-secondary btn-lg rounded-pill px-4 fw-bold">
                        <i class="fa-solid fa-circle-info me-2"></i> اكتشف مميزات النظام
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center">
                <div class="position-relative p-4 rounded-4 bg-light border shadow-sm">
                    <i class="fa-solid fa-kitchen-set display-1 text-primary my-4"></i>
                    <h4 class="fw-bold">دورة عمل ذكية ومحكمة</h4>
                    <p class="text-muted fs-6">متابعة لحظية لدفعات العميل وحالة التنفيذ في الورشة والموقع</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Key Features Section -->
<section id="services" class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-dark">خدمات ودورة عمل النظام</h2>
            <p class="text-muted">نظام يدير خطواتك الاحترافية خطوة بخطوة</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                    <div class="bg-primary-subtle text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                        <i class="fa-solid fa-users fs-3"></i>
                    </div>
                    <h5 class="fw-bold">1. إدارة العملاء والمبيعات</h5>
                    <p class="text-muted fs-6">تسجيل العملاء المهتمين وتحديد مواعيد الزيارات الميدانية بدقة.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                    <div class="bg-success-subtle text-success rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                        <i class="fa-solid fa-ruler-combined fs-3"></i>
                    </div>
                    <h5 class="fw-bold">2. الرفع الميداني والتصميم</h5>
                    <p class="text-muted fs-6">تسجيل القياسات وعرض السعر مع إمكانية تحصيل رسوم تصميم مستقلة.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                    <div class="bg-warning-subtle text-warning rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                        <i class="fa-solid fa-boxes-stacked fs-3"></i>
                    </div>
                    <h5 class="fw-bold">3. التصنيع والمخازن</h5>
                    <p class="text-muted fs-6">إصدار أوامر الشراء للخامات الناقصة ومتابعة خط الإنتاج حتى التركيب.</p>
                </div>
            </div>
        </div>
    </div>
</section>
