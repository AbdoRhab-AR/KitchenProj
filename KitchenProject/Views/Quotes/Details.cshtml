@model KitchenProject.Models.Entities.Quote
@{
    ViewData["Title"] = "عرض السعر " + Model.QuoteNo;
    Layout = "_DashboardLayout";
}

<!-- Page Header Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">التصاميم والأسعار</a></li>
                <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId" class="text-decoration-none">@Model.Project?.ProjectName</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.QuoteNo</li>
            </ol>
        </nav>
        <h2 class="page-header-title mb-0 d-flex flex-wrap align-items-center gap-2">
            <i class="fa-solid fa-file-invoice-dollar text-primary"></i>
            <span>عرض سعر @Model.QuoteNo</span>
            <partial name="_StatusBadge" model="Model.Status" />
        </h2>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-dark fw-bold rounded-3">
            <i class="fa-solid fa-print me-1"></i> طباعة
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-pen-to-square"></i> تعديل
        </a>
        <button type="button" class="btn btn-outline-danger fw-bold rounded-3" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="fa-solid fa-trash-can"></i>
        </button>
    </div>
</div>

<div class="row g-4">
    <!-- Items & Totals -->
    <div class="col-12 col-xl-8">
        <div class="custom-card">
            <div class="card-header-custom">
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-list-ol text-primary me-2"></i> بنود العرض</h5>
                <span class="badge bg-light text-dark border">@Model.Items.Count بند</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light text-muted" style="font-size:0.85rem;">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>الوصف</th>
                            <th>الوحدة</th>
                            <th>الكمية</th>
                            <th>سعر الوحدة</th>
                            <th class="pe-4">الإجمالي</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var n = 1; }
                        @foreach (var item in Model.Items.OrderBy(i => i.Created))
                        {
                            <tr>
                                <td class="ps-4 text-muted">@(n++)</td>
                                <td>
                                    <div class="fw-semibold">@item.Description</div>
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <div class="small text-muted">@item.Notes</div>
                                    }
                                </td>
                                <td>@item.Unit</td>
                                <td>@item.Quantity.ToString("0.##")</td>
                                <td>@item.UnitPrice.ToString("N2")</td>
                                <td class="pe-4 fw-bold">@item.Total.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-4 border-top d-flex justify-content-end">
                <table class="table table-sm table-borderless mb-0" style="max-width:340px;">
                    <tr><td class="text-muted fw-bold">المجموع</td><td class="text-end fw-bold">@Model.Subtotal.ToString("N2")</td></tr>
                    @if (Model.Discount > 0)
                    {
                        <tr><td class="text-muted fw-bold">الخصم (@Model.DiscountPercent.ToString("0.##")%)</td><td class="text-end fw-bold text-danger">- @Model.Discount.ToString("N2")</td></tr>
                    }
                    @if (Model.Tax > 0)
                    {
                        <tr><td class="text-muted fw-bold">ضريبة / رسوم</td><td class="text-end fw-bold">@Model.Tax.ToString("N2")</td></tr>
                    }
                    <tr class="border-top"><td class="fw-bold fs-5">الإجمالي</td><td class="text-end fw-extrabold fs-5 text-primary">@Model.Total.ToString("N2")</td></tr>
                </table>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="custom-card p-4 mt-4">
                <h6 class="fw-bold mb-2"><i class="fa-solid fa-note-sticky text-warning me-2"></i> ملاحظات وشروط العرض</h6>
                <p class="mb-0 text-secondary" style="white-space:pre-line;">@Model.Notes</p>
            </div>
        }
    </div>

    <!-- Side: info & actions -->
    <div class="col-12 col-xl-4">
        <div class="custom-card p-4 mb-4">
            <h6 class="fw-bold mb-3"><i class="fa-solid fa-circle-info text-primary me-2"></i> بيانات العرض</h6>
            <div class="d-flex flex-column gap-2 small">
                <span>العميل: <strong>@Model.Project?.Customer?.Name</strong></span>
                <span>الهاتف: <strong>@Model.Project?.Customer?.Phone</strong></span>
                <span>المشروع: <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId" class="fw-bold">@Model.Project?.ProjectNo</a></span>
                <span>تاريخ الإنشاء: <strong>@Model.Created.ToLocalTime().ToString("yyyy/MM/dd")</strong></span>
                <span>صالح حتى: <strong>@(Model.ValidUntil?.ToString("yyyy/MM/dd") ?? "-")</strong></span>
            </div>
        </div>

        <div class="custom-card p-4">
            <h6 class="fw-bold mb-3"><i class="fa-solid fa-bolt text-warning me-2"></i> الإجراءات</h6>
            <div class="d-grid gap-2">
                @if (Model.Status == DesignStatus.Draft)
                {
                    <form asp-action="SetStatus" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="status" value="@DesignStatus.WaitingApproval" />
                        <button type="submit" class="btn btn-warning fw-bold w-100"><i class="fa-solid fa-paper-plane me-1"></i> أُرسل للعميل (بانتظار الموافقة)</button>
                    </form>
                }
                @if (Model.Status != DesignStatus.Approved)
                {
                    <form asp-action="SetStatus" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="status" value="@DesignStatus.Approved" />
                        <button type="submit" class="btn btn-success fw-bold w-100"><i class="fa-solid fa-circle-check me-1"></i> العميل وافق - اعتماد العرض</button>
                    </form>
                }
                @if (Model.Status != DesignStatus.Rejected && Model.Status != DesignStatus.Approved)
                {
                    <form asp-action="SetStatus" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="status" value="@DesignStatus.Rejected" />
                        <button type="submit" class="btn btn-outline-danger fw-bold w-100"><i class="fa-solid fa-circle-xmark me-1"></i> العميل رفض العرض</button>
                    </form>
                }
                @if (Model.Status == DesignStatus.Approved)
                {
                    if (ViewBag.HasContract == true)
                    {
                        <div class="alert alert-success small mb-0"><i class="fa-solid fa-file-contract me-1"></i> تم إنشاء عقد من هذا العرض</div>
                    }
                    else
                    {
                        <a asp-controller="Contracts" asp-action="Create" asp-route-quoteId="@Model.Id" class="btn btn-primary-custom w-100">
                            <i class="fa-solid fa-file-signature me-1"></i> إنشاء عقد من هذا العرض
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 text-start">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> تأكيد حذف عرض السعر
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                هل أنت متأكد من حذف عرض السعر <strong>@Model.QuoteNo</strong> وكل بنوده؟
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">إلغاء</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger fw-bold">حذف نهائي</button>
                </form>
            </div>
        </div>
    </div>
</div>
