@model KitchenProject.Models.Entities.Purchase
@{
    var options = (List<ItemOption>)ViewBag.ItemOptions;
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // قائمة الخامات لكل سطر، مع الوحدة وآخر سعر شراء لتعبئة السطر تلقائياً
    string ItemSelect(Guid selected) =>
        "<option value=\"\">-- اختر الخامة --</option>" + string.Concat(options.Select(o =>
            $"<option value=\"{o.Id}\" data-unit=\"{System.Net.WebUtility.HtmlEncode(o.Unit)}\" data-price=\"{o.Price.ToString("0.##", inv)}\"{(o.Id == selected ? " selected" : "")}>{System.Net.WebUtility.HtmlEncode(o.Code + " - " + o.Name)}</option>"));
}

<div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

<h6 class="fw-bold text-muted mb-3"><i class="fa-solid fa-circle-info me-2"></i> بيانات الفاتورة</h6>
<div class="row g-4 mb-4">
    <div class="col-12 col-md-3">
        <label asp-for="PurchaseNo" class="form-label fw-bold">رقم الفاتورة</label>
        <input asp-for="PurchaseNo" class="form-control bg-light fw-bold text-primary" readonly />
    </div>
    <div class="col-12 col-md-5">
        <label asp-for="SupplierId" class="form-label fw-bold">المورد <span class="text-danger">*</span></label>
        <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
            <option value="">-- اختر المورد --</option>
        </select>
        <small class="text-muted"><a asp-controller="Suppliers" asp-action="Create" target="_blank">+ مورد جديد</a></small>
    </div>
    <div class="col-6 col-md-2">
        <label asp-for="InvoiceNo" class="form-label fw-bold">رقم فاتورة المورد</label>
        <input asp-for="InvoiceNo" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <label asp-for="PurchaseDate" class="form-label fw-bold">التاريخ</label>
        <input asp-for="PurchaseDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
    </div>
    <div class="col-12 col-md-3">
        <label asp-for="WarehouseId" class="form-label fw-bold">المخزن <span class="text-danger">*</span></label>
        <select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select"></select>
    </div>
    <div class="col-12 col-md-5">
        <label asp-for="ProjectId" class="form-label fw-bold">لصالح مشروع (اختياري)</label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select" id="projectId">
            <option value="">-- مشتريات عامة للمخزن --</option>
        </select>
    </div>
    <div class="col-12 col-md-4 d-flex align-items-end">
        <div class="form-check form-switch mb-2" id="directBox">
            <input asp-for="DirectToProject" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="DirectToProject" class="form-check-label fw-bold">صرف مباشر على المشروع عند الاستلام</label>
            <small class="d-block text-muted">تُسجل تكلفتها على المشروع ولا تبقى في رصيد المخزن</small>
        </div>
    </div>
</div>

<h6 class="fw-bold text-muted mb-3"><i class="fa-solid fa-cubes me-2"></i> الخامات</h6>
@if (!options.Any())
{
    <div class="alert alert-warning border-0 rounded-3">
        لا توجد أصناف خام بعد. <a asp-controller="Items" asp-action="Create" asp-route-type="Raw" target="_blank" class="fw-bold">أضف خامة</a> ثم حدّث الصفحة.
    </div>
}
<div class="table-responsive mb-2">
    <table class="table align-middle mb-0" id="itemsTable">
        <thead class="bg-light text-muted" style="font-size:0.85rem;">
            <tr>
                <th style="width:40px;">#</th>
                <th>الخامة <span class="text-danger">*</span></th>
                <th style="width:90px;">الوحدة</th>
                <th style="width:110px;">الكمية</th>
                <th style="width:140px;">سعر الوحدة</th>
                <th style="width:140px;">الإجمالي</th>
                <th style="width:50px;"></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr class="item-row">
                    <td class="row-no text-muted fw-bold">@(i + 1)</td>
                    <td><select name="Items[@i].ItemId" class="form-select form-select-sm item-select">@Html.Raw(ItemSelect(Model.Items[i].ItemId))</select></td>
                    <td class="unit small text-muted"></td>
                    <td><input name="Items[@i].Quantity" value="@Model.Items[i].Quantity.ToString("0.##", inv)" type="number" step="0.01" min="0.01" class="form-control form-control-sm qty" /></td>
                    <td><input name="Items[@i].UnitPrice" value="@Model.Items[i].UnitPrice.ToString("0.##", inv)" type="number" step="0.01" min="0" class="form-control form-control-sm price" /></td>
                    <td class="fw-bold line-total">0.00</td>
                    <td><button type="button" class="btn btn-sm btn-light border text-danger remove-row" title="حذف السطر"><i class="fa-solid fa-xmark"></i></button></td>
                </tr>
            }
        </tbody>
    </table>
</div>
<button type="button" class="btn btn-sm btn-outline-primary fw-bold mb-4" id="addRow">
    <i class="fa-solid fa-plus me-1"></i> إضافة سطر
</button>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <label asp-for="Notes" class="form-label fw-bold">ملاحظات</label>
        <textarea asp-for="Notes" class="form-control" rows="5"></textarea>
    </div>
    <div class="col-12 col-lg-5">
        <div class="bg-light rounded-3 p-3">
            <div class="d-flex justify-content-between mb-2">
                <span class="fw-bold text-muted">المجموع</span>
                <span class="fw-bold" id="subtotal">0.00</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                <label asp-for="Discount" class="fw-bold text-muted mb-0">خصم المورد</label>
                <input asp-for="Discount" type="number" step="0.01" min="0" class="form-control form-control-sm" style="max-width:130px;" id="discount" />
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                <label asp-for="Tax" class="fw-bold text-muted mb-0">ضريبة / نقل</label>
                <input asp-for="Tax" type="number" step="0.01" min="0" class="form-control form-control-sm" style="max-width:130px;" id="tax" />
            </div>
            <hr />
            <div class="d-flex justify-content-between fs-5">
                <span class="fw-bold">الإجمالي</span>
                <span class="fw-extrabold text-primary" id="grandTotal">0.00</span>
            </div>
            <small class="text-muted d-block mt-2">الخصم والنقل يُوزعان على تكلفة الخامات عند الاستلام</small>
        </div>
    </div>
</div>

<template id="rowTemplate">
    <tr class="item-row">
        <td class="row-no text-muted fw-bold"></td>
        <td><select data-field="ItemId" class="form-select form-select-sm item-select">@Html.Raw(ItemSelect(Guid.Empty))</select></td>
        <td class="unit small text-muted"></td>
        <td><input data-field="Quantity" value="1" type="number" step="0.01" min="0.01" class="form-control form-control-sm qty" /></td>
        <td><input data-field="UnitPrice" value="0" type="number" step="0.01" min="0" class="form-control form-control-sm price" /></td>
        <td class="fw-bold line-total">0.00</td>
        <td><button type="button" class="btn btn-sm btn-light border text-danger remove-row" title="حذف السطر"><i class="fa-solid fa-xmark"></i></button></td>
    </tr>
</template>

<script>
    (function () {
        const tbody = document.querySelector('#itemsTable tbody');
        const fmt = n => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const num = el => parseFloat(el?.value) || 0;

        // يعيد ترقيم الصفوف وأسماء الحقول Items[0..n] حتى يربطها MVC بشكل صحيح
        function renumber() {
            tbody.querySelectorAll('tr.item-row').forEach((tr, i) => {
                tr.querySelector('.row-no').textContent = i + 1;
                tr.querySelectorAll('input, select').forEach(input => {
                    const field = input.dataset.field || input.name.replace(/^Items\[\d+\]\./, '');
                    input.dataset.field = field;
                    input.name = `Items[${i}].${field}`;
                });
            });
        }

        function showUnit(tr) {
            const opt = tr.querySelector('.item-select').selectedOptions[0];
            tr.querySelector('.unit').textContent = opt?.dataset.unit || '';
        }

        function recalc() {
            let subtotal = 0;
            tbody.querySelectorAll('tr.item-row').forEach(tr => {
                const line = num(tr.querySelector('.qty')) * num(tr.querySelector('.price'));
                tr.querySelector('.line-total').textContent = fmt(line);
                subtotal += line;
            });
            const total = subtotal - num(document.getElementById('discount')) + num(document.getElementById('tax'));
            document.getElementById('subtotal').textContent = fmt(subtotal);
            document.getElementById('grandTotal').textContent = fmt(total);
        }

        document.getElementById('addRow').addEventListener('click', () => {
            tbody.appendChild(document.getElementById('rowTemplate').content.cloneNode(true));
            renumber();
            recalc();
            tbody.lastElementChild.querySelector('select').focus();
        });

        tbody.addEventListener('click', e => {
            const btn = e.target.closest('.remove-row');
            if (!btn) return;
            if (tbody.querySelectorAll('tr.item-row').length > 1) {
                btn.closest('tr').remove();
            } else {
                btn.closest('tr').querySelector('select').value = '';
                showUnit(btn.closest('tr'));
            }
            renumber();
            recalc();
        });

        // اختيار الخامة يملأ آخر سعر شراء لها
        tbody.addEventListener('change', e => {
            if (!e.target.matches('.item-select')) return;
            const tr = e.target.closest('tr');
            const opt = e.target.selectedOptions[0];
            if (opt?.dataset.price) tr.querySelector('.price').value = opt.dataset.price;
            showUnit(tr);
            recalc();
        });

        document.addEventListener('input', e => {
            if (e.target.matches('.qty, .price, #discount, #tax')) recalc();
        });

        // الصرف المباشر متاح فقط عند اختيار مشروع
        const project = document.getElementById('projectId');
        const direct = document.getElementById('directBox');
        function toggleDirect() {
            direct.classList.toggle('d-none', !project.value);
            if (!project.value) direct.querySelector('input').checked = false;
        }
        project.addEventListener('change', toggleDirect);

        tbody.querySelectorAll('tr.item-row').forEach(showUnit);
        toggleDirect();
        renumber();
        recalc();
    })();
</script>
