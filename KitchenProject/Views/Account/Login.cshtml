@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول - بن قسومة</title>
    <link rel="icon" type="image/png" href="~/images/brand/logo-mark.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #880D18; --brand-dark: #5f0911; }
        body {
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f7f3f3 0%, #efe6e6 100%);
            padding: 16px;
        }
        .login-card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(95, 9, 17, 0.12);
            overflow: hidden;
        }
        .login-head {
            background: #fff;
            border-bottom: 4px solid var(--brand);
            padding: 28px 24px 20px;
            text-align: center;
        }
        .login-head img { max-width: 230px; height: auto; }
        .login-body { padding: 28px; }
        .form-control { padding: 0.7rem 0.9rem; border-radius: 10px; }
        .form-control:focus { border-color: var(--brand); box-shadow: 0 0 0 0.2rem rgba(136, 13, 24, 0.15); }
        .input-group-text { border-radius: 10px; background: #faf7f7; }
        .btn-brand {
            background: var(--brand);
            border-color: var(--brand);
            color: #fff;
            border-radius: 10px;
            padding: 0.7rem;
            font-weight: 700;
        }
        .btn-brand:hover, .btn-brand:focus { background: var(--brand-dark); border-color: var(--brand-dark); color: #fff; }
        .form-check-input:checked { background-color: var(--brand); border-color: var(--brand); }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-head">
            <img src="~/images/brand/logo.png" alt="Bin Gsoma" />
            <div class="text-muted small mt-2">نظام إدارة المطابخ</div>
        </div>
        <div class="login-body">
            <h5 class="fw-bold mb-4 text-center">تسجيل الدخول</h5>

            <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3 py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label fw-bold small">اسم المستخدم</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-user text-muted"></i></span>
                        <input asp-for="UserName" class="form-control" dir="ltr" autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-bold small">كلمة المرور</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-lock text-muted"></i></span>
                        <input asp-for="Password" class="form-control" dir="ltr" autocomplete="current-password" id="password" />
                        <button type="button" class="btn btn-outline-secondary" id="togglePassword" title="إظهار كلمة المرور" style="border-radius:10px 0 0 10px;">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small">تذكرني على هذا الجهاز</label>
                </div>

                <button type="submit" class="btn btn-brand w-100">
                    <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> دخول
                </button>
            </form>

            <p class="text-muted small text-center mt-4 mb-0">نسيت كلمة المرور؟ تواصل مع مدير النظام لإعادة تعيينها</p>
        </div>
    </div>

    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const input = document.getElementById('password');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            this.querySelector('i').className = show ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
        });
    </script>
</body>
</html>
