@model List<PartyStatementRow>
@{
    var supplier = (Supplier)ViewBag.Supplier;
    ViewData["Title"] = "كشف حساب مورد - " + supplier.Name;
    Layout = "_DashboardLayout";
    DateTime? from = ViewBag.From;
    DateTime? to = ViewBag.To;
    decimal opening = ViewBag.Opening;
    var debit = Model.Sum(r => r.Debit);
    var credit = Model.Sum(r => r.Credit);
    var closing = Model.Any() ? Model.Last().Balance : opening;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i> كشف حساب المورد: @supplier.Name</h2>
        <p class="text-muted mb-0">@supplier.SupplierNo — @supplier.Phone</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="StatementPrint" asp-route-id="@supplier.Id" asp-route-from="@from?.ToString("yyyy-MM-dd")" asp-route-to="@to?.ToString("yyyy-MM-dd")" target="_blank" class="btn btn-primary-custom"><i class="fa-solid fa-print me-1"></i> طباعة (A4)</a>
        <a asp-action="Details" asp-route-id="@supplier.Id" class="btn btn-light border">ملف المورد</a>
    </div>
</div>

<div class="custom-card mb-4 p-3">
    <form method="get" asp-action="Statement" asp-route-id="@supplier.Id" class="row g-3 align-items-end">
        <div class="col-6 col-md-3"><label class="form-label small fw-bold text-muted">من</label><input type="date" name="from" value="@from?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-6 col-md-3"><label class="form-label small fw-bold text-muted">إلى</label><input type="date" name="to" value="@to?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary fw-bold rounded-3"><i class="fa-solid fa-search me-1"></i> عرض</button>
            <a asp-action="Statement" asp-route-id="@supplier.Id" class="btn btn-light border text-muted"><i class="fa-solid fa-xmark"></i></a>
        </div>
    </form>
</div>

<div class="custom-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted" style="font-size:0.85rem;">
                <tr><th class="ps-4">التاريخ</th><th>النوع</th><th>المرجع</th><th>البيان</th><th>مدفوع/مرتجع (مدين)</th><th>فواتير (دائن)</th><th>الرصيد المستحق</th></tr>
            </thead>
            <tbody>
                @if (from.HasValue)
                {
                    <tr class="table-light"><td class="ps-4" colspan="6">رصيد ما قبل @from.Value.ToString("yyyy/MM/dd")</td><td class="fw-bold">@opening.ToString("N2")</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="ps-4 small text-muted">@r.Date.ToString("yyyy/MM/dd")</td>
                        <td><span class="badge bg-light text-dark border">@r.DocType</span></td>
                        <td class="font-monospace small">@r.DocNo</td>
                        <td class="small">@r.Description</td>
                        <td class="text-success fw-semibold">@(r.Debit == 0 ? "-" : r.Debit.ToString("N2"))</td>
                        <td class="text-danger fw-semibold">@(r.Credit == 0 ? "-" : r.Credit.ToString("N2"))</td>
                        <td class="fw-bold">@r.Balance.ToString("N2")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center py-5 text-muted">لا توجد حركات في هذه الفترة</td></tr>
                }
            </tbody>
            <tfoot class="bg-light fw-bold">
                <tr><td colspan="4" class="ps-4">الإجمالي</td><td class="text-success">@debit.ToString("N2")</td><td class="text-danger">@credit.ToString("N2")</td><td>@closing.ToString("N2")</td></tr>
            </tfoot>
        </table>
    </div>
</div>
