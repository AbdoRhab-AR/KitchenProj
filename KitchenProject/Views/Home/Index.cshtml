@model DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم";
    Layout = "_DashboardLayout";
    var pipeline = new[] { ProjectStatus.New, ProjectStatus.SiteVisit, ProjectStatus.Design, ProjectStatus.Quote, ProjectStatus.Contracted, ProjectStatus.InProgress, ProjectStatus.Delivered };
    var maxStage = Math.Max(1, pipeline.Max(s => Model.ProjectsByStatus.GetValueOrDefault(s)));
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1">
            <i class="fa-solid fa-gauge-high text-primary me-2"></i> أهلاً، @User.DisplayName()
        </h2>
        <p class="text-muted mb-0">@DateTime.Today.ToString("dddd، d MMMM yyyy", new System.Globalization.CultureInfo("ar-LY"))</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Projects" asp-action="Create" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-plus"></i><span>مشروع جديد</span>
        </a>
        @if (AppRoles.CanAccess(User, "MaterialRequests", "Create"))
        {
            <a asp-controller="MaterialRequests" asp-action="Create" class="btn btn-outline-primary fw-bold rounded-3"><i class="fa-solid fa-clipboard-list me-1"></i> طلب مواد</a>
        }
    </div>
</div>

<!-- KPI cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <a asp-controller="Projects" asp-action="Index" class="text-decoration-none">
            <div class="custom-card p-3 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-bold d-block mb-1 small">مشاريع جارية</span>
                    <h3 class="fw-extrabold mb-0 text-primary">@Model.ActiveProjects</h3>
                </div>
                <div class="bg-primary-subtle text-primary rounded-3 p-3"><i class="fa-solid fa-diagram-project fs-4"></i></div>
            </div>
        </a>
    </div>

    @if (Model.ShowFinance)
    {
        <div class="col-6 col-lg-3">
            <a asp-controller="Payments" asp-action="Index" class="text-decoration-none">
                <div class="custom-card p-3 h-100 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold d-block mb-1 small">تحصيل هذا الشهر</span>
                        <h4 class="fw-extrabold mb-0 text-success">@Model.MonthCollections.ToString("N2")</h4>
                    </div>
                    <div class="bg-success-subtle text-success rounded-3 p-3"><i class="fa-solid fa-sack-dollar fs-4"></i></div>
                </div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-controller="Payments" asp-action="Index" class="text-decoration-none">
                <div class="custom-card p-3 h-100 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold d-block mb-1 small">متبقي على العملاء</span>
                        <h4 class="fw-extrabold mb-0 text-danger">@Model.Outstanding.ToString("N2")</h4>
                    </div>
                    <div class="bg-danger-subtle text-danger rounded-3 p-3"><i class="fa-solid fa-file-invoice-dollar fs-4"></i></div>
                </div>
            </a>
        </div>
        @if (AppRoles.CanAccess(User, "Expenses"))
        {
            <div class="col-6 col-lg-3">
                <a asp-controller="Expenses" asp-action="Index" class="text-decoration-none">
                    <div class="custom-card p-3 h-100 d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted fw-bold d-block mb-1 small">مصروفات هذا الشهر</span>
                            <h4 class="fw-extrabold mb-0 text-warning-emphasis">@Model.MonthExpenses.ToString("N2")</h4>
                        </div>
                        <div class="bg-warning-subtle text-warning-emphasis rounded-3 p-3"><i class="fa-solid fa-money-bill-transfer fs-4"></i></div>
                    </div>
                </a>
            </div>
        }
    }

    @if (Model.ShowStock)
    {
        <div class="col-6 col-lg-3">
            <a asp-controller="Stock" asp-action="Index" asp-route-lowStock="true" class="text-decoration-none">
                <div class="custom-card p-3 h-100 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold d-block mb-1 small">خامات تحت الحد الأدنى</span>
                        <h3 class="fw-extrabold mb-0 @(Model.LowStockCount > 0 ? "text-danger" : "text-success")">@Model.LowStockCount</h3>
                    </div>
                    <div class="bg-danger-subtle text-danger rounded-3 p-3"><i class="fa-solid fa-triangle-exclamation fs-4"></i></div>
                </div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-controller="Stock" asp-action="Movements" class="text-decoration-none">
                <div class="custom-card p-3 h-100 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold d-block mb-1 small">خامات صُرفت هذا الشهر</span>
                        <h4 class="fw-extrabold mb-0 text-dark">@Model.MonthMaterialsIssued.ToString("N2")</h4>
                    </div>
                    <div class="bg-light text-dark rounded-3 p-3"><i class="fa-solid fa-dolly fs-4"></i></div>
                </div>
            </a>
        </div>
    }

    @if (Model.ShowRequests)
    {
        <div class="col-6 col-lg-3">
            <a asp-controller="MaterialRequests" asp-action="Index" asp-route-status="@Model.RequestsStatus" class="text-decoration-none">
                <div class="custom-card p-3 h-100 d-flex align-items-center justify-content-between @(Model.RequestsCount > 0 ? "border border-warning" : "")">
                    <div>
                        <span class="text-muted fw-bold d-block mb-1 small">@Model.RequestsLabel</span>
                        <h3 class="fw-extrabold mb-0 text-warning-emphasis">@Model.RequestsCount</h3>
                    </div>
                    <div class="bg-warning-subtle text-warning-emphasis rounded-3 p-3"><i class="fa-solid fa-clipboard-list fs-4"></i></div>
                </div>
            </a>
        </div>
    }

    @if (Model.DraftPurchases > 0)
    {
        <div class="col-6 col-lg-3">
            <a asp-controller="Purchases" asp-action="Index" asp-route-status="@PurchaseStatuses.Draft" class="text-decoration-none">
                <div class="custom-card p-3 h-100 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold d-block mb-1 small">فواتير شراء لم تُستلم</span>
                        <h3 class="fw-extrabold mb-0 text-info-emphasis">@Model.DraftPurchases</h3>
                    </div>
                    <div class="bg-info-subtle text-info-emphasis rounded-3 p-3"><i class="fa-solid fa-truck-ramp-box fs-4"></i></div>
                </div>
            </a>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <!-- Pipeline -->
        <div class="custom-card p-4 mb-4">
            <h6 class="fw-bold mb-3"><i class="fa-solid fa-bars-progress text-primary me-2"></i> المشاريع حسب المرحلة</h6>
            @foreach (var stage in pipeline)
            {
                var count = Model.ProjectsByStatus.GetValueOrDefault(stage);
                <a asp-controller="Projects" asp-action="Index" asp-route-status="@stage" class="d-flex align-items-center gap-3 mb-2 text-decoration-none text-dark">
                    <span class="small fw-bold" style="width:110px;">@stage.GetDisplayName()</span>
                    <div class="progress flex-grow-1" style="height:10px;">
                        <div class="progress-bar" style="width:@(count * 100 / maxStage)%; background:#880D18;"></div>
                    </div>
                    <span class="fw-bold small" style="width:30px;">@count</span>
                </a>
            }
        </div>

        <!-- Recent / my projects -->
        <div class="custom-card">
            <div class="card-header-custom">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-clock-rotate-left text-secondary me-2"></i>
                    @(Model.MyProjects.Any() ? "مشاريعي" : "أحدث المشاريع")
                </h5>
                <a asp-controller="Projects" asp-action="Index" class="small fw-bold">كل المشاريع</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <tbody>
                        @{ var list = Model.MyProjects.Any() ? Model.MyProjects : Model.RecentProjects; }
                        @if (list.Any())
                        {
                            foreach (var p in list)
                            {
                                var late = p.ExpectedDeliveryDate.HasValue && p.ExpectedDeliveryDate.Value.Date < DateTime.Today
                                           && p.Status is not (ProjectStatus.Delivered or ProjectStatus.Closed or ProjectStatus.Cancelled);
                                <tr>
                                    <td class="ps-4">
                                        <a asp-controller="Projects" asp-action="Details" asp-route-id="@p.Id" class="fw-bold text-dark text-decoration-none">@p.ProjectName</a>
                                        <small class="d-block text-muted">@p.ProjectNo · @p.Customer?.Name</small>
                                    </td>
                                    <td><partial name="~/Views/Projects/_StatusBadge.cshtml" model="p.Status" /></td>
                                    <td class="small pe-4 text-end @(late ? "text-danger fw-bold" : "text-muted")">
                                        @if (p.ExpectedDeliveryDate.HasValue)
                                        {
                                            <span title="موعد التسليم"><i class="fa-regular fa-calendar me-1"></i>@p.ExpectedDeliveryDate.Value.ToString("yyyy/MM/dd")</span>
                                            @if (late) { <small class="d-block">متأخر</small> }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td class="text-center text-muted py-4">لا توجد مشاريع بعد</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        @if (AppRoles.CanAccess(User, "SiteVisits"))
        {
            <div class="custom-card mb-4">
                <div class="card-header-custom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-ruler-combined text-info me-2"></i> المعاينات القادمة (7 أيام)</h5>
                </div>
                <div class="p-3">
                    @if (Model.UpcomingVisits.Any())
                    {
                        foreach (var v in Model.UpcomingVisits)
                        {
                            <a asp-controller="SiteVisits" asp-action="Edit" asp-route-id="@v.Id" class="d-flex justify-content-between align-items-center border-bottom py-2 text-decoration-none text-dark">
                                <span>
                                    <span class="fw-bold">@v.Project?.ProjectName</span>
                                    <small class="d-block text-muted">@v.Project?.Customer?.Name · @v.Engineer?.UserName</small>
                                </span>
                                <span class="badge @(v.VisitDate.Date == DateTime.Today ? "bg-primary" : "bg-light text-dark border")">
                                    @(v.VisitDate.Date == DateTime.Today ? "اليوم" : v.VisitDate.ToString("MM/dd")) @v.VisitDate.ToString("HH:mm")
                                </span>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="text-muted small text-center mb-0 py-3">لا توجد معاينات مجدولة</p>
                    }
                </div>
            </div>
        }

        <div class="custom-card p-4">
            <h6 class="fw-bold mb-3"><i class="fa-solid fa-bolt text-warning me-2"></i> اختصارات</h6>
            <div class="d-grid gap-2">
                @if (AppRoles.CanAccess(User, "Payments", "Create"))
                {
                    <a asp-controller="Payments" asp-action="Create" class="btn btn-light border text-start fw-bold"><i class="fa-solid fa-receipt text-success me-2"></i> إيصال قبض</a>
                }
                @if (AppRoles.CanAccess(User, "Expenses", "Create"))
                {
                    <a asp-controller="Expenses" asp-action="Create" class="btn btn-light border text-start fw-bold"><i class="fa-solid fa-money-bill-transfer text-danger me-2"></i> تسجيل مصروف</a>
                }
                @if (AppRoles.CanAccess(User, "Purchases", "Create"))
                {
                    <a asp-controller="Purchases" asp-action="Create" class="btn btn-light border text-start fw-bold"><i class="fa-solid fa-cart-plus text-info me-2"></i> فاتورة شراء</a>
                }
                @if (AppRoles.CanAccess(User, "Stock", "Issue"))
                {
                    <a asp-controller="Stock" asp-action="Issue" class="btn btn-light border text-start fw-bold"><i class="fa-solid fa-dolly text-primary me-2"></i> صرف خامات لمشروع</a>
                }
                @if (AppRoles.CanAccess(User, "Reports"))
                {
                    <a asp-controller="Reports" asp-action="Profit" class="btn btn-light border text-start fw-bold"><i class="fa-solid fa-chart-line text-success me-2"></i> تقرير الأرباح</a>
                }
            </div>
        </div>
    </div>
</div>
