@using KitchenProject.Models.Interfaces
@inject IUnitOfWork<SiteInfo> SiteInfoUow
@inject IUnitOfWork<Contact> ContactUow
@{
    var site = SiteInfoUow.Entity.GetAll().FirstOrDefault();
    var contact = ContactUow.Entity.GetAll().FirstOrDefault();
    var letterhead = site?.LetterheadUrl;
}
@*
    كل المستندات المطبوعة (عرض السعر، العقد، ورقة المواصفات) تستخدم هذا القالب.
    إن وُجد ورق رسمي (LetterheadUrl) يُرسم كخلفية ثابتة تتكرر في كل صفحة مطبوعة،
    والجدول الخارجي بـ thead/tfoot فارغين يحجز مكان رأس وتذييل الورق الرسمي في كل صفحة.
*@
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @site?.Name</title>
    <link rel="icon" type="image/png" href="~/images/brand/logo-mark.png" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --brand: #880D18;
            --brand-soft: #f7ecec;
            --sand: #d6b49b;
            --head-space: 44mm;   /* ارتفاع رأس الورق الرسمي */
            --foot-space: 50mm;   /* ارتفاع تذييل الورق الرسمي */
            --side-space: 18mm;
        }

        @@page { size: A4; margin: 0; }

        body {
            font-family: 'Cairo', sans-serif;
            background: #e2e8f0;
            color: #1f2937;
            font-size: 0.9rem;
        }

        .sheet {
            position: relative;
            background: #fff;
            width: 210mm;
            min-height: 297mm;
            margin: 24px auto;
            box-shadow: 0 6px 30px rgba(0, 0, 0, 0.12);
        }

        .letterhead-bg {
            position: absolute;
            inset: 0;
            width: 210mm;
            height: 297mm;
            z-index: 0;
        }

        .page-frame { position: relative; z-index: 1; width: 100%; border-collapse: collapse; }
        .page-frame > thead td { height: var(--head-space); }
        .page-frame > tfoot td { height: var(--foot-space); }
        .page-frame > tbody > tr > td { padding: 0 var(--side-space); vertical-align: top; }

        /* بدون ورق رسمي: رأس نصي بسيط */
        .text-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid var(--brand); padding: 14mm var(--side-space) 10px; margin-bottom: 16px; }
        .text-header img { max-height: 60px; max-width: 220px; object-fit: contain; }

        .doc-heading { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid var(--brand); padding-bottom: 8px; margin-bottom: 14px; }
        .doc-title { font-weight: 800; font-size: 1.45rem; color: var(--brand); }
        .doc-no { font-weight: 700; color: #475569; }

        .meta-box { background: #fafafa; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 12px; height: 100%; }
        .meta-box .label { color: #64748b; font-size: 0.75rem; font-weight: 700; display: block; }

        .print-table { margin-bottom: 0; }
        .print-table th { background: var(--brand) !important; color: #fff !important; font-weight: 700; font-size: 0.82rem; }
        .print-table td, .print-table th { border-color: #e5d5d5 !important; padding: 6px 8px; }
        .print-table tbody tr:nth-child(even) td { background: #fdf8f8; }

        .totals { min-width: 260px; }
        .totals td { padding: 4px 10px; }
        .totals .grand td { background: var(--brand); color: #fff; font-weight: 800; font-size: 1rem; }

        .section-title { font-weight: 800; font-size: 0.98rem; color: var(--brand); border-right: 4px solid var(--brand); padding-right: 8px; margin: 16px 0 8px; }
        .pre-text { white-space: pre-line; }
        .signatures { display: flex; justify-content: space-between; gap: 40px; margin-top: 36px; page-break-inside: avoid; }
        .signatures div { flex: 1; text-align: center; border-top: 1px solid #1f2937; padding-top: 6px; font-weight: 700; font-size: 0.85rem; }
        .no-break { page-break-inside: avoid; }

        .toolbar { position: sticky; top: 0; z-index: 10; background: var(--brand); padding: 10px; text-align: center; }

        @@media print {
            body { background: #fff; }
            .toolbar { display: none; }
            .sheet { width: auto; min-height: 0; margin: 0; box-shadow: none; position: static; }
            /* fixed = تتكرر الخلفية في كل صفحة مطبوعة */
            .letterhead-bg { position: fixed; top: 0; left: 0; }
            * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button onclick="window.print()" class="btn btn-light fw-bold px-4 me-2">
            <i class="fa-solid fa-print me-1"></i> طباعة / حفظ PDF
        </button>
        <button onclick="history.back()" class="btn btn-outline-light fw-bold px-4">
            <i class="fa-solid fa-arrow-right me-1"></i> رجوع
        </button>
    </div>

    <div class="sheet">
        @if (!string.IsNullOrEmpty(letterhead))
        {
            <img class="letterhead-bg" src="@letterhead" alt="" />
            <table class="page-frame">
                <thead><tr><td></td></tr></thead>
                <tfoot><tr><td></td></tr></tfoot>
                <tbody>
                    <tr>
                        <td>
                            <div class="doc-heading">
                                <div class="doc-title">@ViewData["DocTitle"]</div>
                                <div class="doc-no">@ViewData["DocNo"]</div>
                            </div>
                            @RenderBody()
                        </td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            <div class="text-header">
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(site?.LogoUrl))
                    {
                        <img src="@site.LogoUrl" alt="logo" />
                    }
                    else
                    {
                        <div class="fw-bold fs-4">@site?.Name</div>
                    }
                </div>
                @if (contact != null)
                {
                    <div class="text-muted small text-start">
                        <div><i class="fa-solid fa-phone me-1"></i>@contact.Phone</div>
                        <div><i class="fa-solid fa-envelope me-1"></i>@contact.Email</div>
                    </div>
                }
            </div>
            <div style="padding: 0 var(--side-space) 14mm;">
                <div class="doc-heading">
                    <div class="doc-title">@ViewData["DocTitle"]</div>
                    <div class="doc-no">@ViewData["DocNo"]</div>
                </div>
                @RenderBody()
            </div>
        }
    </div>
</body>
</html>
