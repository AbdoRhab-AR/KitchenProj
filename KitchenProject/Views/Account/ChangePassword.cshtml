@model ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
    Layout = "_DashboardLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1">
            <i class="fa-solid fa-user-shield text-primary me-2"></i> حسابي
        </h2>
        <p class="text-muted mb-0">@User.DisplayName() · @User.Identity?.Name · @User.RoleName()</p>
    </div>
</div>

<div class="custom-card p-4 p-md-5" style="max-width:560px;">
    <h5 class="fw-bold mb-4"><i class="fa-solid fa-key text-warning me-2"></i> تغيير كلمة المرور</h5>
    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label fw-bold">كلمة المرور الحالية</label>
            <input asp-for="CurrentPassword" class="form-control" dir="ltr" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label fw-bold">كلمة المرور الجديدة</label>
            <input asp-for="NewPassword" class="form-control" dir="ltr" autocomplete="new-password" />
            <small class="text-muted">6 أحرف على الأقل وتحتوي على رقم</small>
            <span asp-validation-for="NewPassword" class="text-danger small d-block"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label fw-bold">تأكيد كلمة المرور الجديدة</label>
            <input asp-for="ConfirmPassword" class="form-control" dir="ltr" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary-custom px-5 fw-bold">
            <i class="fa-solid fa-floppy-disk me-1"></i> حفظ
        </button>
    </form>
</div>
