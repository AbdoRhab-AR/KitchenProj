@model KitchenProject.Models.Entities.Purchase
@{
    ViewData["Title"] = "تعديل أمر الشراء";
    Layout = "_DashboardLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1">
            <i class="fa-solid fa-pen-to-square text-primary me-2"></i> تعديل أمر الشراء: @Model.InvoiceNo
        </h2>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="fa-solid fa-arrow-right"></i><span>العودة للتفاصيل</span>
    </a>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Created" />
    <input type="hidden" asp-for="PaidAmount" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 rounded-3"></div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="custom-card p-4">
                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">بيانات الأمر</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="InvoiceNo" class="form-label fw-bold">رقم الأمر</label>
                        <input asp-for="InvoiceNo" class="form-control bg-light" readonly />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SupplierId" class="form-label fw-bold">المورد</label>
                        <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.SupplierId">
                            <option value="">-- اختر المورد --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="WarehouseId" class="form-label fw-bold">المخزن</label>
                        <select asp-for="WarehouseId" class="form-select" asp-items="ViewBag.WarehouseId">
                            <option value="">-- اختر المخزن --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProjectId" class="form-label fw-bold">المشروع</label>
                        <select asp-for="ProjectId" class="form-select" asp-items="ViewBag.ProjectId">
                            <option value="">-- شراء عام --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-bold">الحالة</label>
                        <select asp-for="Status" class="form-select" asp-items="ViewBag.StatusList"></select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-bold">ملاحظات</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="custom-card p-4 border-start border-4 border-primary">
                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">الإجماليات</h5>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Subtotal" class="form-label fw-bold">المجموع الفرعي</label>
                        <div class="input-group">
                            <input asp-for="Subtotal" type="number" step="0.01" id="subtotalInput" class="form-control" />
                            <span class="input-group-text text-muted">د.ل</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Discount" class="form-label fw-bold">الخصم</label>
                        <div class="input-group">
                            <input asp-for="Discount" type="number" step="0.01" id="discountInput" class="form-control" />
                            <span class="input-group-text text-muted">د.ل</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Tax" class="form-label fw-bold">الضريبة</label>
                        <div class="input-group">
                            <input asp-for="Tax" type="number" step="0.01" id="taxInput" class="form-control" />
                            <span class="input-group-text text-muted">د.ل</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-center">
                            <p class="text-muted mb-1">الإجمالي</p>
                            <h3 class="fw-bold text-primary mb-0" id="totalDisplay">0.00 <span class="fs-6">د.ل</span></h3>
                            <input type="hidden" asp-for="Total" id="totalInput" />
                        </div>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light border fw-bold flex-fill">إلغاء</a>
                        <button type="submit" class="btn btn-primary-custom flex-fill">
                            <i class="fa-solid fa-save me-1"></i> حفظ
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function calcTotal() {
            var sub = parseFloat($('#subtotalInput').val()) || 0;
            var disc = parseFloat($('#discountInput').val()) || 0;
            var tax = parseFloat($('#taxInput').val()) || 0;
            var total = sub - disc + tax;
            $('#totalDisplay').html(total.toFixed(2) + ' <span class="fs-6">د.ل</span>');
            $('#totalInput').val(total.toFixed(2));
        }
        $('#subtotalInput, #discountInput, #taxInput').on('input', calcTotal);
        calcTotal();
    </script>
}
