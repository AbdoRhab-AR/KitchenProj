@model KitchenProject.Models.Entities.Item
@{
    ViewData["Title"] = "الصنف - " + Model.Name;
    Layout = "_DashboardLayout";
    var isRaw = Model.Type == ItemType.Raw;
    var movements = ViewBag.Movements as List<StockTransaction> ?? new();
    var quoteLines = ViewBag.QuoteLines as List<QuoteItem> ?? new();
    decimal balance = isRaw ? ViewBag.Balance : 0;
    decimal avgCost = isRaw ? ViewBag.AverageCost : 0;
    var low = isRaw && Model.MinQuantity > 0 && balance <= Model.MinQuantity;
}

<!-- Page Header Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">الأصناف</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Code</li>
            </ol>
        </nav>
        <h2 class="page-header-title mb-0 d-flex flex-wrap align-items-center gap-2">
            <i class="fa-solid fa-box text-primary"></i>
            <span>@Model.Name</span>
            <span class="badge bg-light text-dark border font-monospace" style="font-size:0.8rem;">@Model.Code</span>
            <partial name="_TypeBadge" model="Model.Type" />
            @if (Model.Group != null)
            {
                <span class="badge bg-primary-subtle text-primary" style="font-size:0.8rem;">البند @Model.Group.Code - @Model.Group.Name</span>
            }
            @if (!Model.IsActive)
            {
                <span class="badge bg-secondary" style="font-size:0.8rem;">موقوف</span>
            }
        </h2>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (isRaw)
        {
            <a asp-controller="Purchases" asp-action="Create" class="btn btn-outline-success fw-bold rounded-3"><i class="fa-solid fa-cart-plus me-1"></i> شراء</a>
            <a asp-controller="Stock" asp-action="Issue" asp-route-itemId="@Model.Id" class="btn btn-outline-danger fw-bold rounded-3"><i class="fa-solid fa-dolly me-1"></i> صرف لمشروع</a>
            <a asp-controller="Stock" asp-action="Adjust" asp-route-itemId="@Model.Id" class="btn btn-outline-warning fw-bold rounded-3"><i class="fa-solid fa-scale-balanced me-1"></i> جرد</a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-pen-to-square"></i> تعديل
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('حذف الصنف؟ إذا كان عليه حركات سيتم إيقافه فقط.')">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger fw-bold rounded-3" title="حذف"><i class="fa-solid fa-trash-can"></i></button>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="custom-card p-4 mb-4">
            <h6 class="fw-bold mb-3"><i class="fa-solid fa-circle-info text-primary me-2"></i> البيانات</h6>
            <div class="d-flex flex-column gap-2 small">
                <span>الوحدة: <strong>@Model.Unit</strong></span>
                @if (isRaw)
                {
                    <span>آخر سعر شراء: <strong>@Model.PurchasePrice.ToString("N2")</strong></span>
                    <span>متوسط التكلفة: <strong>@avgCost.ToString("N2")</strong></span>
                    <span>حد إعادة الطلب: <strong>@(Model.MinQuantity > 0 ? Model.MinQuantity.ToString("0.##") : "بدون")</strong></span>
                }
                else
                {
                    <span>سعر البيع: <strong>@Model.SalePrice.ToString("N2")</strong></span>
                }
                <span>تاريخ الإضافة: <strong>@Model.Created.ToLocalTime().ToString("yyyy/MM/dd")</strong></span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <p class="bg-light p-3 rounded-3 text-secondary small mb-0 mt-3" style="white-space:pre-line;">@Model.Notes</p>
            }
        </div>

        @if (isRaw)
        {
            <div class="custom-card p-4 @(low ? "border border-danger" : "")">
                <span class="text-muted d-block small fw-bold">الرصيد الحالي</span>
                <span class="fw-extrabold fs-2 @(low ? "text-danger" : "text-success")">@balance.ToString("0.##")</span>
                <span class="text-muted">@Model.Unit</span>
                <div class="small text-muted mt-1">القيمة: <strong>@((balance * avgCost).ToString("N2"))</strong></div>
                @if (low)
                {
                    <div class="alert alert-danger border-0 rounded-3 small mt-3 mb-0">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i> الرصيد عند أو تحت حد الطلب، يُنصح بالشراء
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-12 col-lg-8">
        @if (isRaw)
        {
            <div class="custom-card">
                <div class="card-header-custom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-right-left text-secondary me-2"></i> آخر الحركات</h5>
                    <a asp-controller="Stock" asp-action="Movements" asp-route-itemId="@Model.Id" class="btn btn-sm btn-light border fw-bold">كشف كامل</a>
                </div>
                @if (movements.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="bg-light text-muted small">
                                <tr><th class="ps-4">التاريخ</th><th>الحركة</th><th>المرجع</th><th>المشروع</th><th>وارد</th><th>منصرف</th><th class="pe-4">التكلفة</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var m in movements)
                                {
                                    <tr>
                                        <td class="ps-4 small">@m.TransactionDate.ToString("yyyy/MM/dd")</td>
                                        <td><partial name="~/Views/Stock/_TypeBadge.cshtml" model="m.TransactionType" /></td>
                                        <td class="small">
                                            @if (m.PurchaseId.HasValue)
                                            {
                                                <a asp-controller="Purchases" asp-action="Details" asp-route-id="@m.PurchaseId">@m.ReferenceNo</a>
                                            }
                                            else
                                            {
                                                @m.ReferenceNo
                                            }
                                        </td>
                                        <td class="small">
                                            @if (m.Projects != null)
                                            {
                                                <a asp-controller="Projects" asp-action="Details" asp-route-id="@m.ProjectId">@m.Projects.ProjectNo</a>
                                            }
                                        </td>
                                        <td class="text-success fw-bold">@(m.QuantityIn > 0 ? m.QuantityIn.ToString("0.##") : "")</td>
                                        <td class="text-danger fw-bold">@(m.QuantityOut > 0 ? m.QuantityOut.ToString("0.##") : "")</td>
                                        <td class="pe-4 small">@m.UnitCost.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted small text-center py-4 mb-0">لا توجد حركات على هذا الصنف بعد</p>
                }
            </div>
        }
        else
        {
            <div class="custom-card">
                <div class="card-header-custom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-file-invoice-dollar text-warning me-2"></i> ظهوره في عروض الأسعار</h5>
                    <span class="badge bg-light text-dark border">@quoteLines.Count</span>
                </div>
                @if (quoteLines.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="bg-light text-muted small">
                                <tr><th class="ps-4">العرض</th><th>المشروع</th><th>الكمية</th><th>السعر</th><th class="pe-4">الحالة</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var q in quoteLines)
                                {
                                    <tr>
                                        <td class="ps-4"><a asp-controller="Quotes" asp-action="Details" asp-route-id="@q.QuoteId" class="fw-bold">@q.Quote.QuoteNo</a></td>
                                        <td class="small">@q.Quote.Project?.ProjectName</td>
                                        <td>@q.Quantity.ToString("0.##") @q.Unit</td>
                                        <td>@q.UnitPrice.ToString("N2")</td>
                                        <td class="pe-4"><partial name="~/Views/Quotes/_StatusBadge.cshtml" model="q.Quote.Status" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted small text-center py-4 mb-0">لم يُستخدم هذا الصنف في أي عرض سعر بعد</p>
                }
            </div>
        }
    </div>
</div>
