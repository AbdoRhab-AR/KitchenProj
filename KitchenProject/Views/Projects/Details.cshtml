@model KitchenProject.Models.Entities.Project
@{
    ViewData["Title"] = "تفاصيل المشروع - " + Model.ProjectName;
    Layout = "_DashboardLayout";

    var stages = new[]
    {
        ProjectStatus.New, ProjectStatus.SiteVisit, ProjectStatus.Design, ProjectStatus.Quote,
        ProjectStatus.Contracted, ProjectStatus.InProgress, ProjectStatus.Delivered, ProjectStatus.Closed
    };
    var currentStage = Array.IndexOf(stages, Model.Status);

    var contractsTotal = Model.Contracts.Where(c => c.Status != ContractStatuses.Cancelled).Sum(c => c.TotalAmount);
    var paidTotal = Model.CustomerPayments
        .Where(p => !(p.Payment == PaymentMethod.Chek && p.ChequeStatus == ChequeStatus.Bounced))
        .Sum(p => p.IsRefund ? -p.Amount : p.Amount);
    var expensesTotal = Model.Expenses.Sum(e => e.Amount);
    var saleValue = ProfitService.SaleValue(contractsTotal, Model.FinalAmount, Model.EstimatedAmount, Model.Status, Model.CancellationFee);
    var remaining = saleValue - paidTotal;
    var paidPercent = saleValue > 0 ? (int)Math.Min(100, Math.Round(paidTotal / saleValue * 100)) : 0;

    // تكلفة الخامات = المصروف للمشروع - المرتجع منه
    var materials = ViewBag.Materials as List<StockTransaction> ?? new();
    var purchases = ViewBag.Purchases as List<Purchase> ?? new();
    var requests = ViewBag.MaterialRequests as List<MaterialRequest> ?? new();
    var projectPics = ViewBag.ProjectPics as List<(string Url, string Label)> ?? new();
    var materialsCost = materials.Sum(m => (m.QuantityOut - m.QuantityIn) * m.UnitCost);
    var margin = saleValue - materialsCost - expensesTotal;
    var printReceiptId = TempData["PrintReceiptId"] as string;
}

@if (printReceiptId != null)
{
    <div class="alert alert-success border-0 rounded-3 d-flex align-items-center justify-content-between gap-2 mb-4">
        <span><i class="fa-solid fa-receipt me-2"></i> تم حفظ إيصال القبض.</span>
        <a asp-controller="Payments" asp-action="Receipt" asp-route-id="@printReceiptId" target="_blank" class="btn btn-sm btn-success fw-bold">
            <i class="fa-solid fa-print me-1"></i> طباعة الإيصال
        </a>
    </div>
}

<!-- Page Header Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">المشاريع والأوامر</a></li>
                <li class="breadcrumb-item active" aria-current="page">تفاصيل المشروع</li>
            </ol>
        </nav>
        <h2 class="page-header-title mb-0 d-flex flex-wrap align-items-center gap-2">
            <i class="fa-solid fa-kitchen-set text-primary"></i>
            <span>@Model.ProjectName</span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill" style="font-size:0.8rem;">
                @Model.ProjectNo
            </span>
            <partial name="_StatusBadge" model="Model.Status" />
        </h2>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="SpecSheet" asp-route-id="@Model.Id" target="_blank" class="btn btn-dark fw-bold rounded-3" title="ورقة المواصفات للمصمم والعميل">
            <i class="fa-solid fa-print me-1"></i> ورقة المواصفات
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-pen-to-square"></i>
            <span>تعديل</span>
        </a>
        @if (Model.Status != ProjectStatus.Cancelled && AppRoles.CanAccess(User, "Projects", "Cancel"))
        {
            <button type="button" class="btn btn-outline-warning fw-bold rounded-3" data-bs-toggle="modal" data-bs-target="#cancelProjectModal">
                <i class="fa-solid fa-ban me-1"></i> إلغاء المشروع
            </button>
        }
        <button type="button" asp-permission="Delete" class="btn btn-outline-danger fw-bold rounded-3" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="fa-solid fa-trash-can"></i>
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3">
            <i class="fa-solid fa-arrow-right me-1"></i> القائمة
        </a>
    </div>
</div>

<!-- Workflow Stepper -->
<div class="custom-card p-4 mb-4">
    @if (Model.Status == ProjectStatus.Cancelled)
    {
        <div class="alert alert-danger border-0 rounded-3 mb-0 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
            <div class="d-flex align-items-start gap-2">
                <i class="fa-solid fa-ban fs-4 mt-1"></i>
                <div>
                    <div class="fw-bold">هذا المشروع ملغى</div>
                    @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                    {
                        <div class="small mt-1"><strong>السبب:</strong> @Model.CancellationReason</div>
                    }
                    @if (Model.CancellationFee > 0)
                    {
                        <div class="small mt-1">
                            <strong>رسوم الإلغاء على العميل:</strong> @Model.CancellationFee.ToString("N2")
                            @if (remaining > 0)
                            {
                                <span class="ms-2">(المتبقي للتحصيل: @remaining.ToString("N2"))</span>
                            }
                            else
                            {
                                <span class="badge bg-success ms-2">تم التحصيل بالكامل</span>
                            }
                        </div>
                    }
                </div>
            </div>
            @if (Model.CancellationFee > 0 && remaining > 0 && AppRoles.CanAccess(User, "Payments", "Create"))
            {
                <a asp-controller="Payments" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-sm btn-danger fw-bold flex-shrink-0">
                    <i class="fa-solid fa-hand-holding-dollar me-1"></i> تحصيل رسوم الإلغاء
                </a>
            }
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-start text-center overflow-auto gap-2">
            @for (int i = 0; i < stages.Length; i++)
            {
                var done = i < currentStage;
                var active = i == currentStage;
                <div class="flex-fill" style="min-width:80px;">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2 fw-bold
                                @(done ? "bg-success text-white" : active ? "bg-primary text-white shadow" : "bg-light text-muted border")"
                         style="width:38px; height:38px;">
                        @if (done)
                        {
                            <i class="fa-solid fa-check"></i>
                        }
                        else
                        {
                            @(i + 1)
                        }
                    </div>
                    <div class="small @(active ? "fw-bold text-primary" : done ? "text-success" : "text-muted")">
                        @stages[i].GetDisplayName()
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="row g-4">
    <!-- Project Info Card -->
    <div class="col-12 col-lg-5 col-xl-4">
        <div class="custom-card p-4 h-100">
            <h5 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-circle-info text-primary me-2"></i> بيانات المشروع</h5>

            <div class="d-flex flex-column gap-3 fs-6">
                <div>
                    <span class="text-muted d-block small fw-bold">العميل</span>
                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-bold text-dark text-decoration-none">
                        <i class="fa-solid fa-user me-2 text-primary"></i>@Model.Customer?.Name
                    </a>
                    <small class="d-block text-muted ms-4">@Model.Customer?.Phone</small>
                </div>

                <div>
                    <span class="text-muted d-block small fw-bold">نوع المطبخ</span>
                    <span class="fw-semibold text-dark">
                        <i class="fa-solid fa-layer-group me-2 text-info"></i>
                        @(string.IsNullOrEmpty(Model.KitchenType) ? "غير محدد" : Model.KitchenType)
                    </span>
                </div>

                <div>
                    <span class="text-muted d-block small fw-bold">عنوان التركيب</span>
                    <span class="fw-semibold text-dark">
                        <i class="fa-solid fa-location-dot me-2 text-danger"></i>
                        @(string.IsNullOrEmpty(Model.Address) ? "غير مسجل" : Model.Address)
                    </span>
                </div>

                <div class="pt-3 border-top">
                    <span class="text-muted d-block small fw-bold mb-2">فريق العمل</span>
                    <div class="d-flex flex-column gap-2 small">
                        <span><i class="fa-solid fa-handshake me-2 text-warning"></i> المبيعات: <strong>@(Model.SalesUser?.UserName ?? "غير محدد")</strong></span>
                        <span><i class="fa-solid fa-helmet-safety me-2 text-success"></i> المهندس: <strong>@(Model.EngineerUser?.UserName ?? "غير محدد")</strong></span>
                        <span><i class="fa-solid fa-pen-ruler me-2 text-primary"></i> المصمم: <strong>@(Model.DesignerUser?.UserName ?? "غير محدد")</strong></span>
                    </div>
                </div>

                <div class="pt-3 border-top">
                    <span class="text-muted d-block small fw-bold mb-2">المواعيد</span>
                    <div class="d-flex flex-column gap-2 small">
                        <span><i class="fa-solid fa-calendar-plus me-2 text-muted"></i> الإنشاء: <strong>@Model.Created.ToLocalTime().ToString("yyyy/MM/dd")</strong></span>
                        <span><i class="fa-solid fa-play me-2 text-muted"></i> البدء: <strong>@(Model.StartDate?.ToString("yyyy/MM/dd") ?? "-")</strong></span>
                        <span><i class="fa-solid fa-flag-checkered me-2 text-muted"></i> التسليم المتوقع: <strong>@(Model.ExpectedDeliveryDate?.ToString("yyyy/MM/dd") ?? "-")</strong></span>
                        @if (Model.DeliveredAt.HasValue)
                        {
                            <span><i class="fa-solid fa-truck-ramp-box me-2 text-success"></i> تم التسليم: <strong>@Model.DeliveredAt.Value.ToString("yyyy/MM/dd")</strong></span>
                        }
                        @if (Model.ClosedAt.HasValue)
                        {
                            <span><i class="fa-solid fa-lock me-2 text-dark"></i> الإغلاق: <strong>@Model.ClosedAt.Value.ToString("yyyy/MM/dd")</strong></span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="pt-3 border-top">
                        <span class="text-muted d-block small fw-bold mb-1">ملاحظات</span>
                        <p class="bg-light p-3 rounded-3 text-secondary small mb-0" style="white-space:pre-line;">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Side: Financials & Related Records -->
    <div class="col-12 col-lg-7 col-xl-8">
        <!-- Financial Summary -->
        <div class="custom-card p-4 mb-4">
            <h5 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-coins text-warning me-2"></i> الملخص المالي</h5>
            <div class="row g-3 mb-3">
                <div class="col-6 col-md">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <span class="text-muted d-block small fw-bold">قيمة المشروع</span>
                        <span class="fw-bold fs-5 text-dark">@saleValue.ToString("N2")</span>
                        <small class="d-block text-muted" style="font-size:0.72rem;">
                            @(Model.Status == ProjectStatus.Cancelled
                                ? (contractsTotal > 0 ? "من العقود" : Model.CancellationFee > 0 ? "رسوم إلغاء على العميل" : "ملغى بدون رسوم")
                                : (contractsTotal > 0 ? "من العقود" : Model.FinalAmount > 0 ? "القيمة النهائية" : "القيمة التقديرية"))
                        </small>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="bg-success-subtle rounded-3 p-3 h-100">
                        <span class="text-muted d-block small fw-bold">المحصّل</span>
                        <span class="fw-bold fs-5 text-success">@paidTotal.ToString("N2")</span>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="bg-danger-subtle rounded-3 p-3 h-100">
                        <span class="text-muted d-block small fw-bold">المتبقي</span>
                        <span class="fw-bold fs-5 text-danger">@remaining.ToString("N2")</span>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="bg-warning-subtle rounded-3 p-3 h-100">
                        <span class="text-muted d-block small fw-bold">تكلفة الخامات</span>
                        <span class="fw-bold fs-5 text-warning-emphasis">@materialsCost.ToString("N2")</span>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="bg-warning-subtle rounded-3 p-3 h-100">
                        <span class="text-muted d-block small fw-bold">المصروفات</span>
                        <span class="fw-bold fs-5 text-warning-emphasis">@expensesTotal.ToString("N2")</span>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center bg-light rounded-3 px-3 py-2 mb-3">
                <span class="small fw-bold text-muted">الهامش المبدئي (القيمة - الخامات - المصروفات)</span>
                <span class="fw-bold @(margin >= 0 ? "text-success" : "text-danger")">@margin.ToString("N2")</span>
            </div>
            @if (materialsCost <= 0 && (Model.Status == ProjectStatus.Contracted || Model.Status == ProjectStatus.InProgress || Model.Status == ProjectStatus.Delivered || Model.Status == ProjectStatus.Closed))
            {
                <div class="alert alert-warning border-0 rounded-3 small d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
                    <div>
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        <strong>تنبيه تكلفة:</strong> لم يُسجّل صرف أي خامات أو إكسسوارات لهذا المشروع من المخزن حتى الآن — الربح المعروض أعلاه غير مكتمل قبل خصم الخامات.
                    </div>
                    @if (AppRoles.CanAccess(User, "Stock", "Issue"))
                    {
                        <a asp-controller="Stock" asp-action="Issue" asp-route-projectId="@Model.Id" asp-route-fromQuote="true" class="btn btn-sm btn-warning fw-bold flex-shrink-0">
                            <i class="fa-solid fa-dolly me-1"></i> صرف أصناف العرض الآن
                        </a>
                    }
                </div>
            }
            <div class="d-flex flex-wrap gap-2 mb-3">
                @if (AppRoles.CanAccess(User, "Expenses", "Create"))
                {
                    <a asp-controller="Expenses" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-sm btn-outline-danger fw-bold"><i class="fa-solid fa-money-bill-transfer me-1"></i> تسجيل مصروف</a>
                }
                @if (AppRoles.CanAccess(User, "Reports", "CostSheet"))
                {
                    <a asp-controller="Reports" asp-action="CostSheet" asp-route-id="@Model.Id" target="_blank" class="btn btn-sm btn-outline-secondary fw-bold"><i class="fa-solid fa-print me-1"></i> فاتورة التكلفة والمقارنة</a>
                }
            </div>
            @if (Model.Expenses.Any())
            {
                <div class="small mb-3">
                    @foreach (var e in Model.Expenses.OrderByDescending(e => e.ExpenseDate))
                    {
                        <div class="d-flex justify-content-between border-bottom py-1">
                            <span><span class="badge bg-light text-dark border">@e.ExpenseType</span> <span class="text-muted">@e.ExpenseDate.ToString("yyyy/MM/dd") @e.Description</span></span>
                            <strong class="text-danger">@e.Amount.ToString("N2")</strong>
                        </div>
                    }
                </div>
            }
            <div class="d-flex justify-content-between small text-muted mb-1">
                <span>نسبة التحصيل</span>
                <span class="fw-bold">@paidPercent%</span>
            </div>
            <div class="progress" style="height:8px;">
                <div class="progress-bar bg-success" style="width:@paidPercent%"></div>
            </div>
        </div>

        <!-- Project Images & 3D Designs Gallery -->
        <div class="custom-card mb-4">
            <div class="card-header-custom">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-images text-primary me-2"></i> صور التصميم والمخططات والموقع
                    <span class="badge bg-light text-dark border ms-1">@projectPics.Count</span>
                </h5>
            </div>
            <div class="p-4">
                @if (AppRoles.CanAccess(User, "Projects", "UploadPics"))
                {
                    <form asp-action="UploadPics" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="row g-2 align-items-center mb-3">
                        @Html.AntiForgeryToken()
                        <div class="col-12 col-sm-8 col-md-9">
                            <input type="file" name="files" multiple accept=".jpg,.jpeg,.png,.webp,.pdf" class="form-control form-control-sm" required />
                            <small class="text-muted" style="font-size:0.75rem;">يمكنك تحديد ورفع أكثر من صورة معاً (تصميم 3D، مخطط مقاسات، صور الموقع) — تُحفظ في <code>wwwroot/pic</code></small>
                        </div>
                        <div class="col-12 col-sm-4 col-md-3">
                            <button type="submit" class="btn btn-sm btn-primary fw-bold w-100">
                                <i class="fa-solid fa-cloud-arrow-up me-1"></i> رفع الصور
                            </button>
                        </div>
                    </form>
                }

                @if (projectPics.Any())
                {
                    <div class="row g-3">
                        @foreach (var item in projectPics)
                        {
                            var isPdf = item.Url.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                            <div class="col-6 col-md-4 col-xl-3">
                                <div class="border rounded-3 p-2 bg-light h-100 d-flex flex-column justify-content-between">
                                    <a href="@item.Url" target="_blank" class="text-decoration-none text-center d-block mb-2" title="اضغط للفتح بالحجم الكامل">
                                        @if (isPdf)
                                        {
                                            <div class="py-4 text-danger"><i class="fa-solid fa-file-pdf fa-3x"></i><div class="small mt-1 text-dark fw-bold">مخطط PDF</div></div>
                                        }
                                        else
                                        {
                                            <img src="@item.Url" alt="@item.Label" class="img-fluid rounded-2" style="height:130px; object-fit:cover; width:100%;" />
                                        }
                                    </a>
                                    <div class="d-flex justify-content-between align-items-center gap-1 mt-1">
                                        <span class="badge bg-white text-secondary border text-truncate" style="max-width:130px; font-size:0.7rem;" title="@item.Label">@item.Label</span>
                                        @if (AppRoles.CanAccess(User, "Projects", "DeletePic"))
                                        {
                                            <form asp-action="DeletePic" asp-route-id="@Model.Id" method="post" class="m-0" onsubmit="return confirm('حذف هذه الصورة نهائياً من المشروع؟')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="url" value="@item.Url" />
                                                <button type="submit" class="btn btn-sm btn-light border text-danger py-0 px-2" title="حذف الصورة"><i class="fa-solid fa-trash-can" style="font-size:0.75rem;"></i></button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small text-center py-2 mb-0">لا توجد صور تصميم أو مخططات مرفوعة لهذا المشروع بعد</p>
                }
            </div>
        </div>

        <!-- Site Visits -->
        <div class="custom-card mb-4">
            <div class="card-header-custom">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-ruler-combined text-info me-2"></i> المعاينات والمقاسات
                    <span class="badge bg-light text-dark border ms-1">@Model.SiteVisits.Count</span>
                </h5>
                <a asp-controller="SiteVisits" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-sm btn-outline-primary fw-bold">
                    <i class="fa-solid fa-plus me-1"></i> جدولة معاينة
                </a>
            </div>
            @if (Model.SiteVisits.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                            @foreach (var v in Model.SiteVisits.OrderByDescending(v => v.VisitDate))
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@v.VisitDate.ToString("yyyy/MM/dd hh:mm tt")</td>
                                    <td class="small text-muted">
                                        @if (v.Length.HasValue || v.Width.HasValue)
                                        {
                                            <span>@(v.Length?.ToString("0.##") ?? "-") × @(v.Width?.ToString("0.##") ?? "-") × @(v.Height?.ToString("0.##") ?? "-") سم</span>
                                        }
                                        else
                                        {
                                            <span>لم تُسجل المقاسات</span>
                                        }
                                    </td>
                                    <td><partial name="~/Views/SiteVisits/_StatusBadge.cshtml" model="v.Status" /></td>
                                    <td class="pe-4 text-end">
                                        <a asp-controller="SiteVisits" asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-light border text-primary"><i class="fa-solid fa-pen-to-square"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small text-center py-3 mb-0">لا توجد معاينات بعد</p>
            }
        </div>

        <!-- Quotes -->
        <div class="custom-card mb-4">
            <div class="card-header-custom">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-file-invoice-dollar text-warning me-2"></i> عروض الأسعار
                    <span class="badge bg-light text-dark border ms-1">@Model.Quotes.Count</span>
                </h5>
                <a asp-controller="Quotes" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-sm btn-outline-primary fw-bold">
                    <i class="fa-solid fa-plus me-1"></i> عرض سعر
                </a>
            </div>
            @if (Model.Quotes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                            @foreach (var q in Model.Quotes.OrderByDescending(q => q.Created))
                            {
                                <tr>
                                    <td class="ps-4"><a asp-controller="Quotes" asp-action="Details" asp-route-id="@q.Id" class="fw-bold">@q.QuoteNo</a></td>
                                    <td class="small text-muted">@q.Created.ToLocalTime().ToString("yyyy/MM/dd")</td>
                                    <td class="fw-bold">@q.Total.ToString("N2")</td>
                                    <td><partial name="~/Views/Quotes/_StatusBadge.cshtml" model="q.Status" /></td>
                                    <td class="pe-4 text-end">
                                        <a asp-controller="Quotes" asp-action="Print" asp-route-id="@q.Id" target="_blank" class="btn btn-sm btn-light border" title="طباعة"><i class="fa-solid fa-print"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small text-center py-3 mb-0">لا توجد عروض أسعار بعد</p>
            }
        </div>

        <!-- Contracts -->
        <div class="custom-card">
            <div class="card-header-custom">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-file-contract text-success me-2"></i> العقود
                    <span class="badge bg-light text-dark border ms-1">@Model.Contracts.Count</span>
                </h5>
                <a asp-controller="Contracts" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-sm btn-outline-primary fw-bold">
                    <i class="fa-solid fa-plus me-1"></i> عقد
                </a>
            </div>
            @if (Model.Contracts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                            @foreach (var c in Model.Contracts.OrderByDescending(c => c.Created))
                            {
                                <tr>
                                    <td class="ps-4"><a asp-controller="Contracts" asp-action="Details" asp-route-id="@c.Id" class="fw-bold">@c.ContractNo</a></td>
                                    <td class="fw-bold">@c.TotalAmount.ToString("N2")</td>
                                    <td class="small"><span class="text-success">@c.PaidAmount.ToString("N2")</span> مدفوع</td>
                                    <td><partial name="~/Views/Contracts/_StatusBadge.cshtml" model="c.Status" /></td>
                                    <td class="pe-4 text-end">
                                        <a asp-controller="Contracts" asp-action="Print" asp-route-id="@c.Id" target="_blank" class="btn btn-sm btn-light border" title="طباعة"><i class="fa-solid fa-print"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small text-center py-3 mb-0">لا توجد عقود بعد</p>
            }
        </div>

        <!-- Customer Payments -->
        <div class="custom-card mt-4">
            <div class="card-header-custom">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-wallet text-primary me-2"></i> دفعات العميل
                    <span class="badge bg-light text-dark border ms-1">@Model.CustomerPayments.Count</span>
                </h5>
                <div class="d-flex gap-2">
                    <a asp-controller="Payments" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-sm btn-outline-primary fw-bold">
                        <i class="fa-solid fa-plus me-1"></i> تسجيل دفعة
                    </a>
                    @if (paidTotal > 0)
                    {
                        <a asp-controller="Payments" asp-action="Create" asp-route-projectId="@Model.Id" asp-route-isRefund="true" class="btn btn-sm btn-outline-danger fw-bold">
                            <i class="fa-solid fa-rotate-left me-1"></i> سند إرجاع
                        </a>
                    }
                </div>
            </div>
            @if (Model.CustomerPayments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                            @foreach (var p in Model.CustomerPayments.OrderByDescending(p => p.PaymentDate))
                            {
                                var isBounced = p.Payment == PaymentMethod.Chek && p.ChequeStatus == ChequeStatus.Bounced;
                                <tr>
                                    <td class="ps-4 fw-bold">
                                        @p.ReceiptNo
                                        @if (p.IsRefund)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1">مرتجع</span>
                                        }
                                        @if (isBounced)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border ms-1">صك راجع</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@p.PaymentDate.ToString("yyyy/MM/dd")</td>
                                    <td class="small">@p.Payment.GetDisplayName()</td>
                                    <td class="small text-muted text-truncate" style="max-width:200px;">@p.Notes</td>
                                    <td class="fw-bold @(p.IsRefund ? "text-danger" : (isBounced ? "text-decoration-line-through text-muted" : "text-success"))">
                                        @(p.IsRefund ? "-" : "")@p.Amount.ToString("N2")
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a asp-controller="Payments" asp-action="Receipt" asp-route-id="@p.Id" target="_blank" class="btn btn-sm btn-light border" title="طباعة الإيصال"><i class="fa-solid fa-print"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small text-center py-3 mb-0">لم تُسجل دفعات بعد</p>
            }
        </div>

        <!-- Materials -->
        <div class="custom-card mt-4">
            <div class="card-header-custom">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-cubes text-warning me-2"></i> الخامات المصروفة
                    <span class="badge bg-light text-dark border ms-1">@materialsCost.ToString("N2")</span>
                </h5>
                <div class="d-flex gap-2">
                    @if (AppRoles.CanAccess(User, "MaterialRequests", "Create"))
                    {
                        <a asp-controller="MaterialRequests" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-sm btn-outline-primary fw-bold" title="طلب مواد للاعتماد">
                            <i class="fa-solid fa-clipboard-list me-1"></i> طلب مواد
                        </a>
                    }
                    @if (AppRoles.CanAccess(User, "Stock", "Issue"))
                    {
                        @if (Model.Quotes.Any())
                        {
                            <a asp-controller="Stock" asp-action="Issue" asp-route-projectId="@Model.Id" asp-route-fromQuote="true" class="btn btn-sm btn-warning fw-bold" title="صرف الإكسسوارات والخامات الواردة في عرض السعر مباشرة">
                                <i class="fa-solid fa-wand-magic-sparkles me-1"></i> صرف أصناف العرض
                            </a>
                        }
                        <a asp-controller="Stock" asp-action="Issue" asp-route-projectId="@Model.Id" class="btn btn-sm btn-outline-danger fw-bold">
                            <i class="fa-solid fa-dolly me-1"></i> صرف
                        </a>
                        <a asp-controller="Stock" asp-action="Issue" asp-route-projectId="@Model.Id" asp-route-type="Return" class="btn btn-sm btn-outline-info fw-bold">
                            <i class="fa-solid fa-rotate-left me-1"></i> مرتجع
                        </a>
                    }
                    @if (AppRoles.CanAccess(User, "Purchases", "Create"))
                    {
                        <a asp-controller="Purchases" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-sm btn-outline-success fw-bold" title="شراء خامات لهذا المشروع">
                            <i class="fa-solid fa-cart-plus"></i>
                        </a>
                    }
                </div>
            </div>
            @if (materials.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="bg-light text-muted small"><tr><th class="ps-4">التاريخ</th><th>الحركة</th><th>الخامة</th><th>الكمية</th><th class="pe-4">التكلفة</th></tr></thead>
                        <tbody>
                            @foreach (var m in materials)
                            {
                                var isReturn = m.QuantityIn > 0;
                                <tr>
                                    <td class="ps-4 small">@m.TransactionDate.ToString("yyyy/MM/dd") <small class="d-block text-muted">@m.ReferenceNo</small></td>
                                    <td><partial name="~/Views/Stock/_TypeBadge.cshtml" model="m.TransactionType" /></td>
                                    <td class="fw-semibold">@m.Items?.Name</td>
                                    <td>@((isReturn ? m.QuantityIn : m.QuantityOut).ToString("0.##")) @m.Items?.Unit</td>
                                    <td class="pe-4 fw-bold @(isReturn ? "text-success" : "")">@(isReturn ? "- " : "")@m.TotalCost.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small text-center py-3 mb-0">لم تُصرف خامات لهذا المشروع بعد</p>
            }

            @if (purchases.Any())
            {
                <div class="border-top px-4 py-3 small">
                    <span class="fw-bold text-muted d-block mb-2"><i class="fa-solid fa-cart-shopping me-1"></i> مشتريات مرتبطة بالمشروع</span>
                    @foreach (var p in purchases)
                    {
                        <div class="d-flex justify-content-between align-items-center py-1">
                            <span>
                                <a asp-controller="Purchases" asp-action="Details" asp-route-id="@p.Id" class="fw-bold">@p.PurchaseNo</a>
                                <span class="text-muted">· @p.Suppliers?.Name · @p.PurchaseDate.ToString("yyyy/MM/dd")</span>
                            </span>
                            <span class="d-flex align-items-center gap-2">
                                <strong>@p.Total.ToString("N2")</strong>
                                <partial name="~/Views/Purchases/_StatusBadge.cshtml" model="p.Status" />
                            </span>
                        </div>
                    }
                </div>
            }

            @if (requests.Any())
            {
                <div class="border-top px-4 py-3 small">
                    <span class="fw-bold text-muted d-block mb-2"><i class="fa-solid fa-clipboard-list me-1"></i> طلبات التوريد للمشروع</span>
                    @foreach (var r in requests)
                    {
                        <div class="d-flex justify-content-between align-items-center py-1">
                            <span>
                                <a asp-controller="MaterialRequests" asp-action="Details" asp-route-id="@r.Id" class="fw-bold">@r.RequestNo</a>
                                <span class="text-muted">· @r.RequestDate.ToString("yyyy/MM/dd") · @r.Items.Count صنف</span>
                            </span>
                            <partial name="~/Views/MaterialRequests/_StatusBadge.cshtml" model="r.Status" />
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 text-start">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> تأكيد حذف المشروع
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                هل أنت متأكد من رغبتك في حذف المشروع <strong>"(@Model.ProjectNo) @Model.ProjectName"</strong>؟
                <p class="text-muted small mb-0 mt-2">ملاحظة: سيتم حذف المعاينات المرتبطة به، ولا يمكن حذف مشروع عليه عقود أو دفعات.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">إلغاء</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger fw-bold">حذف نهائي</button>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.Status != ProjectStatus.Cancelled && AppRoles.CanAccess(User, "Projects", "Cancel"))
{
    <!-- Cancel Project Modal -->
    <div class="modal fade" id="cancelProjectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 text-start">
                <form asp-action="Cancel" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProjectId" value="@Model.Id" />
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-warning-emphasis">
                            <i class="fa-solid fa-ban text-danger me-2"></i> إلغاء المشروع (@Model.ProjectNo)
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-3">
                        <p class="text-muted small mb-3">
                            سيتم تحويل حالة المشروع <strong>"@Model.ProjectName"</strong> إلى <strong>ملغى</strong>.
                            جميع حقول الأتعاب أدناه <strong>اختيارية</strong> — اتركها فارغة أو صفراً إذا لم توجد أتعاب.
                        </p>

                        <div class="border rounded-3 p-3 mb-3 bg-light">
                            <h6 class="fw-bold mb-3 text-dark">
                                <i class="fa-solid fa-users-gear text-primary me-1"></i> 1. أتعاب الفريق (تُسجّل كمصروفات على المشروع)
                            </h6>
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <label class="form-label small fw-bold">
                                        أتعاب معاينة المهندس
                                        @if (!string.IsNullOrWhiteSpace(Model.EngineerUser?.UserName))
                                        {
                                            <span class="text-muted fw-normal">(@Model.EngineerUser.UserName)</span>
                                        }
                                    </label>
                                    <input type="number" name="EngineerFee" step="0.01" min="0" value="0" class="form-control" dir="ltr" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label small fw-bold">
                                        أتعاب المصمم
                                        @if (!string.IsNullOrWhiteSpace(Model.DesignerUser?.UserName))
                                        {
                                            <span class="text-muted fw-normal">(@Model.DesignerUser.UserName)</span>
                                        }
                                    </label>
                                    <input type="number" name="DesignerFee" step="0.01" min="0" value="0" class="form-control" dir="ltr" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label small fw-bold">طريقة صرف الأتعاب</label>
                                    <select name="PaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                                </div>
                            </div>
                        </div>

                        <div class="border rounded-3 p-3 mb-3">
                            <h6 class="fw-bold mb-2 text-dark">
                                <i class="fa-solid fa-hand-holding-dollar text-success me-1"></i> 2. رسوم إلغاء على العميل (اختياري)
                            </h6>
                            <div class="row g-3">
                                <div class="col-12 col-md-5">
                                    <label class="form-label small fw-bold">المبلغ المستحق على العميل</label>
                                    <input type="number" name="CustomerCancellationFee" step="0.01" min="0" value="0" class="form-control" dir="ltr" />
                                    <div class="form-text">يظهر كمبلغ مستحق للتحصيل من العميل رغم إلغاء المشروع.</div>
                                </div>
                                <div class="col-12 col-md-7">
                                    <label class="form-label small fw-bold">سبب الإلغاء / ملاحظات</label>
                                    <input type="text" name="CancellationReason" maxlength="500" class="form-control" placeholder="مثال: رفض العميل عرض السعر بعد المعاينة والتصميم" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">تراجع</button>
                        <button type="submit" class="btn btn-danger fw-bold">
                            <i class="fa-solid fa-ban me-1"></i> تأكيد إلغاء المشروع
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
