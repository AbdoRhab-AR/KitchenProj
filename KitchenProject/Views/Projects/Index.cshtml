@model IEnumerable<KitchenProject.Models.Entities.Project>
@{
    ViewData["Title"] = "المشاريع والأوامر";
    Layout = "_DashboardLayout";
}

<!-- Page Header & Title Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1">
            <i class="fa-solid fa-diagram-project text-primary me-2"></i> المشاريع والأوامر
        </h2>
        <p class="text-muted mb-0">متابعة مشاريع المطابخ من المعاينة حتى التسليم</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-folder-plus"></i>
            <span>مشروع جديد</span>
        </a>
    </div>
</div>

<!-- KPI Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="custom-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted fw-bold d-block mb-1" style="font-size:0.85rem;">إجمالي المشاريع</span>
                <h3 class="fw-extrabold mb-0 text-dark">@ViewBag.TotalProjectsCount</h3>
            </div>
            <div class="bg-primary-subtle text-primary rounded-3 p-3">
                <i class="fa-solid fa-folder-tree fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="custom-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted fw-bold d-block mb-1" style="font-size:0.85rem;">مشاريع مفتوحة</span>
                <h3 class="fw-extrabold mb-0 text-warning">@ViewBag.ActiveProjectsCount</h3>
            </div>
            <div class="bg-warning-subtle text-warning rounded-3 p-3">
                <i class="fa-solid fa-hourglass-half fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="custom-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted fw-bold d-block mb-1" style="font-size:0.85rem;">قيد التنفيذ</span>
                <h3 class="fw-extrabold mb-0 text-primary">@ViewBag.InProgressCount</h3>
            </div>
            <div class="bg-primary-subtle text-primary rounded-3 p-3">
                <i class="fa-solid fa-gears fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="custom-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted fw-bold d-block mb-1" style="font-size:0.85rem;">تم التسليم</span>
                <h3 class="fw-extrabold mb-0 text-success">@ViewBag.DeliveredCount</h3>
            </div>
            <div class="bg-success-subtle text-success rounded-3 p-3">
                <i class="fa-solid fa-truck-ramp-box fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="custom-card mb-4 p-3">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="searchString" class="form-control border-start-0 ps-0" placeholder="بحث بكود المشروع، الاسم، أو اسم/هاتف العميل..." value="@ViewBag.SearchString">
            </div>
        </div>
        <div class="col-12 col-md-3 col-lg-3">
            <select name="status" class="form-select" asp-items="ViewBag.StatusList">
                <option value="">كل الحالات</option>
            </select>
        </div>
        <div class="col-12 col-md-3 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary fw-bold px-4 rounded-3 flex-grow-1">
                <i class="fa-solid fa-search me-1"></i> بحث
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchString) || ViewBag.Status != null)
            {
                <a asp-action="Index" class="btn btn-light border fw-bold text-muted" title="إلغاء البحث">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Projects Data Table Card -->
<div class="custom-card">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-list text-secondary me-2"></i> قائمة المشاريع
        </h5>
        <span class="badge bg-light text-dark border">عدد النتائج: @ViewBag.TotalCount</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted" style="font-size:0.85rem;">
                <tr>
                    <th class="ps-4">كود المشروع</th>
                    <th>اسم المشروع</th>
                    <th>العميل</th>
                    <th>الحالة</th>
                    <th>القيمة</th>
                    <th>موعد التسليم</th>
                    <th class="text-center pe-4">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var amount = item.FinalAmount > 0 ? item.FinalAmount : item.EstimatedAmount;
                        var isLate = item.ExpectedDeliveryDate.HasValue
                                     && item.ExpectedDeliveryDate.Value.Date < DateTime.Today
                                     && item.Status < ProjectStatus.Delivered;
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-primary-subtle text-primary px-2 py-1 rounded-2">
                                    <i class="fa-solid fa-hashtag me-1"></i>@item.ProjectNo
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-dark text-decoration-none">
                                    @item.ProjectName
                                </a>
                                @if (!string.IsNullOrEmpty(item.KitchenType))
                                {
                                    <small class="d-block text-muted" style="font-size:0.78rem;">@item.KitchenType</small>
                                }
                            </td>
                            <td>
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-dark text-decoration-none fw-semibold">
                                    @item.Customer?.Name
                                </a>
                                <small class="d-block text-muted" style="font-size:0.78rem;">@item.Customer?.Phone</small>
                            </td>
                            <td><partial name="_StatusBadge" model="item.Status" /></td>
                            <td class="fw-semibold">
                                @(amount > 0 ? amount.ToString("N2") : "-")
                                @if (item.FinalAmount == 0 && item.EstimatedAmount > 0)
                                {
                                    <small class="d-block text-muted" style="font-size:0.72rem;">تقديري</small>
                                }
                            </td>
                            <td class="small @(isLate ? "text-danger fw-bold" : "text-muted")">
                                @(item.ExpectedDeliveryDate?.ToString("yyyy/MM/dd") ?? "-")
                                @if (isLate)
                                {
                                    <i class="fa-solid fa-triangle-exclamation ms-1" title="متأخر عن موعد التسليم"></i>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light border text-info" title="عرض التفاصيل">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light border text-primary" title="تعديل">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-folder-open display-4 mb-3 d-block text-secondary opacity-50"></i>
                            <h5 class="fw-bold mb-1">لا توجد مشاريع</h5>
                            <p class="text-muted small mb-3">ابدأ بإنشاء مشروع جديد لأحد العملاء</p>
                            <a asp-action="Create" class="btn btn-primary btn-sm fw-bold px-3 py-2 rounded-3">
                                <i class="fa-solid fa-plus me-1"></i> مشروع جديد
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top-0 d-flex align-items-center justify-content-between py-3 px-4">
            <small class="text-muted">الصفحة @ViewBag.CurrentPage من @ViewBag.TotalPages</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-searchString="@ViewBag.SearchString" asp-route-status="@ViewBag.Status">السابق</a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.SearchString" asp-route-status="@ViewBag.Status">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-searchString="@ViewBag.SearchString" asp-route-status="@ViewBag.Status">التالي</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
