@model ItemType
@if (Model == ItemType.Raw)
{
    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2 py-1 fw-bold"><i class="fa-solid fa-cubes me-1"></i>خام</span>
}
else
{
    <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 fw-bold"><i class="fa-solid fa-couch me-1"></i>جاهز</span>
}
