@model KitchenProject.Models.Entities.Contract
@using KitchenProject.Models.Interfaces
@inject IUnitOfWork<SiteInfo> SiteInfoUow
@{
    Layout = "_PrintLayout";
    ViewData["Title"] = "عقد " + Model.ContractNo;
    ViewData["DocTitle"] = "عقد تصنيع وتركيب مطبخ";
    ViewData["DocNo"] = Model.ContractNo;
    var companyName = SiteInfoUow.Entity.GetAll().Select(s => s.Name).FirstOrDefault();
    var customer = Model.Projects?.Customer;
}

<p class="mb-2">
    حُرر هذا العقد بتاريخ <strong>@((Model.StartDate ?? Model.Created.ToLocalTime()).ToString("yyyy/MM/dd"))</strong> بين كل من:
</p>

<div class="row g-2 mb-3">
    <div class="col-6">
        <div class="meta-box">
            <span class="label">الطرف الأول (الشركة)</span>
            <div class="fw-bold">@companyName</div>
        </div>
    </div>
    <div class="col-6">
        <div class="meta-box">
            <span class="label">الطرف الثاني (العميل)</span>
            <div class="fw-bold">@customer?.Name</div>
            <div class="small">@customer?.Phone</div>
            <div class="small text-muted">@(Model.Projects?.Address ?? customer?.Address)</div>
        </div>
    </div>
</div>

<div class="section-title">أولاً: موضوع العقد</div>
<p class="mb-1">
    يلتزم الطرف الأول بتصنيع وتوريد وتركيب مطبخ
    @if (!string.IsNullOrEmpty(Model.Projects?.KitchenType))
    {
        <span>(<strong>@Model.Projects.KitchenType</strong>)</span>
    }
    للطرف الثاني ضمن المشروع رقم <strong>@Model.Projects?.ProjectNo</strong> — @Model.Projects?.ProjectName،
    وفق المواصفات الفنية الموضحة أدناه.
</p>

@if (!string.IsNullOrWhiteSpace(Model.Specifications))
{
    <div class="section-title">ثانياً: المواصفات الفنية</div>
    <div class="pre-text border rounded p-2" style="line-height:1.9;">@Model.Specifications</div>
}

@if (Model.Quote != null && Model.Quote.Items.Any())
{
    <div class="section-title">ثالثاً: البنود (حسب عرض السعر @Model.Quote.QuoteNo)</div>
    <table class="table table-bordered print-table">
        <thead>
            <tr><th style="width:36px;">#</th><th>البيان</th><th style="width:90px;">الكمية</th><th style="width:110px;">الإجمالي</th></tr>
        </thead>
        <tbody>
            @{ var n = 1; }
            @foreach (var item in Model.Quote.Items.OrderBy(i => i.Created))
            {
                <tr>
                    <td>@(n++)</td>
                    <td>@item.Description</td>
                    <td>@item.Quantity.ToString("0.##") @item.Unit</td>
                    <td>@item.Total.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="no-break">
    <div class="section-title">القيمة ومدة التنفيذ</div>
    <table class="table table-bordered mb-2" style="max-width:100%;">
        <tr>
            <td class="fw-bold bg-light" style="width:30%;">قيمة العقد الإجمالية</td>
            <td class="fw-bold" style="color:var(--brand);">@Model.TotalAmount.ToString("N2") د.ل</td>
        </tr>
        <tr>
            <td class="fw-bold bg-light">تاريخ البدء</td>
            <td>@(Model.StartDate?.ToString("yyyy/MM/dd") ?? "-")</td>
        </tr>
        <tr>
            <td class="fw-bold bg-light">موعد التسليم المتوقع</td>
            <td>@(Model.ExpectedEndDate?.ToString("yyyy/MM/dd") ?? "-")</td>
        </tr>
    </table>
</div>

@if (!string.IsNullOrEmpty(Model.Notes))
{
    <div class="section-title">شروط إضافية</div>
    <div class="pre-text small">@Model.Notes</div>
}

<div class="signatures">
    <div>الطرف الأول<br /><small class="fw-normal text-muted">الختم والتوقيع</small></div>
    <div>الطرف الثاني<br /><small class="fw-normal text-muted">@customer?.Name</small></div>
</div>
