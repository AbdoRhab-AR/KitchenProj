@model KitchenProject.Models.Entities.Customer
@{
    ViewData["Title"] = "إضافة عميل جديد";
    Layout = "_DashboardLayout";
}

<!-- Page Header Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">إدارة العملاء</a></li>
                <li class="breadcrumb-item active" aria-current="page">عميل جديد</li>
            </ol>
        </nav>
        <h2 class="page-header-title mb-0">
            <i class="fa-solid fa-user-plus text-primary me-2"></i> إضافة عميل جديد
        </h2>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3">
            <i class="fa-solid fa-arrow-right me-1"></i> العودة للقائمة
        </a>
    </div>
</div>

<!-- Form Card -->
<div class="row justify-content-center">
    <div class="col-12 col-lg-10 col-xl-9">
        <div class="custom-card p-4 p-md-5">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                <div class="row g-4">
                    <!-- Customer Code (Auto Generated) -->
                    <div class="col-12 col-md-6">
                        <label asp-for="CustomerNo" class="form-label fw-bold">كود العميل <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-hashtag text-muted"></i></span>
                            <input asp-for="CustomerNo" class="form-control bg-light border-start-0 fw-bold text-primary" readonly />
                        </div>
                        <span asp-validation-for="CustomerNo" class="text-danger small"></span>
                    </div>

                    <!-- Customer Name -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label fw-bold">اسم العميل بالكامل <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                            <input asp-for="Name" class="form-control border-start-0" placeholder="أدخل اسم العميل الثلاثي..." />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Primary Phone -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Phone" class="form-label fw-bold">رقم الهاتف الرئيسي <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-phone text-muted"></i></span>
                            <input asp-for="Phone" class="form-control border-start-0" placeholder="مثال: 01012345678" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <!-- Secondary Phone -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Phone2" class="form-label fw-bold">رقم هاتف إضافي (اختياري)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-mobile-screen-button text-muted"></i></span>
                            <input asp-for="Phone2" class="form-control border-start-0" placeholder="رقم آخر للتواصل أو الواتساب..." />
                        </div>
                        <span asp-validation-for="Phone2" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label fw-bold">البريد الإلكتروني (اختياري)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                            <input asp-for="Email" type="email" class="form-control border-start-0" placeholder="example@domain.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- City -->
                    <div class="col-12 col-md-6">
                        <label asp-for="City" class="form-label fw-bold">المدينة / المنطقة</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-city text-muted"></i></span>
                            <input asp-for="City" class="form-control border-start-0" placeholder="مثال: القاهرة / المعادي..." />
                        </div>
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>

                    <!-- Detailed Address -->
                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-bold">العنوان التفصيلي (مكان المطبخ)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-location-dot text-muted"></i></span>
                            <input asp-for="Address" class="form-control border-start-0" placeholder="رقم العمارة، الشارع، الشقة، الدور..." />
                        </div>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <!-- Notes -->
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-bold">ملاحظات واهتمامات العميل</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="سجل تفاصيل اهتمام العميل (نوع المطبخ المطلوب، الميزانية المتوقعة، تفضيلات الألوان، إلخ)..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4 text-muted opacity-25">

                <!-- Submit Buttons -->
                <div class="d-flex align-items-center justify-content-end gap-3">
                    <a asp-action="Index" class="btn btn-light border fw-bold px-4 rounded-3">إلغاء</a>
                    <button type="submit" class="btn btn-primary-custom px-5 py-2 fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i> حفظ العميل
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
