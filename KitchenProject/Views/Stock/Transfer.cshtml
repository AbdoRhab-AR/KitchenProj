@model StockTransferViewModel
@{
    ViewData["Title"] = "تحويل بين المخازن";
    Layout = "_DashboardLayout";
    var options = (List<ItemOption>)ViewBag.ItemOptions;
    var balances = (Dictionary<Guid, Dictionary<Guid, decimal>>)ViewBag.BalancesByWarehouse;
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    string ItemSelect(Guid selected) =>
        "<option value=\"\">-- اختر الخامة --</option>" + string.Concat(options.Select(o =>
            $"<option value=\"{o.Id}\" data-unit=\"{System.Net.WebUtility.HtmlEncode(o.Unit)}\"{(o.Id == selected ? " selected" : "")}>{System.Net.WebUtility.HtmlEncode(o.Code + " - " + o.Name)}</option>"));

    if (Model.Lines.Count == 0)
    {
        Model.Lines.Add(new StockIssueLine());
    }
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">المخزن</a></li>
                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
            </ol>
        </nav>
        <h2 class="page-header-title mb-0">
            <i class="fa-solid fa-right-left text-primary me-2"></i> @ViewData["Title"]
        </h2>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3"><i class="fa-solid fa-arrow-right me-1"></i> المخزن</a>
    </div>
</div>

<div class="custom-card p-4 p-md-5">
    <form asp-action="Transfer" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-md-4">
                <label asp-for="FromWarehouseId" class="form-label fw-bold">من مخزن <span class="text-danger">*</span></label>
                <select asp-for="FromWarehouseId" asp-items="ViewBag.FromWarehouses" class="form-select" id="fromWarehouse"></select>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="ToWarehouseId" class="form-label fw-bold">إلى مخزن <span class="text-danger">*</span></label>
                <select asp-for="ToWarehouseId" asp-items="ViewBag.ToWarehouses" class="form-select">
                    <option value="">-- اختر المخزن --</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label asp-for="Date" class="form-label fw-bold">التاريخ</label>
                <input asp-for="Date" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
            </div>
        </div>

        <h6 class="fw-bold text-muted mb-3"><i class="fa-solid fa-cubes me-2"></i> الخامات المحوّلة</h6>
        <div class="table-responsive mb-2">
            <table class="table align-middle mb-0" id="linesTable">
                <thead class="bg-light text-muted" style="font-size:0.85rem;">
                    <tr>
                        <th style="width:40px;">#</th>
                        <th>الخامة</th>
                        <th style="width:150px;">المتوفر في المصدر</th>
                        <th style="width:140px;">الكمية</th>
                        <th style="width:50px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr class="line-row">
                            <td class="row-no text-muted fw-bold">@(i + 1)</td>
                            <td><select name="Lines[@i].ItemId" class="form-select form-select-sm item-select">@Html.Raw(ItemSelect(Model.Lines[i].ItemId))</select></td>
                            <td class="balance small fw-bold"></td>
                            <td><input name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity.ToString("0.##", inv)" type="number" step="0.01" min="0.01" class="form-control form-control-sm qty" /></td>
                            <td><button type="button" class="btn btn-sm btn-light border text-danger remove-row" title="حذف السطر"><i class="fa-solid fa-xmark"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary fw-bold mb-4" id="addRow">
            <i class="fa-solid fa-plus me-1"></i> إضافة سطر
        </button>

        <div class="mb-2">
            <label asp-for="Notes" class="form-label fw-bold">ملاحظات</label>
            <input asp-for="Notes" class="form-control" placeholder="سبب التحويل / اسم المستلم" />
        </div>

        <p class="small text-muted mb-0">
            <i class="fa-solid fa-circle-info me-1"></i>
            يُسجل التحويل كحركتين برقم واحد: صادر من المخزن الأول ووارد إلى الثاني، وحذف إحداهما يحذف الاثنتين.
        </p>

        <hr class="my-4 text-muted opacity-25">
        <div class="d-flex align-items-center justify-content-end gap-3">
            <a asp-action="Index" class="btn btn-light border fw-bold px-4 rounded-3">إلغاء</a>
            <button type="submit" class="btn btn-primary-custom px-5 py-2 fw-bold">
                <i class="fa-solid fa-floppy-disk me-1"></i> تسجيل التحويل
            </button>
        </div>
    </form>
</div>

<template id="rowTemplate">
    <tr class="line-row">
        <td class="row-no text-muted fw-bold"></td>
        <td><select data-field="ItemId" class="form-select form-select-sm item-select">@Html.Raw(ItemSelect(Guid.Empty))</select></td>
        <td class="balance small fw-bold"></td>
        <td><input data-field="Quantity" value="1" type="number" step="0.01" min="0.01" class="form-control form-control-sm qty" /></td>
        <td><button type="button" class="btn btn-sm btn-light border text-danger remove-row" title="حذف السطر"><i class="fa-solid fa-xmark"></i></button></td>
    </tr>
</template>

<script>
    (function () {
        const tbody = document.querySelector('#linesTable tbody');
        const fromSelect = document.getElementById('fromWarehouse');
        // { warehouseId: { itemId: balance } }
        const balances = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(balances));

        function renumber() {
            tbody.querySelectorAll('tr.line-row').forEach((tr, i) => {
                tr.querySelector('.row-no').textContent = i + 1;
                tr.querySelectorAll('input, select').forEach(input => {
                    const field = input.dataset.field || input.name.replace(/^Lines\[\d+\]\./, '');
                    input.dataset.field = field;
                    input.name = `Lines[${i}].${field}`;
                });
            });
        }

        // يعرض رصيد المخزن المصدر ويلوّن الكمية إذا تجاوزته
        function refresh(tr) {
            const opt = tr.querySelector('.item-select').selectedOptions[0];
            const cell = tr.querySelector('.balance');
            const qty = parseFloat(tr.querySelector('.qty').value) || 0;
            if (!opt || !opt.value) { cell.textContent = ''; tr.querySelector('.qty').classList.remove('is-invalid'); return; }
            const balance = (balances[fromSelect.value] || {})[opt.value] || 0;
            cell.textContent = `${balance} ${opt.dataset.unit}`;
            const over = qty > balance;
            cell.className = 'balance small fw-bold ' + (over ? 'text-danger' : 'text-success');
            tr.querySelector('.qty').classList.toggle('is-invalid', over);
        }

        const refreshAll = () => tbody.querySelectorAll('tr.line-row').forEach(refresh);

        document.getElementById('addRow').addEventListener('click', () => {
            tbody.appendChild(document.getElementById('rowTemplate').content.cloneNode(true));
            renumber();
            tbody.lastElementChild.querySelector('select').focus();
        });

        tbody.addEventListener('click', e => {
            const btn = e.target.closest('.remove-row');
            if (!btn) return;
            if (tbody.querySelectorAll('tr.line-row').length > 1) {
                btn.closest('tr').remove();
            } else {
                btn.closest('tr').querySelector('select').value = '';
                refresh(btn.closest('tr'));
            }
            renumber();
        });

        tbody.addEventListener('change', e => { if (e.target.matches('.item-select')) refresh(e.target.closest('tr')); });
        tbody.addEventListener('input', e => { if (e.target.matches('.qty')) refresh(e.target.closest('tr')); });
        fromSelect.addEventListener('change', refreshAll);

        refreshAll();
        renumber();
    })();
</script>
