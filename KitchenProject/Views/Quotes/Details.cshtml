@model KitchenProject.Models.Entities.Quote
@using KitchenProject.Models.Enums
@{
    var isFinal = Model.Type == ContractType.Final;
    var typeName = isFinal ? "فاتورة نهائية" : "فاتورة مبدئية";
    ViewData["Title"] = $"{typeName} - {Model.QuoteNo}";
    Layout = "_DashboardLayout";

    var received = (decimal)(ViewBag.ReceivedAmount ?? 0m);
    var finalQuote = ViewBag.FinalQuote as Quote;
    var sourceQuote = ViewBag.SourceQuote as Quote;
    var contract = ViewBag.Contract as Contract;
    var isApproved = Model.Status == DesignStatus.Approved;
    var items = Model.Items.OrderBy(i => i.SortOrder).ToList();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="page-header-title mb-0">@typeName</h2>
            <span class="badge bg-primary fs-6">@Model.QuoteNo</span>
        </div>
        <p class="text-muted mb-0">
            مشروع: <strong>@(Model.Project?.ProjectNo ?? "-")</strong>
            <span class="mx-2">•</span>
            الزبون: <strong>@(Model.Project?.Customer?.Name ?? "-")</strong>
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-dark fw-bold d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-print"></i><span>طباعة الفاتورة</span>
        </a>
        @if (!isApproved)
        {
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('تأكيد موافقة الزبون على الفاتورة؟');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success fw-bold d-inline-flex align-items-center gap-2">
                    <i class="fa-solid fa-thumbs-up"></i><span>موافقة الزبون</span>
                </button>
            </form>
        }
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-bold d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-pen"></i><span>تعديل الأصناف والأسعار</span>
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-arrow-right"></i><span>رجوع</span>
        </a>
    </div>
</div>

<!-- Status & Validity Banner -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <span class="badge @(isFinal ? "bg-success" : "bg-info text-dark") fs-6 px-4 py-2 rounded-pill">@typeName</span>
    @switch (Model.Status)
    {
        case DesignStatus.Draft:
            <span class="badge bg-secondary fs-6 px-4 py-2 rounded-pill">مسودة</span>
            break;
        case DesignStatus.WaitingApproval:
            <span class="badge bg-warning text-dark fs-6 px-4 py-2 rounded-pill">
                <i class="fa-solid fa-hourglass-half me-2"></i>بانتظار الموافقة
            </span>
            break;
        case DesignStatus.Approved:
            <span class="badge bg-success fs-6 px-4 py-2 rounded-pill">
                <i class="fa-solid fa-thumbs-up me-2"></i>موافقة
            </span>
            break;
        case DesignStatus.Rejected:
            <span class="badge bg-danger fs-6 px-4 py-2 rounded-pill">
                <i class="fa-solid fa-ban me-2"></i>مرفوض
            </span>
            break;
    }
    @if (Model.ValidUntil.HasValue)
    {
        var expired = Model.ValidUntil.Value < DateTime.Today;
        <span class="badge @(expired ? "bg-danger" : "bg-light text-dark border") fs-6 px-4 py-2 rounded-pill">
            <i class="fa-regular fa-calendar me-1"></i>
            صالحة حتى: @Model.ValidUntil.Value.ToString("yyyy/MM/dd")
            @if (expired) { <span>(منتهية الصلاحية)</span> }
        </span>
    }
    @if (sourceQuote != null)
    {
        <a asp-action="Details" asp-route-id="@sourceQuote.Id" class="badge bg-light text-primary border fs-6 px-4 py-2 rounded-pill text-decoration-none">
            <i class="fa-solid fa-link me-1"></i> من الفاتورة المبدئية @sourceQuote.QuoteNo
        </a>
    }
</div>

<!-- Next step in the workflow -->
@if (!isFinal && isApproved)
{
    <div class="alert alert-success d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        @if (finalQuote == null)
        {
            <div>
                <strong><i class="fa-solid fa-circle-check me-1"></i> وافق الزبون على الفاتورة المبدئية.</strong>
                <div class="small">الخطوة التالية: إنشاء الفاتورة النهائية (تنسخ الأصناف ويمكن تعديل الأسعار).</div>
            </div>
            <form asp-action="ConvertToFinal" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success fw-bold">
                    <i class="fa-solid fa-file-invoice-dollar me-1"></i> تحويل إلى فاتورة نهائية
                </button>
            </form>
        }
        else
        {
            <div>
                <strong><i class="fa-solid fa-circle-check me-1"></i> تم إنشاء الفاتورة النهائية @finalQuote.QuoteNo من هذه الفاتورة.</strong>
            </div>
            <a asp-action="Details" asp-route-id="@finalQuote.Id" class="btn btn-success fw-bold">
                <i class="fa-solid fa-arrow-left me-1"></i> فتح الفاتورة النهائية
            </a>
        }
    </div>
}
@if (isFinal && isApproved)
{
    <div class="alert alert-success mb-4">
        <strong><i class="fa-solid fa-circle-check me-1"></i> الفاتورة النهائية معتمدة.</strong>
        <div class="small mb-2">الخطوات التالية: إنشاء العقد النهائي ثم تحديد موعد مع الزبون.</div>
        <div class="d-flex flex-wrap gap-2">
            @if (contract == null)
            {
                <a asp-controller="Contracts" asp-action="Create" asp-route-projectId="@Model.ProjectId" asp-route-quoteId="@Model.Id"
                   class="btn btn-success fw-bold">
                    <i class="fa-solid fa-file-signature me-1"></i> إنشاء العقد النهائي
                </a>
            }
            else
            {
                <a asp-controller="Contracts" asp-action="Details" asp-route-id="@contract.Id" class="btn btn-outline-success fw-bold">
                    <i class="fa-solid fa-file-signature me-1"></i> العقد @contract.ContractNo
                </a>
            }
            <a asp-controller="SiteVisits" asp-action="Create" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-primary fw-bold">
                <i class="fa-regular fa-calendar-plus me-1"></i> تحديد موعد مع الزبون
            </a>
        </div>
    </div>
}

<!-- Items -->
<div class="custom-card p-4 mb-4">
    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
        <i class="fa-solid fa-list-ol me-2"></i> أصناف الفاتورة
    </h5>
    @if (items.Count == 0)
    {
        <p class="text-muted mb-0">لا توجد أصناف في هذه الفاتورة. <a asp-action="Edit" asp-route-id="@Model.Id">أضف الأصناف</a></p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:50px">ر.ق</th>
                        <th>البيان</th>
                        <th>الوحدة / م</th>
                        <th>الكمية</th>
                        <th>ثمن الوحدة</th>
                        <th>الإجمالي</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < items.Count; i++)
                    {
                        var item = items[i];
                        <tr>
                            <td class="text-center fw-bold">@(i + 1)</td>
                            <td>@item.Description</td>
                            <td>@(item.Meters?.ToString("0.0#") ?? "-")</td>
                            <td>@(item.Quantity?.ToString("0.##") ?? "-")</td>
                            <td>@item.UnitPrice.ToString("N2")</td>
                            <td class="fw-bold">@item.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="row g-4">
    <!-- Pricing Summary Card -->
    <div class="col-12 col-lg-5">
        <div class="custom-card h-100 p-4">
            <h5 class="fw-bold text-primary mb-4 border-bottom pb-2">
                <i class="fa-solid fa-calculator me-2"></i> ملخص الأسعار
            </h5>
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <span class="text-muted">إجمالي الأصناف</span>
                <strong class="text-dark">@Model.Subtotal.ToString("N2") د.ل</strong>
            </div>
            @if (Model.Discount > 0)
            {
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span class="text-muted">الخصم</span>
                    <strong class="text-danger">- @Model.Discount.ToString("N2") د.ل</strong>
                </div>
            }
            @if (Model.Tax > 0)
            {
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span class="text-muted">الضريبة</span>
                    <strong class="text-dark">+ @Model.Tax.ToString("N2") د.ل</strong>
                </div>
            }
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <span class="fw-bold">الإجمالي القيمة المستحقة</span>
                <strong class="text-success fs-5">@Model.Total.ToString("N2") د.ل</strong>
            </div>
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <span class="text-muted">القيمة المستلمة</span>
                <strong class="text-dark">@received.ToString("N2") د.ل</strong>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-3">
                <span class="fw-bold fs-5">صافي القيمة المستحقة</span>
                <strong class="text-danger fs-4">@((Model.Total - received).ToString("N2")) د.ل</strong>
            </div>
        </div>
    </div>

    <!-- Project Info Card -->
    <div class="col-12 col-lg-7">
        <div class="custom-card h-100 p-4">
            <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                <i class="fa-solid fa-diagram-project me-2"></i> بيانات المشروع والزبون
            </h5>
            <div class="row g-3">
                <div class="col-6">
                    <span class="text-muted d-block small">رقم المشروع</span>
                    <strong>
                        <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId"
                           class="text-primary text-decoration-none">@(Model.Project?.ProjectNo ?? "-")</a>
                    </strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small">اسم المشروع</span>
                    <strong>@(Model.Project?.ProjectName ?? "-")</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small">الزبون</span>
                    <strong><i class="fa-solid fa-user me-1 text-secondary"></i>@(Model.Project?.Customer?.Name ?? "-")</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small">هاتف الزبون</span>
                    <strong>@(Model.Project?.Customer?.Phone ?? "-")</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small">تاريخ الإنشاء</span>
                    <strong>@Model.Created.ToLocalTime().ToString("yyyy/MM/dd")</strong>
                </div>
                @if (Model.Modified.HasValue)
                {
                    <div class="col-6">
                        <span class="text-muted d-block small">آخر تعديل</span>
                        <strong>@Model.Modified.Value.ToLocalTime().ToString("yyyy/MM/dd")</strong>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="mt-3 border-top pt-3">
                    <span class="text-muted d-block small fw-bold mb-1">ملاحظات</span>
                    <p class="mb-0 text-dark bg-light p-3 rounded" style="white-space:pre-wrap;">@Model.Notes</p>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Terms))
            {
                <div class="mt-3 border-top pt-3">
                    <span class="text-muted d-block small fw-bold mb-1">الشروط</span>
                    <p class="mb-0 text-dark bg-light p-3 rounded" style="white-space:pre-wrap;">@Model.Terms</p>
                </div>
            }
        </div>
    </div>
</div>
