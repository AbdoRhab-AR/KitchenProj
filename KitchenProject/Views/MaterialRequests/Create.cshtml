@model KitchenProject.Models.Entities.MaterialRequest
@{
    ViewData["Title"] = "طلب مواد جديد";
    Layout = "_DashboardLayout";
    var options = (List<ItemOption>)ViewBag.ItemOptions;
    var balances = (Dictionary<Guid, decimal>)ViewBag.Balances;
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    string ItemSelect(Guid selected) =>
        "<option value=\"\">-- اختر الخامة --</option>" + string.Concat(options.Select(o =>
            $"<option value=\"{o.Id}\" data-unit=\"{System.Net.WebUtility.HtmlEncode(o.Unit)}\" data-balance=\"{balances.GetValueOrDefault(o.Id).ToString("0.##", inv)}\"{(o.Id == selected ? " selected" : "")}>{System.Net.WebUtility.HtmlEncode(o.Code + " - " + o.Name)}</option>"));

    if (Model.Items.Count == 0)
    {
        Model.Items.Add(new MaterialRequestItem());
    }
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">طلبات المواد</a></li>
                <li class="breadcrumb-item active" aria-current="page">طلب جديد</li>
            </ol>
        </nav>
        <h2 class="page-header-title mb-0">
            <i class="fa-solid fa-clipboard-list text-primary me-2"></i> @ViewData["Title"]
        </h2>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3"><i class="fa-solid fa-arrow-right me-1"></i> الطلبات</a>
    </div>
</div>

<div class="custom-card p-4 p-md-5">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-md-5">
                <label asp-for="ProjectId" class="form-label fw-bold">المشروع <span class="text-danger">*</span></label>
                <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
                    <option value="">-- اختر المشروع --</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="WarehouseId" class="form-label fw-bold">من مخزن</label>
                <select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select"></select>
            </div>
            <div class="col-6 col-md-2">
                <label asp-for="NeededBy" class="form-label fw-bold">مطلوب قبل</label>
                <input asp-for="NeededBy" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
            </div>
        </div>

        <h6 class="fw-bold text-muted mb-3"><i class="fa-solid fa-cubes me-2"></i> الخامات المطلوبة</h6>
        <div class="table-responsive mb-2">
            <table class="table align-middle mb-0" id="linesTable">
                <thead class="bg-light text-muted" style="font-size:0.85rem;">
                    <tr>
                        <th style="width:40px;">#</th>
                        <th>الخامة</th>
                        <th style="width:130px;">المتوفر حالياً</th>
                        <th style="width:130px;">الكمية</th>
                        <th style="width:220px;">ملاحظة</th>
                        <th style="width:50px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <tr class="line-row">
                            <td class="row-no text-muted fw-bold">@(i + 1)</td>
                            <td><select name="Items[@i].ItemId" class="form-select form-select-sm item-select">@Html.Raw(ItemSelect(Model.Items[i].ItemId))</select></td>
                            <td class="balance small fw-bold"></td>
                            <td><input name="Items[@i].Quantity" value="@Model.Items[i].Quantity.ToString("0.##", inv)" type="number" step="0.01" min="0.01" class="form-control form-control-sm qty" /></td>
                            <td><input name="Items[@i].Notes" value="@Model.Items[i].Notes" class="form-control form-control-sm" maxlength="250" placeholder="مقاس، لون..." /></td>
                            <td><button type="button" class="btn btn-sm btn-light border text-danger remove-row" title="حذف السطر"><i class="fa-solid fa-xmark"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary fw-bold mb-4" id="addRow">
            <i class="fa-solid fa-plus me-1"></i> إضافة سطر
        </button>

        <div class="mb-2">
            <label asp-for="Notes" class="form-label fw-bold">ملاحظات</label>
            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="مرحلة التنفيذ، سبب الطلب..."></textarea>
        </div>

        <p class="small text-muted mb-0">
            <i class="fa-solid fa-circle-info me-1"></i>
            يُرسل الطلب للمدير للاعتماد، ثم يصرفه أمين المخزن على المشروع. إذا كان الرصيد غير كافٍ يُحوَّل النقص إلى فاتورة شراء.
        </p>

        <hr class="my-4 text-muted opacity-25">
        <div class="d-flex align-items-center justify-content-end gap-3">
            <a asp-action="Index" class="btn btn-light border fw-bold px-4 rounded-3">إلغاء</a>
            <button type="submit" class="btn btn-primary-custom px-5 py-2 fw-bold">
                <i class="fa-solid fa-paper-plane me-1"></i> إرسال الطلب
            </button>
        </div>
    </form>
</div>

<template id="rowTemplate">
    <tr class="line-row">
        <td class="row-no text-muted fw-bold"></td>
        <td><select data-field="ItemId" class="form-select form-select-sm item-select">@Html.Raw(ItemSelect(Guid.Empty))</select></td>
        <td class="balance small fw-bold"></td>
        <td><input data-field="Quantity" value="1" type="number" step="0.01" min="0.01" class="form-control form-control-sm qty" /></td>
        <td><input data-field="Notes" class="form-control form-control-sm" maxlength="250" placeholder="مقاس، لون..." /></td>
        <td><button type="button" class="btn btn-sm btn-light border text-danger remove-row" title="حذف السطر"><i class="fa-solid fa-xmark"></i></button></td>
    </tr>
</template>

<script>
    (function () {
        const tbody = document.querySelector('#linesTable tbody');

        function renumber() {
            tbody.querySelectorAll('tr.line-row').forEach((tr, i) => {
                tr.querySelector('.row-no').textContent = i + 1;
                tr.querySelectorAll('input, select').forEach(input => {
                    const field = input.dataset.field || input.name.replace(/^Items\[\d+\]\./, '');
                    input.dataset.field = field;
                    input.name = `Items[${i}].${field}`;
                });
            });
        }

        // للعلم فقط: الطلب يُقبل حتى لو تجاوز الرصيد (النقص يُشترى)
        function refresh(tr) {
            const opt = tr.querySelector('.item-select').selectedOptions[0];
            const cell = tr.querySelector('.balance');
            if (!opt || !opt.value) { cell.textContent = ''; return; }
            const balance = parseFloat(opt.dataset.balance) || 0;
            const qty = parseFloat(tr.querySelector('.qty').value) || 0;
            cell.textContent = `${balance} ${opt.dataset.unit}`;
            cell.className = 'balance small fw-bold ' + (qty > balance ? 'text-warning' : 'text-success');
        }

        document.getElementById('addRow').addEventListener('click', () => {
            tbody.appendChild(document.getElementById('rowTemplate').content.cloneNode(true));
            renumber();
            tbody.lastElementChild.querySelector('select').focus();
        });

        tbody.addEventListener('click', e => {
            const btn = e.target.closest('.remove-row');
            if (!btn) return;
            if (tbody.querySelectorAll('tr.line-row').length > 1) {
                btn.closest('tr').remove();
            } else {
                btn.closest('tr').querySelector('select').value = '';
                refresh(btn.closest('tr'));
            }
            renumber();
        });

        tbody.addEventListener('change', e => { if (e.target.matches('.item-select')) refresh(e.target.closest('tr')); });
        tbody.addEventListener('input', e => { if (e.target.matches('.qty')) refresh(e.target.closest('tr')); });

        tbody.querySelectorAll('tr.line-row').forEach(refresh);
        renumber();
    })();
</script>
