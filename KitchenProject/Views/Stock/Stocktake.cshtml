@model List<StockRow>
@{
    ViewData["Title"] = "جرد وتسوية المخزن";
    Layout = "_DashboardLayout";
    var wid = (Guid)ViewBag.WarehouseId;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1"><i class="fa-solid fa-clipboard-check text-primary me-2"></i> جرد وتسوية المخزن</h2>
        <p class="text-muted mb-0">
            اطبع ورقة الجرد، عدّ الأصناف فعلياً، ثم أدخل الكميات هنا. يسجل النظام الفرق (زيادة أو عجز) كحركة تسوية بتكلفة الصنف،
            ويظهر أثرها تلقائياً في المحاسبة (فروقات المخزون). اترك الصنف فارغاً إن لم تعدّه.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="StocktakeSheet" asp-route-warehouseId="@wid" target="_blank" class="btn btn-light border fw-bold"><i class="fa-solid fa-print me-1"></i> ورقة جرد فارغة</a>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3"><i class="fa-solid fa-arrow-right me-1"></i> المخزن</a>
    </div>
</div>

<div class="custom-card mb-4 p-3">
    <form method="get" asp-action="Stocktake" class="row g-3 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label small fw-bold text-muted">المخزن</label>
            <select name="warehouseId" asp-items="ViewBag.Warehouses" class="form-select" onchange="this.form.submit()"></select>
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label small fw-bold text-muted">بحث في الأصناف</label>
            <input type="text" id="filter" class="form-control" placeholder="اسم أو كود الصنف..." autocomplete="off" />
        </div>
    </form>
</div>

<form asp-action="Stocktake" method="post" onsubmit="return confirm('سيتم تسجيل حركات تسوية لكل صنف يختلف عدّه عن رصيد النظام. متابعة؟')">
    @Html.AntiForgeryToken()
    <input type="hidden" name="warehouseId" value="@wid" />

    <div class="custom-card mb-3 p-3">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <label class="form-label small fw-bold text-muted">تاريخ الجرد</label>
                <input type="date" name="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required />
            </div>
            <div class="col-12 col-md-9">
                <label class="form-label small fw-bold text-muted">ملاحظات على الجرد</label>
                <input type="text" name="notes" class="form-control" maxlength="200" placeholder="جرد نهاية الشهر، تالف، خطأ عد..." />
            </div>
        </div>
    </div>

    <div class="custom-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="count-table">
                <thead class="bg-light text-muted" style="font-size:0.85rem;">
                    <tr>
                        <th class="ps-4">الكود</th>
                        <th>الصنف</th>
                        <th>الوحدة</th>
                        <th>رصيد النظام</th>
                        <th style="width:150px;">الكمية الفعلية</th>
                        <th>الفرق</th>
                        <th>قيمة الفرق</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr data-text="@(r.Item.Code + " " + r.Item.Name)" data-balance="@r.Balance.ToString("0.##", inv)" data-cost="@r.AverageCost.ToString("0.####", inv)">
                            <td class="ps-4 font-monospace small">@r.Item.Code</td>
                            <td class="fw-semibold">@r.Item.Name</td>
                            <td class="small text-muted">@r.Item.Unit</td>
                            <td class="fw-bold">@r.Balance.ToString("0.##")</td>
                            <td><input type="number" step="0.01" min="0" name="counts[@r.Item.Id]" class="form-control form-control-sm count" /></td>
                            <td class="diff fw-bold">-</td>
                            <td class="value small">-</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">لا توجد أصناف خام</td></tr>
                    }
                </tbody>
                <tfoot class="bg-light fw-bold">
                    <tr>
                        <td colspan="4" class="ps-4"><span id="counted-n">0</span> صنف تم عدّه</td>
                        <td colspan="2"><span id="diff-n" class="text-warning-emphasis">0</span> صنف به فرق</td>
                        <td id="total-value">0.00</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary-custom px-5 fw-bold"><i class="fa-solid fa-floppy-disk me-1"></i> تسجيل الجرد والتسوية</button>
        <a asp-action="Index" class="btn btn-light border fw-bold">إلغاء</a>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const rows = [...document.querySelectorAll('#count-table tbody tr[data-balance]')];

            function refresh() {
                let counted = 0, withDiff = 0, total = 0;
                rows.forEach(row => {
                    const input = row.querySelector('.count');
                    const diffEl = row.querySelector('.diff');
                    const valueEl = row.querySelector('.value');
                    if (input.value === '') {
                        diffEl.textContent = '-'; diffEl.className = 'diff fw-bold'; valueEl.textContent = '-';
                        return;
                    }
                    counted++;
                    const diff = Math.round(((parseFloat(input.value) || 0) - parseFloat(row.dataset.balance)) * 100) / 100;
                    const value = diff * parseFloat(row.dataset.cost);
                    if (diff !== 0) { withDiff++; total += value; }
                    diffEl.textContent = diff === 0 ? 'مطابق' : (diff > 0 ? 'زيادة ' + diff : 'عجز ' + (-diff));
                    diffEl.className = 'diff fw-bold ' + (diff === 0 ? 'text-success' : diff > 0 ? 'text-primary' : 'text-danger');
                    valueEl.textContent = diff === 0 ? '-' : value.toFixed(2);
                });
                document.getElementById('counted-n').textContent = counted;
                document.getElementById('diff-n').textContent = withDiff;
                document.getElementById('total-value').textContent = total.toFixed(2);
            }

            document.querySelector('#count-table').addEventListener('input', refresh);

            document.getElementById('filter').addEventListener('input', e => {
                const q = e.target.value.trim().toLowerCase();
                rows.forEach(r => r.style.display = !q || r.dataset.text.toLowerCase().includes(q) ? '' : 'none');
            });

            // Enter ينتقل للصنف التالي بدل إرسال النموذج
            document.querySelector('#count-table').addEventListener('keydown', e => {
                if (e.key === 'Enter' && e.target.classList.contains('count')) {
                    e.preventDefault();
                    const inputs = rows.filter(r => r.style.display !== 'none').map(r => r.querySelector('.count'));
                    const next = inputs[inputs.indexOf(e.target) + 1];
                    if (next) next.focus();
                }
            });
        })();
    </script>
}
