@model List<KitchenProject.Controllers.AccountingController.TrialRow>
@{
    Layout = "_PrintLayout";
    ViewData["Title"] = "ميزان المراجعة";
    ViewData["DocTitle"] = "ميزان المراجعة";
    DateTime? from = ViewBag.From;
    DateTime? to = ViewBag.To;
    var period = from.HasValue || to.HasValue
        ? $"{(from.HasValue ? from.Value.ToString("yyyy/MM/dd") : "البداية")} - {(to.HasValue ? to.Value.ToString("yyyy/MM/dd") : "اليوم")}"
        : "حتى اليوم";
    ViewData["DocNo"] = period;
    decimal D(decimal v) => v > 0 ? v : 0;
    decimal C(decimal v) => v < 0 ? -v : 0;
}

<table class="table table-bordered print-table">
    <thead>
        <tr>
            <th rowspan="2" style="width:9%">رقم</th>
            <th rowspan="2">الحساب</th>
            <th colspan="2" class="text-center">أول الفترة</th>
            <th colspan="2" class="text-center">حركة الفترة</th>
            <th colspan="2" class="text-center">آخر الفترة</th>
        </tr>
        <tr>
            <th>مدين</th><th>دائن</th>
            <th>مدين</th><th>دائن</th>
            <th>مدين</th><th>دائن</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td class="font-monospace small">@r.Account.Code</td>
                <td class="small">@r.Account.Name</td>
                <td class="text-start">@(D(r.Opening) == 0 ? "" : D(r.Opening).ToString("N2"))</td>
                <td class="text-start">@(C(r.Opening) == 0 ? "" : C(r.Opening).ToString("N2"))</td>
                <td class="text-start">@(r.Debit == 0 ? "" : r.Debit.ToString("N2"))</td>
                <td class="text-start">@(r.Credit == 0 ? "" : r.Credit.ToString("N2"))</td>
                <td class="text-start fw-bold">@(D(r.Closing) == 0 ? "" : D(r.Closing).ToString("N2"))</td>
                <td class="text-start fw-bold">@(C(r.Closing) == 0 ? "" : C(r.Closing).ToString("N2"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="fw-bold bg-light">
            <td colspan="2">الإجمالي</td>
            <td class="text-start">@Model.Sum(r => D(r.Opening)).ToString("N2")</td>
            <td class="text-start">@Model.Sum(r => C(r.Opening)).ToString("N2")</td>
            <td class="text-start">@Model.Sum(r => r.Debit).ToString("N2")</td>
            <td class="text-start">@Model.Sum(r => r.Credit).ToString("N2")</td>
            <td class="text-start">@Model.Sum(r => D(r.Closing)).ToString("N2")</td>
            <td class="text-start">@Model.Sum(r => C(r.Closing)).ToString("N2")</td>
        </tr>
    </tfoot>
</table>

<div class="small text-muted mt-2">طُبع بتاريخ @DateTime.Now.ToString("yyyy/MM/dd HH:mm") بواسطة @ViewBag.PrintedBy</div>

<div class="signatures mt-4">
    <div>المحاسب</div>
    <div>المراجع</div>
    <div>اعتماد الإدارة</div>
</div>
