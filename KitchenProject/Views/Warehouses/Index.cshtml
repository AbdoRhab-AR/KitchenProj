@model IEnumerable<KitchenProject.Models.Entities.Warehouse>
@{
    ViewData["Title"] = "المخازن";
    Layout = "_DashboardLayout";
    var stats = (Dictionary<Guid, (int Items, decimal Value)>)ViewBag.Stats;
}

<!-- Page Header Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1">
            <i class="fa-solid fa-warehouse text-primary me-2"></i> المخازن
        </h2>
        <p class="text-muted mb-0">أماكن تخزين الخامات. التحويل بين المخازن من شاشة المخزن.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Stock" asp-action="Transfer" class="btn btn-outline-primary fw-bold rounded-3">
            <i class="fa-solid fa-truck-arrow-right me-1"></i> تحويل بين المخازن
        </a>
        <a asp-controller="Stock" asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3">
            <i class="fa-solid fa-boxes-stacked me-1"></i> الأرصدة
        </a>
    </div>
</div>

<div class="row g-4">
    @foreach (var w in Model)
    {
        var s = stats.GetValueOrDefault(w.Id);
        <div class="col-12 col-md-6 col-xl-4">
            <div class="custom-card p-4 h-100 @(w.IsActive ? "" : "opacity-75")">
                <form asp-action="Save" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@w.Id" />
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="badge @(w.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") rounded-pill px-3 py-2 fw-bold">
                            @(w.IsActive ? "فعال" : "موقوف")
                        </span>
                        <a asp-controller="Stock" asp-action="Index" asp-route-warehouseId="@w.Id" class="badge bg-light text-dark border text-decoration-none">
                            @s.Items خامة · @s.Value.ToString("N2")
                        </a>
                    </div>
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">اسم المخزن</label>
                            <input name="Name" value="@w.Name" class="form-control" maxlength="100" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">الموقع</label>
                            <input name="Location" value="@w.Location" class="form-control" maxlength="250" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary-custom btn-sm fw-bold flex-grow-1">
                            <i class="fa-solid fa-floppy-disk me-1"></i> حفظ
                        </button>
                        <a asp-controller="Stock" asp-action="Movements" asp-route-warehouseId="@w.Id" class="btn btn-sm btn-outline-info fw-bold" title="كشف حركات المخزن">
                            <i class="fa-solid fa-right-left"></i>
                        </a>
                        <button type="submit" form="toggle-@w.Id" class="btn btn-sm @(w.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                title="@(w.IsActive ? "إيقاف المخزن" : "تفعيل المخزن")"
                                onclick="return confirm('@(w.IsActive ? "إيقاف" : "تفعيل") المخزن @w.Name؟')">
                            <i class="fa-solid @(w.IsActive ? "fa-ban" : "fa-circle-check")"></i>
                        </button>
                    </div>
                </form>
                <form id="toggle-@w.Id" asp-action="ToggleActive" asp-route-id="@w.Id" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </div>
    }

    <!-- New warehouse -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="custom-card p-4 h-100" style="border:2px dashed #dee2e6;">
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <h6 class="fw-bold text-muted mb-3"><i class="fa-solid fa-plus me-1"></i> مخزن جديد</h6>
                <div class="row g-2">
                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">اسم المخزن</label>
                        <input name="Name" class="form-control" maxlength="100" placeholder="مثال: مخزن الورشة" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">الموقع</label>
                        <input name="Location" class="form-control" maxlength="250" />
                    </div>
                </div>
                <button type="submit" class="btn btn-outline-primary btn-sm fw-bold w-100 mt-3">
                    <i class="fa-solid fa-plus me-1"></i> إضافة المخزن
                </button>
            </form>
        </div>
    </div>
</div>
