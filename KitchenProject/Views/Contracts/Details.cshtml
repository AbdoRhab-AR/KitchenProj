@model KitchenProject.Models.Entities.Contract
@{
    ViewData["Title"] = "العقد " + Model.ContractNo;
    Layout = "_DashboardLayout";
    var paidPercent = Model.TotalAmount > 0 ? (int)Math.Min(100, Math.Round(Model.PaidAmount / Model.TotalAmount * 100)) : 0;
}

<!-- Page Header Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">إدارة العقود</a></li>
                <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId" class="text-decoration-none">@Model.Projects?.ProjectName</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.ContractNo</li>
            </ol>
        </nav>
        <h2 class="page-header-title mb-0 d-flex flex-wrap align-items-center gap-2">
            <i class="fa-solid fa-file-contract text-primary"></i>
            <span>عقد @Model.ContractNo</span>
            <partial name="_StatusBadge" model="Model.Status" />
        </h2>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-dark fw-bold rounded-3">
            <i class="fa-solid fa-print me-1"></i> طباعة العقد
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-pen-to-square"></i> تعديل
        </a>
        <button type="button" class="btn btn-outline-danger fw-bold rounded-3" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="fa-solid fa-trash-can"></i>
        </button>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <!-- Specifications -->
        <div class="custom-card p-4 mb-4">
            <h5 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-clipboard-list text-primary me-2"></i> المواصفات الفنية</h5>
            @if (string.IsNullOrWhiteSpace(Model.Specifications))
            {
                <p class="text-muted mb-0">لم تُكتب مواصفات لهذا العقد بعد.</p>
            }
            else
            {
                <div class="bg-light rounded-3 p-3" style="white-space:pre-line; line-height:1.9;">@Model.Specifications</div>
            }
        </div>

        @if (Model.Quote != null)
        {
            <div class="custom-card mb-4">
                <div class="card-header-custom">
                    <h6 class="fw-bold mb-0"><i class="fa-solid fa-file-invoice-dollar text-success me-2"></i> بنود عرض السعر المعتمد</h6>
                    <a asp-controller="Quotes" asp-action="Details" asp-route-id="@Model.QuoteId" class="badge bg-success-subtle text-success text-decoration-none">@Model.Quote.QuoteNo</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="bg-light text-muted small"><tr><th class="ps-4">الوصف</th><th>الكمية</th><th>السعر</th><th class="pe-4">الإجمالي</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Quote.Items.OrderBy(i => i.Created))
                            {
                                <tr>
                                    <td class="ps-4">@item.Description</td>
                                    <td>@item.Quantity.ToString("0.##") @item.Unit</td>
                                    <td>@item.UnitPrice.ToString("N2")</td>
                                    <td class="pe-4 fw-bold">@item.Total.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="custom-card p-4">
                <h6 class="fw-bold mb-2"><i class="fa-solid fa-note-sticky text-warning me-2"></i> شروط إضافية / ملاحظات</h6>
                <p class="mb-0 text-secondary" style="white-space:pre-line;">@Model.Notes</p>
            </div>
        }
    </div>

    <div class="col-12 col-xl-4">
        <!-- Financial -->
        <div class="custom-card p-4 mb-4">
            <h6 class="fw-bold mb-3"><i class="fa-solid fa-coins text-warning me-2"></i> الموقف المالي</h6>
            <div class="d-flex justify-content-between mb-2"><span class="text-muted fw-bold">قيمة العقد</span><span class="fw-bold">@Model.TotalAmount.ToString("N2")</span></div>
            <div class="d-flex justify-content-between mb-2"><span class="text-muted fw-bold">المدفوع</span><span class="fw-bold text-success">@Model.PaidAmount.ToString("N2")</span></div>
            <div class="d-flex justify-content-between mb-3"><span class="text-muted fw-bold">المتبقي</span><span class="fw-bold text-danger">@Model.RemainingAmount.ToString("N2")</span></div>
            <div class="progress" style="height:8px;"><div class="progress-bar bg-success" style="width:@paidPercent%"></div></div>
            <small class="text-muted d-block mt-2">@paidPercent% محصّل — تسجيل الدفعات سيُضاف مع شاشة التحصيلات</small>
        </div>

        <!-- Info -->
        <div class="custom-card p-4">
            <h6 class="fw-bold mb-3"><i class="fa-solid fa-circle-info text-primary me-2"></i> بيانات العقد</h6>
            <div class="d-flex flex-column gap-2 small">
                <span>العميل: <strong>@Model.Projects?.Customer?.Name</strong></span>
                <span>الهاتف: <strong>@Model.Projects?.Customer?.Phone</strong></span>
                <span>المشروع: <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId" class="fw-bold">@Model.Projects?.ProjectNo</a></span>
                <span>تاريخ البدء: <strong>@(Model.StartDate?.ToString("yyyy/MM/dd") ?? "-")</strong></span>
                <span>موعد التسليم: <strong>@(Model.ExpectedEndDate?.ToString("yyyy/MM/dd") ?? "-")</strong></span>
                @if (!string.IsNullOrEmpty(Model.ContractFilePath))
                {
                    <a href="@Model.ContractFilePath" target="_blank" class="btn btn-sm btn-outline-secondary fw-bold mt-2">
                        <i class="fa-solid fa-paperclip me-1"></i> عرض النسخة الموقعة
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 text-start">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> تأكيد حذف العقد
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                هل أنت متأكد من حذف العقد <strong>@Model.ContractNo</strong>؟
                <p class="text-muted small mb-0 mt-2">لا يمكن حذف عقد عليه دفعات مسجلة.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">إلغاء</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger fw-bold">حذف نهائي</button>
                </form>
            </div>
        </div>
    </div>
</div>
