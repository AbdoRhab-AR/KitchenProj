@model KitchenProject.Models.Entities.Expense
@using KitchenProject.Models.Enums
@{
    ViewData["Title"] = "تفاصيل المصروف";
    Layout = "_DashboardLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1">
            <i class="fa-solid fa-file-invoice text-danger me-2"></i> تفاصيل المصروف
        </h2>
        <p class="text-muted mb-0">سند صرف مسجل في النظام</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2" onclick="window.print()">
            <i class="fa-solid fa-print"></i><span>طباعة السند</span>
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-arrow-right"></i><span>العودة للمصروفات</span>
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="custom-card p-5" id="printableArea">
            
            <div class="text-center mb-5 border-bottom pb-4">
                <h3 class="fw-bold mb-3">سند صرف</h3>
                <div class="d-flex justify-content-center gap-4 text-muted">
                    <span><strong>التاريخ:</strong> @Model.Created.ToString("dd/MM/yyyy HH:mm")</span>
                    <span><strong>نوع المصروف:</strong> @Model.ExpenseType</span>
                </div>
            </div>

            <div class="p-4 rounded-3 border bg-danger bg-opacity-10 text-danger mb-4 text-center">
                <h6 class="mb-2">صرفنا مبلغ وقدره</h6>
                <h1 class="display-5 fw-bold mb-0">@Model.Amount.ToString("N2") <span class="fs-4">د.ل</span></h1>
            </div>

            <div class="row mb-4 g-4">
                <div class="col-12">
                    <div class="bg-light p-4 rounded-3 border">
                        <h6 class="text-muted mb-2">وذلك نظير:</h6>
                        <h5 class="fw-bold mb-1">@(Model.Description ?? "بدون تفاصيل")</h5>
                    </div>
                </div>
                
                @if (Model.ProjectId.HasValue)
                {
                    <div class="col-12">
                        <div class="bg-light p-4 rounded-3 border">
                            <h6 class="text-muted mb-2">محمل على المشروع:</h6>
                            <h5 class="fw-bold mb-1 text-primary">@Model.Project?.ProjectName</h5>
                            <div class="text-muted small">
                                <i class="fa-solid fa-hashtag me-1"></i> رقم المشروع: @Model.Project?.ProjectNo
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="row mb-5">
                <div class="col-sm-6">
                    <h6 class="text-muted mb-2">طريقة الدفع:</h6>
                    <div class="fs-5">
                        <span class="badge bg-secondary">
                            @Html.DisplayFor(modelItem => Model.Payment)
                        </span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <h6 class="text-muted mb-2">ملاحظات:</h6>
                    <p class="fs-6 mb-0">@(string.IsNullOrWhiteSpace(Model.Notes) ? "لا توجد ملاحظات" : Model.Notes)</p>
                </div>
            </div>

            <div class="row mt-5 pt-5 border-top text-center printable-signatures">
                <div class="col-6">
                    <h6 class="text-muted mb-5">توقيع المستلم</h6>
                    <p>.......................................</p>
                </div>
                <div class="col-6">
                    <h6 class="text-muted mb-5">توقيع المحاسب / المدير</h6>
                    <p>.......................................</p>
                </div>
            </div>
            
        </div>
        
        <div class="d-flex justify-content-end gap-2 mt-4 d-print-none">
            @if (!string.IsNullOrEmpty(Model.AttachmentPath))
            {
                <a href="@Model.AttachmentPath" target="_blank" class="btn btn-outline-info px-4">
                    <i class="fa-solid fa-paperclip me-2"></i> استعراض المرفقات
                </a>
            }
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom px-4">
                <i class="fa-solid fa-pen me-2"></i> تعديل المصروف
            </a>
        </div>
    </div>
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        #printableArea, #printableArea * {
            visibility: visible;
        }
        #printableArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }
        .custom-card {
            border: none !important;
            box-shadow: none !important;
        }
        .printable-signatures {
            margin-top: 100px !important;
        }
    }
</style>
