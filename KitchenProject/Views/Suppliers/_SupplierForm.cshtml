@model KitchenProject.Models.Entities.Supplier

<div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

<div class="row g-4 mb-4">
    <div class="col-12 col-md-3">
        <label asp-for="SupplierNo" class="form-label fw-bold">رقم المورد</label>
        <input asp-for="SupplierNo" class="form-control bg-light fw-bold text-primary" readonly />
    </div>
    <div class="col-12 col-md-5">
        <label asp-for="Name" class="form-label fw-bold">اسم المورد <span class="text-danger">*</span></label>
        <input asp-for="Name" class="form-control" placeholder="اسم الشركة أو التاجر" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="Phone" class="form-label fw-bold">الهاتف</label>
        <input asp-for="Phone" class="form-control" dir="ltr" />
    </div>
    <div class="col-12 col-md-8">
        <label asp-for="Address" class="form-label fw-bold">العنوان</label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="PaymentTerms" class="form-label fw-bold">شروط الدفع</label>
        <input asp-for="PaymentTerms" class="form-control" placeholder="مثال: نقداً / آجل 30 يوم" />
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label fw-bold">ملاحظات</label>
        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="الخامات التي يوفرها، مسؤول التواصل..."></textarea>
    </div>
    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="IsActive" class="form-check-label fw-bold">مورد فعال</label>
        </div>
    </div>
</div>
