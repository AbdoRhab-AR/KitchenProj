<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - مصنع المطابخ الإحترافي</title>

    <!-- Bootstrap 5 RTL CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <!-- Google Fonts - Tajawal & Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #0f172a;
            --accent-color: #2563eb;
            --accent-hover: #1d4ed8;
            --secondary-color: #64748b;
            --bg-light: #f8fafc;
        }
        body {
            font-family: 'Cairo', 'Tajawal', sans-serif;
            background-color: var(--bg-light);
            color: #334155;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .main-navbar {
            background-color: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }
        .navbar-brand {
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--primary-color) !important;
        }
        .navbar-brand i {
            color: var(--accent-color);
        }
        .nav-link {
            font-weight: 600;
            color: #475569 !important;
            padding: 0.6rem 1rem !important;
            transition: all 0.2s ease;
        }
        .nav-link:hover {
            color: var(--accent-color) !important;
        }
        .btn-dashboard {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: white !important;
            font-weight: 700;
            padding: 0.55rem 1.4rem;
            border-radius: 50rem;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
            transition: all 0.3s ease;
        }
        .btn-dashboard:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);
        }
        main {
            flex: 1;
        }
        .public-footer {
            background-color: #0f172a;
            color: #94a3b8;
            padding: 2.5rem 0 1.5rem;
            margin-top: auto;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light main-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-kitchen-set me-2"></i> مطابخنا المحترفة
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i> الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#services"><i class="fa-solid fa-cubes me-1"></i> خدماتنا</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#gallery"><i class="fa-solid fa-images me-1"></i> معرض الأعمال</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#contact"><i class="fa-solid fa-headset me-1"></i> اتصل بنا</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Customers" asp-action="Index" class="btn btn-dashboard">
                            <i class="fa-solid fa-gauge-high me-1"></i> لوحة التحكم للنظام
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="container text-center">
            <p class="mb-1 fw-bold text-white"><i class="fa-solid fa-kitchen-set me-1 text-primary"></i> مصنع وتفصيل المطابخ الإحترافي</p>
            <small>&copy; @DateTime.Now.Year - جميع الحقوق محفوظة للنظام</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
