@model KitchenProject.Models.Entities.Quote
@{
    ViewData["Title"] = "فاتورة مبدئية جديدة";
    Layout = "_DashboardLayout";
    ViewData["FormAction"] = "Create";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1">
            <i class="fa-solid fa-plus-circle text-primary me-2"></i> فاتورة مبدئية جديدة
        </h2>
        <p class="text-muted mb-0">إنشاء فاتورة مبدئية بأصناف وأسعار وربطها بمشروع الزبون</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="fa-solid fa-arrow-right"></i><span>العودة للفواتير</span>
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="custom-card p-4">
            <partial name="_QuoteForm" model="Model" />
        </div>
    </div>
</div>
