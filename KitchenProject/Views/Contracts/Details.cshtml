@model KitchenProject.Models.Entities.Contract
@{
    ViewData["Title"] = $"تفاصيل العقد - {Model.ContractNo}";
    Layout = "_DashboardLayout";
    var paidPct = Model.TotalAmount > 0 ? (int)Math.Round(Model.PaidAmount / Model.TotalAmount * 100) : 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="page-header-title mb-0">تفاصيل العقد</h2>
            <span class="badge bg-primary fs-6">@Model.ContractNo</span>
        </div>
        <p class="text-muted mb-0">
            مشروع: <strong>@(Model.Projects?.ProjectNo ?? "-")</strong>
            <span class="mx-2">•</span>
            عميل: <strong>@(Model.Projects?.Customer?.Name ?? "-")</strong>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-bold d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-pen"></i><span>تعديل</span>
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-arrow-right"></i><span>رجوع</span>
        </a>
    </div>
</div>

<!-- Status Badge -->
<div class="mb-4">
    @switch (Model.Status)
    {
        case "Draft":
            <span class="badge bg-secondary fs-6 px-4 py-2 rounded-pill">مسودة</span>
            break;
        case "Active":
            <span class="badge bg-success fs-6 px-4 py-2 rounded-pill">
                <i class="fa-solid fa-circle-check me-2"></i>ساري
            </span>
            break;
        case "Completed":
            <span class="badge bg-primary fs-6 px-4 py-2 rounded-pill">مكتمل</span>
            break;
        case "Cancelled":
            <span class="badge bg-danger fs-6 px-4 py-2 rounded-pill">ملغى</span>
            break;
        default:
            <span class="badge bg-light text-dark border fs-6 px-4 py-2 rounded-pill">@Model.Status</span>
            break;
    }
</div>

<div class="row g-4">
    <!-- Financial Overview -->
    <div class="col-12 col-lg-5">
        <div class="custom-card h-100 p-4">
            <h5 class="fw-bold text-primary mb-4 border-bottom pb-2">
                <i class="fa-solid fa-money-bill-wave me-2"></i> الموقف المالي
            </h5>
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <span class="text-muted">قيمة العقد الإجمالية</span>
                <strong class="text-dark fs-5">@Model.TotalAmount.ToString("N2") د.ل</strong>
            </div>
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <span class="text-muted">المبلغ المسدد</span>
                <strong class="text-success fs-5">@Model.PaidAmount.ToString("N2") د.ل</strong>
            </div>
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <span class="text-muted">المبلغ المتبقي</span>
                <strong class="@(Model.RemainingAmount > 0 ? "text-danger" : "text-success") fs-5">
                    @Model.RemainingAmount.ToString("N2") د.ل
                </strong>
            </div>
            <!-- Progress Bar -->
            <div class="mt-4">
                <div class="d-flex justify-content-between mb-1">
                    <small class="text-muted fw-bold">نسبة التحصيل</small>
                    <small class="fw-bold text-@(paidPct >= 100 ? "success" : paidPct >= 50 ? "warning" : "danger")">@paidPct%</small>
                </div>
                <div class="progress" style="height:12px; border-radius:8px;">
                    <div class="progress-bar bg-@(paidPct >= 100 ? "success" : paidPct >= 50 ? "warning" : "danger")"
                         role="progressbar" style="width:@paidPct%"></div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ContractFilePath))
            {
                <div class="mt-4 pt-3 border-top">
                    <a href="@Model.ContractFilePath" target="_blank" class="btn btn-outline-primary w-100">
                        <i class="fa-solid fa-file-pdf me-2"></i> عرض ملف العقد
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Contract & Project Info -->
    <div class="col-12 col-lg-7">
        <div class="custom-card h-100 p-4">
            <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                <i class="fa-solid fa-diagram-project me-2"></i> بيانات المشروع والعقد
            </h5>
            <div class="row g-3">
                <div class="col-6">
                    <span class="text-muted d-block small">رقم المشروع</span>
                    <strong>
                        <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId"
                           class="text-primary text-decoration-none">@(Model.Projects?.ProjectNo ?? "-")</a>
                    </strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small">اسم المشروع</span>
                    <strong>@(Model.Projects?.ProjectName ?? "-")</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small">العميل</span>
                    <strong><i class="fa-solid fa-user me-1 text-secondary"></i>@(Model.Projects?.Customer?.Name ?? "-")</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small">هاتف العميل</span>
                    <strong>@(Model.Projects?.Customer?.Phone ?? "-")</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small">تاريخ بداية العقد</span>
                    <strong>@(Model.StartDate?.ToString("yyyy/MM/dd") ?? "-")</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small">تاريخ الانتهاء المتوقع</span>
                    <strong>@(Model.ExpectedEndDate?.ToString("yyyy/MM/dd") ?? "-")</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small">تاريخ إنشاء العقد</span>
                    <strong>@Model.Created.ToLocalTime().ToString("yyyy/MM/dd")</strong>
                </div>
                @if (Model.Modified.HasValue)
                {
                    <div class="col-6">
                        <span class="text-muted d-block small">آخر تعديل</span>
                        <strong>@Model.Modified.Value.ToLocalTime().ToString("yyyy/MM/dd")</strong>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="mt-3 pt-3 border-top">
                    <span class="text-muted d-block small fw-bold mb-1">ملاحظات وبنود العقد</span>
                    <p class="mb-0 text-dark bg-light p-3 rounded" style="white-space:pre-wrap;">@Model.Notes</p>
                </div>
            }
        </div>
    </div>

    <!-- Payments Table -->
    @if (Model.CustomerPayments != null && Model.CustomerPayments.Any())
    {
        <div class="col-12">
            <div class="custom-card p-0">
                <div class="card-header-custom">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-receipt text-secondary me-2"></i> دفعات هذا العقد
                    </h5>
                    <span class="badge bg-light text-dark border">@Model.CustomerPayments.Count دفعة</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted" style="font-size:0.85rem;">
                            <tr>
                                <th class="ps-4">رقم الإيصال</th>
                                <th>المبلغ</th>
                                <th>طريقة الدفع</th>
                                <th>ملاحظات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.CustomerPayments)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@payment.ReceiptNo</td>
                                    <td class="text-success fw-bold">@payment.Amount.ToString("N2") د.ل</td>
                                    <td><span class="badge bg-light text-dark border">@payment.Payment</span></td>
                                    <td class="text-muted">@(payment.Notes ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
