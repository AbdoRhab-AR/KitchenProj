@model List<KitchenProject.Controllers.AccountingController.TrialRow>
@{
    ViewData["Title"] = "ميزان المراجعة";
    Layout = "_DashboardLayout";
    DateTime? from = ViewBag.From;
    DateTime? to = ViewBag.To;
    // الرصيد الموجب = مدين، السالب = دائن
    decimal D(decimal v) => v > 0 ? v : 0;
    decimal C(decimal v) => v < 0 ? -v : 0;
    var totalDebit = Model.Sum(r => r.Debit);
    var totalCredit = Model.Sum(r => r.Credit);
    var closingDebit = Model.Sum(r => D(r.Closing));
    var closingCredit = Model.Sum(r => C(r.Closing));
    var openingDebit = Model.Sum(r => D(r.Opening));
    var openingCredit = Model.Sum(r => C(r.Opening));
    var balanced = totalDebit == totalCredit && closingDebit == closingCredit;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="page-header-title mb-1"><i class="fa-solid fa-scale-balanced text-primary me-2"></i> ميزان المراجعة</h2>
        <p class="text-muted mb-0">أرصدة أول الفترة وحركتها وأرصدة آخرها لكل حساب نهائي</p>
    </div>
    <a asp-action="TrialBalancePrint" asp-route-from="@from?.ToString("yyyy-MM-dd")" asp-route-to="@to?.ToString("yyyy-MM-dd")" target="_blank" class="btn btn-light border"><i class="fa-solid fa-print me-1"></i> طباعة (A4)</a>
</div>

<div class="custom-card mb-4 p-3">
    <form method="get" asp-action="TrialBalance" class="row g-3 align-items-end">
        <div class="col-6 col-md-3">
            <label class="form-label small fw-bold text-muted">من</label>
            <input type="date" name="from" value="@from?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small fw-bold text-muted">إلى</label>
            <input type="date" name="to" value="@to?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary fw-bold rounded-3"><i class="fa-solid fa-search me-1"></i> عرض</button>
            <a asp-action="TrialBalance" class="btn btn-light border text-muted"><i class="fa-solid fa-xmark"></i></a>
        </div>
    </form>
</div>

<div class="custom-card">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">الميزان</h5>
        @if (balanced)
        {
            <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-circle-check me-1"></i>متزن</span>
        }
        else
        {
            <span class="badge bg-danger-subtle text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i>غير متزن</span>
        }
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted" style="font-size:0.85rem;">
                <tr>
                    <th class="ps-4" rowspan="2">رقم</th>
                    <th rowspan="2">الحساب</th>
                    <th colspan="2" class="text-center border-start">رصيد أول الفترة</th>
                    <th colspan="2" class="text-center border-start">حركة الفترة</th>
                    <th colspan="2" class="text-center border-start">رصيد آخر الفترة</th>
                </tr>
                <tr>
                    <th class="border-start">مدين</th><th>دائن</th>
                    <th class="border-start">مدين</th><th>دائن</th>
                    <th class="border-start">مدين</th><th>دائن</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="ps-4 font-monospace">@r.Account.Code</td>
                        <td><a asp-action="Ledger" asp-route-accountId="@r.Account.Id" asp-route-from="@from?.ToString("yyyy-MM-dd")" asp-route-to="@to?.ToString("yyyy-MM-dd")">@r.Account.Name</a></td>
                        <td class="border-start">@(D(r.Opening) == 0 ? "-" : D(r.Opening).ToString("N2"))</td>
                        <td>@(C(r.Opening) == 0 ? "-" : C(r.Opening).ToString("N2"))</td>
                        <td class="border-start">@(r.Debit == 0 ? "-" : r.Debit.ToString("N2"))</td>
                        <td>@(r.Credit == 0 ? "-" : r.Credit.ToString("N2"))</td>
                        <td class="border-start fw-bold">@(D(r.Closing) == 0 ? "-" : D(r.Closing).ToString("N2"))</td>
                        <td class="fw-bold">@(C(r.Closing) == 0 ? "-" : C(r.Closing).ToString("N2"))</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center py-5 text-muted">لا توجد حركة في هذه الفترة</td></tr>
                }
            </tbody>
            <tfoot class="bg-light fw-bold">
                <tr>
                    <td colspan="2" class="ps-4">الإجمالي</td>
                    <td class="border-start">@openingDebit.ToString("N2")</td>
                    <td>@openingCredit.ToString("N2")</td>
                    <td class="border-start">@totalDebit.ToString("N2")</td>
                    <td>@totalCredit.ToString("N2")</td>
                    <td class="border-start">@closingDebit.ToString("N2")</td>
                    <td>@closingCredit.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
