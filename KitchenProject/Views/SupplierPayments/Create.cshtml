@model KitchenProject.Models.Entities.SupplierPayment
@{
    ViewData["Title"] = "إيصال صرف لمورد";
    Layout = "_DashboardLayout";
    var purchases = (List<PurchaseOption>)ViewBag.Purchases;
    var supplierDues = ViewBag.SupplierDues as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    decimal? suggested = ViewBag.SuggestedAmount;
    var amountValue = Model.Amount > 0 ? Model.Amount : suggested ?? 0;
    string? returnTo = ViewBag.ReturnTo;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">صرف للموردين</a></li>
                <li class="breadcrumb-item active" aria-current="page">إيصال صرف جديد</li>
            </ol>
        </nav>
        <h2 class="page-header-title mb-0">
            <i class="fa-solid fa-money-bill-transfer text-danger me-2"></i> صرف دفعة لمورد
        </h2>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3"><i class="fa-solid fa-arrow-right me-1"></i> العودة للقائمة</a>
    </div>
</div>

<div class="custom-card p-4 p-md-5" style="max-width:900px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnTo" value="@returnTo" />
        <div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

        <div class="row g-4">
            <div class="col-12 col-md-4">
                <label asp-for="ReceiptNo" class="form-label fw-bold">رقم الإيصال</label>
                <input asp-for="ReceiptNo" class="form-control bg-light fw-bold text-primary" readonly />
            </div>
            <div class="col-12 col-md-8">
                <label asp-for="SupplierId" class="form-label fw-bold">المورد <span class="text-danger">*</span></label>
                <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select" id="supplierId">
                    <option value="">-- اختر المورد --</option>
                </select>
                <small class="text-muted d-block mt-1" id="supplierDueHint"></small>
            </div>
            <div class="col-12 col-md-8">
                <label asp-for="PurchaseId" class="form-label fw-bold">فاتورة الشراء (اختياري)</label>
                <select asp-for="PurchaseId" class="form-select" id="purchaseId">
                    <option value="">-- صرف مباشر للمورد (بدون ربط بفاتورة محددة) --</option>
                    @foreach (var p in purchases)
                    {
                        <option value="@p.Id" data-supplier="@p.SupplierId" data-remaining="@p.Remaining.ToString("0.##", inv)" selected="@(p.Id == Model.PurchaseId)">
                            @p.PurchaseNo @(!string.IsNullOrEmpty(p.InvoiceNo) ? $"(فاتورة {p.InvoiceNo})" : "") — الإجمالي @p.Total.ToString("N2") / المتبقي @p.Remaining.ToString("N2")
                        </option>
                    }
                </select>
                <span asp-validation-for="PurchaseId" class="text-danger small"></span>
                <small class="text-muted d-block mt-1" id="remainingHint"></small>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="PaymentDate" class="form-label fw-bold">التاريخ</label>
                <input asp-for="PaymentDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="Amount" class="form-label fw-bold">المبلغ (د.ل) <span class="text-danger">*</span></label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" value="@amountValue.ToString("0.##", inv)" class="form-control fw-bold fs-5" id="amount" />
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="PaymentMethod" class="form-label fw-bold">طريقة الدفع</label>
                <select asp-for="PaymentMethod" asp-items="ViewBag.MethodList" class="form-select" id="paymentMethod"></select>
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="CashAccountId" class="form-label fw-bold">حساب الخزنة / البنك</label>
                <select asp-for="CashAccountId" asp-items="ViewBag.CashAccounts" class="form-select">
                    <option value="">-- افتراضي حسب طريقة الدفع --</option>
                </select>
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="ReferenceNo" class="form-label fw-bold">رقم الصك / الحوالة</label>
                <input asp-for="ReferenceNo" class="form-control" />
            </div>
            <div class="col-6 col-md-4 cheque-fields" style="display:none;">
                <label asp-for="ChequeStatus" class="form-label fw-bold">حالة الصك</label>
                <select asp-for="ChequeStatus" asp-items="ViewBag.ChequeStatuses" class="form-select"></select>
            </div>
            <div class="col-6 col-md-4 cheque-fields" style="display:none;">
                <label asp-for="ChequeDueDate" class="form-label fw-bold">تاريخ استحقاق الصك</label>
                <input asp-for="ChequeDueDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label fw-bold">البيان</label>
                <input asp-for="Notes" class="form-control" placeholder="مثال: دفعة على الحساب / سداد فاتورة خامات..." />
            </div>
        </div>

        <hr class="my-4 text-muted opacity-25">
        <div class="d-flex align-items-center justify-content-end gap-3">
            <a asp-action="Index" class="btn btn-light border fw-bold px-4 rounded-3">إلغاء</a>
            <button type="submit" class="btn btn-primary-custom px-5 py-2 fw-bold">
                <i class="fa-solid fa-floppy-disk me-1"></i> حفظ إيصال الصرف
            </button>
        </div>
    </form>
</div>

<script>
    (function () {
        const dues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(supplierDues));
        const supplier = document.getElementById('supplierId');
        const purchase = document.getElementById('purchaseId');
        const hint = document.getElementById('remainingHint');
        const dueHint = document.getElementById('supplierDueHint');
        const amount = document.getElementById('amount');

        // يعرض فقط فواتير الشراء الخاصة بالمورد المختار
        function filterPurchases() {
            let visible = [];
            purchase.querySelectorAll('option[data-supplier]').forEach(o => {
                const show = o.dataset.supplier === supplier.value;
                o.hidden = !show;
                if (show) visible.push(o);
                if (!show && o.selected) purchase.value = '';
            });
            if (!purchase.value && visible.length === 1) purchase.value = visible[0].value;

            const sid = supplier.value;
            if (sid && dues[sid] !== undefined) {
                const due = parseFloat(dues[sid]);
                dueHint.textContent = `إجمالي المستحق للمورد حالياً: ${due.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            } else {
                dueHint.textContent = '';
            }
            showHint();
        }

        function showHint() {
            const opt = purchase.selectedOptions[0];
            if (opt && opt.dataset.remaining) {
                const remaining = parseFloat(opt.dataset.remaining);
                hint.textContent = `المتبقي على الفاتورة: ${remaining.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
                amount.max = remaining;
            } else {
                hint.textContent = 'صرف مباشر للمورد دون تحديد فاتورة.';
                amount.removeAttribute('max');
            }
        }

        supplier.addEventListener('change', filterPurchases);
        purchase.addEventListener('change', () => {
            showHint();
            const opt = purchase.selectedOptions[0];
            if (opt?.dataset.remaining && !(parseFloat(amount.value) > 0)) amount.value = opt.dataset.remaining;
        });
        filterPurchases();

        const pm = document.getElementById('paymentMethod');
        function toggleCheque() {
            const isChek = pm.value === '@((int)PaymentMethod.Chek)';
            document.querySelectorAll('.cheque-fields').forEach(el => el.style.display = isChek ? '' : 'none');
        }
        pm.addEventListener('change', toggleCheque);
        toggleCheque();
    })();
</script>
